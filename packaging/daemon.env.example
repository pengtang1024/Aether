# Aether daemon update configuration.
#
# The packaged systemd unit reads this file from
#   ~/.config/aether/daemon.env
# Copy it there and uncomment what you want:
#
#   mkdir -p ~/.config/aether
#   cp /usr/share/doc/aether/daemon.env.example ~/.config/aether/daemon.env
#   systemctl --user restart aether-daemon
#
# Auto-updates are on by default: the daemon carries the release manifest URL
# and the official public key, so this file is only needed to override them.
# Setting either variable to an empty value turns update checks off.

# Signed update manifest (see docs/UPDATE.md). Default is the line below.
# AETHER_UPDATE_URL=https://github.com/pengtang1024/Aether/releases/latest/download/update.json
# AETHER_UPDATE_URL=            # empty disables update checks

# Ed25519 public key that signs update.json. This is the official Aether
# release key; anyone redistributing their own builds must replace it.
# AETHER_UPDATE_PUBKEY=gmTgGxsoxi9dyYiWQ+mlqeqx4gDNnMwQ+P0jwNbsa+w=

# AppImage self-replacement target (only needed if you run the AppImage):
# AETHER_UPDATE_APPIMAGE=/home/you/Applications/Aether.AppImage

# Queue and network tuning (defaults shown):
# AETHER_MAX_CONCURRENT=3
# AETHER_RETRY_MAX=5
# AETHER_RETRY_BASE_SECS=30
# AETHER_MAX_SPEED_BPS=0          # 0/unset = unlimited
# AETHER_PROXY=system             # system | none | http://user:pass@host:port
# AETHER_PAC_URL=http://wpad.example/wpad.dat
