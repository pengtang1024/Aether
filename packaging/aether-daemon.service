[Unit]
Description=Aether download daemon
Documentation=https://github.com/pengtang1024/Aether
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/aether/daemon.env
ExecStart=/usr/bin/aether-daemon --download-dir %h/Downloads
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
