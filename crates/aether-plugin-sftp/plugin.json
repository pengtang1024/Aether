{
  "id": "sftp",
  "name": "SFTP Downloader",
  "version": "0.1.0",
  "api": 2,
  "min_host": "0.2.0",
  "protocols": ["sftp"],
  "capabilities": ["network", "filesystem:task"],
  "executable": {
    "linux-x86_64": "bin/aether-plugin-sftp-linux-x86_64",
    "linux-aarch64": "bin/aether-plugin-sftp-linux-aarch64",
    "windows-x86_64": "bin/aether-plugin-sftp-windows-x86_64.exe",
    "windows-arm64": "bin/aether-plugin-sftp-windows-arm64.exe",
    "macos-universal": "bin/aether-plugin-sftp-macos-universal"
  },
  "settings_schema": {
    "sections": [
      {
        "title": "SFTP",
        "fields": [
          { "key": "sftp_key", "type": "string" },
          { "key": "sftp_passphrase", "type": "secret" },
          { "key": "sftp_agent", "type": "bool", "default": true }
        ]
      }
    ]
  },
  "detail_schema": { "sections": [{ "type": "metrics", "items": ["size"] }] }
}
