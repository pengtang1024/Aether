{
  "id": "webdav",
  "name": "WebDAV Downloader",
  "version": "0.1.0",
  "api": 2,
  "min_host": "0.2.0",
  "protocols": ["webdav"],
  "capabilities": ["network", "filesystem:task"],
  "executable": {
    "linux-x86_64": "bin/aether-plugin-webdav-linux-x86_64",
    "linux-aarch64": "bin/aether-plugin-webdav-linux-aarch64",
    "windows-x86_64": "bin/aether-plugin-webdav-windows-x86_64.exe",
    "windows-arm64": "bin/aether-plugin-webdav-windows-arm64.exe",
    "macos-universal": "bin/aether-plugin-webdav-macos-universal"
  },
  "settings_schema": { "sections": [] },
  "detail_schema": { "sections": [{ "type": "metrics", "items": ["speed", "size"] }] }
}
