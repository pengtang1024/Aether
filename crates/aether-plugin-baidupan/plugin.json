{
  "id": "baidupan",
  "name": "Baidu Netdisk (Official API)",
  "version": "0.1.0",
  "api": 2,
  "min_host": "0.2.0",
  "protocols": ["baidupan"],
  "capabilities": ["network", "filesystem:task"],
  "executable": {
    "linux-x86_64": "bin/aether-plugin-baidupan-linux-x86_64",
    "linux-aarch64": "bin/aether-plugin-baidupan-linux-aarch64",
    "windows-x86_64": "bin/aether-plugin-baidupan-windows-x86_64.exe",
    "windows-arm64": "bin/aether-plugin-baidupan-windows-arm64.exe",
    "macos-universal": "bin/aether-plugin-baidupan-macos-universal"
  },
  "settings_schema": {
    "sections": [{ "title": "Baidu", "fields": [{"key": "access_token", "type": "secret"}] }]
  },
  "detail_schema": { "sections": [{ "type": "metrics", "items": ["speed", "size"] }] }
}
