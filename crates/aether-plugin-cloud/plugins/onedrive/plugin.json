{
  "id": "onedrive",
  "name": "OneDrive Shared Links",
  "version": "0.1.0",
  "api": 1,
  "min_host": "0.2.0",
  "protocols": ["onedrive"],
  "capabilities": ["network", "filesystem:task"],
  "executable": {
    "linux-x86_64": "bin/aether-plugin-onedrive-linux-x86_64",
    "linux-aarch64": "bin/aether-plugin-onedrive-linux-aarch64",
    "windows-x86_64": "bin/aether-plugin-onedrive-windows-x86_64.exe",
    "windows-arm64": "bin/aether-plugin-onedrive-windows-arm64.exe",
    "macos-universal": "bin/aether-plugin-onedrive-macos-universal"
  },
  "settings_schema": { "sections": [] },
  "detail_schema": { "sections": [{ "type": "metrics", "items": ["speed", "size"] }] }
}
