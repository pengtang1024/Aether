{
  "id": "ftp",
  "name": "FTP Downloader",
  "version": "0.1.0",
  "api": 1,
  "min_host": "0.2.0",
  "protocols": ["ftp", "ftps"],
  "capabilities": ["network", "filesystem:task"],
  "executable": {
    "linux-x86_64": "bin/aether-plugin-ftp-linux-x86_64",
    "linux-aarch64": "bin/aether-plugin-ftp-linux-aarch64",
    "windows-x86_64": "bin/aether-plugin-ftp-windows-x86_64.exe",
    "windows-arm64": "bin/aether-plugin-ftp-windows-arm64.exe",
    "macos-universal": "bin/aether-plugin-ftp-macos-universal"
  },
  "settings_schema": {
    "sections": [
      {
        "title": "FTP",
        "fields": [
          { "key": "username", "type": "string", "default": "anonymous" },
          { "key": "password", "type": "secret" }
        ]
      }
    ]
  },
  "detail_schema": {
    "sections": [
      { "type": "metrics", "items": ["speed", "size"] },
      { "type": "logs", "max_lines": 200 }
    ]
  }
}
