// Aether is a dark-first application: the Material palette is pinned to the
// dark color scheme. (The upstream widget reads this from the platform via
// `SlintInternal`, which is only available to compiler-internal files.)

export global ColorSchemeSelector  {
    in property <ColorScheme> color-scheme: ColorScheme.dark;
}
