// Aether — Material 3 design tokens.
//
// This is the upstream Slint Material widget palette re-tinted for the Aether
// brand. The structure (property names, tone relationships, light/dark switch)
// is unchanged so every upstream Material widget keeps working, only the brand
// primary is swapped: #6750A4 (M3 baseline primary) drives the accent roles in
// both color schemes.
//
// Dark scheme is the product default; the light scheme is kept so the palette
// stays a complete, spec-shaped M3 system.

import { ColorSchemeSelector } from "color-scheme.slint";
import { Aether } from "../theme.slint";

struct TextStyle { font-size: relative-font-size, font-weight: int}

export global MaterialFontSettings {
    out property <TextStyle> label-large: { font-size: 13pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> label-medium: { font-size: 12pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> body-large: { font-size: 13pt * 1rem / 14pt, font-weight: FontWeight.normal };
    out property <TextStyle> body-small: { font-size: 12pt * 1rem / 14pt, font-weight: FontWeight.normal };
    out property <TextStyle> title-small: { font-size: 13pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> title-medium: { font-size: 16pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> title-large: { font-size: 22pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> headline-small: { font-size: 24pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> headline-large: { font-size: 32pt * 1rem / 14pt, font-weight: FontWeight.medium };
    out property <TextStyle> display-small: { font-size: 36pt * 1rem / 14pt, font-weight: FontWeight.medium };
}

export global Elevation {
    out property <length> level0: 0px;
    out property <length> level1: 1px;
    out property <length> level2: 2px;
    out property <length> level3: 4px;
}

export global MaterialPalette {
    in-out property <ColorScheme> color-scheme: ColorSchemeSelector.color-scheme;
    property <bool> dark-color-scheme: color-scheme != ColorScheme.light;

    // ---- Brand seed ------------------------------------------------------
    // Aether's brand primary. Every accent role below is derived from it.
    out property <brush> brand-primary: #6750A4;
    out property <brush> brand-on-primary: #FFFFFF;

    // ---- Core M3 roles ---------------------------------------------------
    out property <brush> background: !dark-color-scheme ? #F8F3F9 : #141119;
    out property <brush> foreground: !dark-color-scheme ? #1C1B1F : #EDE7F0;
    out property <brush> alternate-background: !dark-color-scheme ? #FFFBFE : #17131E;
    out property <brush> alternate-foreground: !dark-color-scheme ? #1C1B1F : #EDE7F0;
    out property <brush> control-background: !dark-color-scheme ? #E8DEF8 : #322A3D;
    out property <brush> control-foreground: !dark-color-scheme ? #1E192B : #EDE7F0;
    out property <brush> accent-background: !dark-color-scheme ? brand-primary : brand-primary;
    out property <brush> accent-foreground: brand-on-primary;
    out property <brush> selection-background: accent-background.with-alpha(0.3);
    out property <brush> selection-foreground: !dark-color-scheme ? #1C1B1F : #EDE7F0;
    out property <brush> border: !dark-color-scheme ? #79747E : #8C8496;

    // ---- Additional palette ---------------------------------------------
    out property <brush> control-background-variant: !dark-color-scheme ? #E7E0EC.darker(0.2) : #3A3345;
    out property <brush> control-foreground-variant: !dark-color-scheme ? #49454E : #CBC2D6;
    out property <brush> control-background-tint: accent-background;
    out property <brush> accent-container: !dark-color-scheme ? #4F378B : #4B3585;
    out property <brush> accent-ripple: brand-primary;
    out property <brush> shadow: #000000.with-alpha(0.3);
    out property <brush> border-variant: !dark-color-scheme ? #C4C7C5 : #443C4F;
    out property <brush> foreground-alt: !dark-color-scheme ? #1C1B1F : #EDE7F0;
    out property <brush> secondary-ripple: !dark-color-scheme ? #fffc : #000000;
    out property <brush> surface-container: !dark-color-scheme ? #F3EDF7 : #211C29;
    out property <brush> surface-container-high: !dark-color-scheme ? #ECE6F0 : #2A2433;
    out property <brush> surface-container-highest: !dark-color-scheme ? #E6E0E9 : #352E40;
    out property <brush> tertiary-container: !dark-color-scheme ? #FFD8E4 : #10342E;
    out property <brush> on-tertiary-container: !dark-color-scheme ? #31111D : #C8F8EC;

    // ---- State roles -----------------------------------------------------
    out property <brush> state-default: dark-color-scheme ? #EDE7F0 : #1D1B20;
    out property <brush> state-secondary: accent-background;
    out property <brush> state-tertiary: dark-color-scheme ? #381E72 : #FFFFFF;

    // ---- Semantic status roles (Aether) ----------------------------------
    out property <brush> status-success: !dark-color-scheme ? #2E7D32 : #7FE3B5;
    out property <brush> status-success-container: !dark-color-scheme ? #C8E6C9 : #11352B;
    out property <brush> status-warning: !dark-color-scheme ? #9A6700 : #F3C77E;
    out property <brush> status-warning-container: !dark-color-scheme ? #FFECB3 : #3A2C14;
    out property <brush> status-error: !dark-color-scheme ? #B3261E : #FFB4AB;
    out property <brush> status-error-container: !dark-color-scheme ? #F9DEDC : #4B1714;
    out property <brush> status-info: !dark-color-scheme ? #00639B : #8ED3F2;
    out property <brush> status-info-container: !dark-color-scheme ? #CDE7F7 : #12313E;
}

export global Icons {
    out property <image> arrow-downward: @image-url("_arrow-downward.svg");
    out property <image> arrow-drop-down: @image-url("_arrow-drop-down.svg");
    out property <image> arrow-drop-up: @image-url("_arrow-drop-up.svg");
    out property <image> arrow-upward: @image-url("_arrow-upward.svg");
    out property <image> check-mark: @image-url("_check-mark.svg");
    out property <image> expand-more: @image-url("_expand-more.svg");
    out property <image> keyboard: @image-url("_keyboard.svg");
    out property <image> clock: @image-url("_clock.svg");
    out property <image> arrow-back: @image-url("_arrow_back.svg");
    out property <image> arrow-forward: @image-url("_arrow_forward.svg");
    out property <image> edit: @image-url("_edit.svg");
    out property <image> calendar: @image-url("_calendar.svg");
}

export global MaterialSizeSettings {
    out property <length> item-height: Aether.control-md;
}
