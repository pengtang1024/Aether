// Settings search state shared by the page and its cards.
//
// The card ids and keywords live in Rust (`src/settings_search.rs`): that is
// where the query is matched, because Slint strings have no substring test.
// Rust returns the matching ids joined as "|id|id|" and the page flips
// `active` on; a card then answers "do I match?" with a replace-all probe.
//
// Cards with `filterable: false` (the About hero) hide while a filter runs.

export struct SettingsHit {
    tab: int,
    id: string,
    // Titles are split around the matched term so the page can highlight it
    // (Slint text has no inline styles).
    title-before: string,
    title-hit: string,
    title-after: string,
    subtitle-before: string,
    subtitle-hit: string,
    subtitle-after: string,
    // "Network · 2" on the first result of a section, empty afterwards.
    heading: string,
}

export global SettingsFilter {
    in-out property <bool> active: false;
    // "|id|id|"; empty means no card matches.
    in-out property <string> hits: "";
    // "|id|id|" rows inside the matching cards.
    in-out property <string> row-hits: "";
    // Result rows for the search view, filled by Rust.
    in-out property <[SettingsHit]> results: [];

    public pure function shows(id: string) -> bool {
        return !root.active
            || id == ""
            || root.hits.replace-all("|" + id + "|", "") != root.hits;
    }

    public pure function shows-row(id: string) -> bool {
        return !root.active
            || id == ""
            || root.row-hits.replace-all("|" + id + "|", "") != root.row-hits;
    }
}
