// Aether — application shell.
//
// Fixed navigation rail on the left, main content on the right, an ambient
// "ether" background behind everything.

import { Button, StateLayer } from "std-widgets.slint";
import { Aether } from "theme.slint";
import { AetherIcons } from "icons.slint";
import { TaskRow, TaskDetail, PeerRow, LogRow } from "model.slint";
import { FlowBackground, NavRailItem, SearchField, FilterChip } from "widgets.slint";
import { DownloadsPage } from "pages/downloads.slint";
import { SettingsPage } from "pages/settings.slint";
import { NewDownloadDialog } from "pages/new-download.slint";
import { TaskDrawer } from "pages/task-drawer.slint";

export component AppWindow inherits Window {
    // ---- data ------------------------------------------------------------
    in property <[TaskRow]> tasks: [];
    in property <[PeerRow]> peers: [];
    in property <[LogRow]> logs: [];
    in property <[float]> chunks: [];
    in property <TaskDetail> detail: {
        name: "",
        subtitle: "",
        kind: "",
        kind-tone: 0,
        status: 0,
        status-text: "",
        progress: 0,
        progress-text: "",
        speed: "",
        eta: "",
        size: "",
        path: "",
        note: "",
        source: "",
        line-path: "",
        area-path: "",
        peak: "0 B/s",
        sample: 0,
        chunks-text: "",
    };

    // ---- state -----------------------------------------------------------
    in-out property <int> page: 0;              // 0 = downloads, 1 = settings
    in-out property <int> active-filter: 0;     // 0 = all, 1 = active, …
    in-out property <string> search-text: "";
    in-out property <bool> dialog-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> flow-enabled: true;
    in-out property <float> drift: 0;
    in-out property <string> page-title: "下载任务";
    in-out property <string> page-subtitle: "";
    in-out property <bool> toast-open: false;
    in-out property <string> toast-text: "";

    // ---- aggregate stats -------------------------------------------------
    in-out property <string> stat-total: "0";
    in-out property <string> stat-active: "0";
    in-out property <string> stat-done: "0";
    in-out property <string> total-speed: "0 B/s";

    // ---- signals ---------------------------------------------------------
    callback task-action(int, int);
    callback open-detail(int);
    callback drawer-dismissed();
    callback filter-changed(int, string);
    callback new-download(string, string, int, float, string);
    callback settings-changed(string, string);
    callback reset-filters();

    width: 1440px;
    height: 900px;
    background: Aether.surface;
    title: "Aether — 下载管理器";

    // ======================================================================
    // Background
    // ======================================================================
    FlowBackground {
        enabled: root.flow-enabled;
        drift: root.drift;
    }

    // ======================================================================
    // Shell
    // ======================================================================
    HorizontalLayout {
        spacing: 0;

        // ---------------------------------------------------------
        // Navigation rail
        // ---------------------------------------------------------
        Rectangle {
            width: 100px;
            background: Aether.surface-dim;

            Rectangle {
                x: parent.width - self.width;
                width: 1px;
                height: 100%;
                background: Aether.outline-faint;
            }

            VerticalLayout {
                padding: 14px;
                spacing: 6px;

                // brand mark
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: Aether.radius-md;
                    background: Aether.primary;

                    Image {
                        source: AetherIcons.download;
                        width: 22px;
                        height: 22px;
                        colorize: Aether.on-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle {
                    height: 10px;
                    background: transparent;
                }

                NavRailItem {
                    icon-source: AetherIcons.list;
                    label: "全部";
                    active: root.page == 0 && root.active-filter == 0;
                    clicked => { root.active-filter = 0; root.page = 0; root.filter-changed(0, root.search-text); }
                }

                NavRailItem {
                    icon-source: AetherIcons.download;
                    label: "传输中";
                    active: root.page == 0 && root.active-filter == 1;
                    clicked => { root.active-filter = 1; root.page = 0; root.filter-changed(1, root.search-text); }
                }

                NavRailItem {
                    icon-source: AetherIcons.seed;
                    label: "种子";
                    active: root.page == 0 && root.active-filter == 5;
                    clicked => { root.active-filter = 5; root.page = 0; root.filter-changed(5, root.search-text); }
                }

                NavRailItem {
                    icon-source: AetherIcons.check;
                    label: "已完成";
                    active: root.page == 0 && root.active-filter == 2;
                    clicked => { root.active-filter = 2; root.page = 0; root.filter-changed(2, root.search-text); }
                }

                // spacer pushes the settings entry to the bottom
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                NavRailItem {
                    icon-source: AetherIcons.tune;
                    label: "设置";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
            }
        }

        // ---------------------------------------------------------
        // Main content
        // ---------------------------------------------------------
        VerticalLayout {
            spacing: 0;

            // ---- top app bar -------------------------------------
            Rectangle {
                height: 76px;
                background: Aether.surface;

                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 18px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        cross-axis-self-alignment: center;

                        Text {
                            text: root.page == 1 ? "设置" : root.page-title;
                            color: Aether.on-surface;
                            font-size: Aether.text-headline;
                            font-weight: Aether.weight-medium;
                        }

                        Text {
                            text: root.page == 1 ? "Aether 的偏好与网络参数" : root.page-subtitle;
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-caption;
                        }
                    }

                    SearchField {
                        width: 320px;
                        cross-axis-self-alignment: center;
                        visible: root.page == 0;
                        text <=> root.search-text;
                        placeholder: "搜索任务名称或地址";
                        edited(t) => { root.filter-changed(root.active-filter, t); }
                    }

                    Button {
                        text: "新建下载";
                        icon: AetherIcons.add;
                        icon-size: 18px;
                        colorize-icon: true;
                        primary: true;
                        min-width: 132px;
                        cross-axis-self-alignment: center;
                        visible: root.page == 0;
                        clicked => { root.dialog-open = true; }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 1px;
                    background: Aether.outline-faint;
                }
            }

            // ---- filter bar --------------------------------------
            Rectangle {
                height: root.page == 0 ? 58px : 0px;
                visible: root.page == 0;
                background: Aether.surface;

                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 8px;

                    FilterChip {
                        text: "全部";
                        selected: root.active-filter == 0;
                        cross-axis-self-alignment: center;
                        clicked => { root.active-filter = 0; root.filter-changed(0, root.search-text); }
                    }
                    FilterChip {
                        text: "下载中";
                        selected: root.active-filter == 1;
                        cross-axis-self-alignment: center;
                        clicked => { root.active-filter = 1; root.filter-changed(1, root.search-text); }
                    }
                    FilterChip {
                        text: "已完成";
                        selected: root.active-filter == 2;
                        cross-axis-self-alignment: center;
                        clicked => { root.active-filter = 2; root.filter-changed(2, root.search-text); }
                    }
                    FilterChip {
                        text: "已暂停";
                        selected: root.active-filter == 3;
                        cross-axis-self-alignment: center;
                        clicked => { root.active-filter = 3; root.filter-changed(3, root.search-text); }
                    }
                    FilterChip {
                        text: "失败";
                        selected: root.active-filter == 4;
                        cross-axis-self-alignment: center;
                        clicked => { root.active-filter = 4; root.filter-changed(4, root.search-text); }
                    }
                    FilterChip {
                        text: "种子";
                        selected: root.active-filter == 5;
                        cross-axis-self-alignment: center;
                        clicked => { root.active-filter = 5; root.filter-changed(5, root.search-text); }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    // aggregate stats
                    HorizontalLayout {
                        spacing: 20px;
                        cross-axis-self-alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Aether.primary;
                            cross-axis-self-alignment: center;
                        }
                        Text {
                            text: "进行中 " + root.stat-active;
                            color: Aether.on-surface-variant;
                            font-size: Aether.text-caption;
                            cross-axis-self-alignment: center;
                        }
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Aether.success;
                            cross-axis-self-alignment: center;
                        }
                        Text {
                            text: "已完成 " + root.stat-done;
                            color: Aether.on-surface-variant;
                            font-size: Aether.text-caption;
                            cross-axis-self-alignment: center;
                        }
                        Text {
                            text: "总速度 " + root.total-speed;
                            color: Aether.on-surface-variant;
                            font-size: Aether.text-caption;
                            font-weight: Aether.weight-medium;
                            cross-axis-self-alignment: center;
                        }
                    }
                }
            }

            // ---- page ---------------------------------------------
            if root.page == 1: SettingsPage {
                settings-changed(k, v) => { root.settings-changed(k, v); }
            }

            if root.page == 0: DownloadsPage {
                tasks: root.tasks;
                task-action(id, action) => { root.task-action(id, action); }
                open-detail(id) => { root.open-detail(id); }
                reset-filters => { root.reset-filters(); }
            }
        }
    }

    // ======================================================================
    // Floating action button
    // ======================================================================
    Rectangle {
        x: parent.width - self.width - 28px;
        y: parent.height - self.height - 28px;
        width: 56px;
        height: 56px;
        visible: root.page == 0 && !root.dialog-open && !root.drawer-open;
        border-radius: Aether.radius-lg;
        background: Aether.primary;
        drop-shadow-color: #000000.with-alpha(0.42);
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;

        Image {
            source: AetherIcons.add;
            width: 24px;
            height: 24px;
            colorize: Aether.on-primary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        StateLayer {
            width: 100%;
            height: 100%;
            border-radius: Aether.radius-lg;
            background: Aether.on-primary;
            ripple-color: Aether.on-primary;
            has-ripple: true;
            clicked => { root.dialog-open = true; }
        }
    }

    // ======================================================================
    // Snackbar (action feedback)
    // ======================================================================
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px;
        width: 380px;
        height: 48px;
        border-radius: Aether.radius-md;
        background: Aether.surface-container-highest;
        border-width: 1px;
        border-color: Aether.outline-faint;
        drop-shadow-color: #000000.with-alpha(0.4);
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 5px;
        opacity: root.toast-open ? 1 : 0;
        visible: self.opacity > 0;

        animate opacity { duration: 180ms; easing: ease; }

        // Absorb clicks while the snackbar is on screen.
        TouchArea {}

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;

            Image {
                source: AetherIcons.info;
                width: 18px;
                height: 18px;
                colorize: Aether.primary-bright;
                cross-axis-self-alignment: center;
            }

            Text {
                text: root.toast-text;
                color: Aether.on-surface;
                font-size: Aether.text-caption;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }

    // ======================================================================
    // Overlays
    // ======================================================================
    NewDownloadDialog {
        width: 100%;
        height: 100%;
        open: root.dialog-open;
        confirmed(url, path, seg, limit, note) => {
            root.dialog-open = false;
            root.new-download(url, path, seg, limit, note);
        }
        dismissed => { root.dialog-open = false; }
    }

    TaskDrawer {
        width: 100%;
        height: 100%;
        open: root.drawer-open;
        detail: root.detail;
        peers: root.peers;
        chunks: root.chunks;
        logs: root.logs;
        closed => {
            root.drawer-open = false;
            root.drawer-dismissed();
        }
    }
}
