// Aether — application shell.
//
// Three primary destinations (Home / Downloads / Settings) live in a single
// top bar. Downloads owns its local filters; Settings owns its local category
// navigation. The content is one rounded aurora canvas.

import { Aether } from "theme.slint";
import { ColorSchemeSelector } from "color-scheme.slint";
import { AetherIcons } from "icons.slint";
import { TaskRow, TaskDetail, RecordRow } from "model.slint";
import { FlowBackground, RailButton } from "widgets.slint";
import { HomePage } from "pages/home.slint";
import { DownloadsPage } from "pages/downloads.slint";
import { SettingsPage } from "pages/settings.slint";
import { NewDownloadDialog } from "pages/new-download.slint";
import { TaskDrawer } from "pages/task-drawer.slint";
import { PluginCatalog } from "plugins.slint";

export { PluginCatalog }

export component AppWindow inherits Window {
    // ---- data ------------------------------------------------------------
    in property <[TaskRow]> tasks: [];
    in property <[RecordRow]> records: [];
    in property <[float]> chunks: [];
    in property <TaskDetail> detail: {
        id: -1,
        name: "",
        kind-tone: 0,
        status: 0,
        status-text: "",
        progress: 0,
        progress-text: "",
        speed: "",
        eta: "",
        size: "",
        path: "",
        note: "",
        source: "",
        line-path: "",
        area-path: "",
        peak: "0 B/s",
        sample: 0,
        chunks-text: "",
    };

    // ---- state -----------------------------------------------------------
    in-out property <int> page: 0;              // 0 = home, 1 = downloads, 2 = settings
    in-out property <int> active-filter: 0;
    in-out property <string> search-text: "";
    in-out property <int> settings-tab: 0;
    // Network settings mirrored from the daemon (settings page).
    in-out property <string> settings-dns: "";
    in-out property <string> settings-user-agent: "";
    in-out property <int> settings-ip-mode: 0;
    in-out property <int> settings-proxy-mode: 0;
    in-out property <string> settings-proxy-url: "";
    in-out property <string> settings-headers: "";
    in-out property <bool> settings-ftp-passive: true;
    in-out property <string> settings-bt-port: "51413";
    in-out property <bool> settings-bt-dht: true;
    in-out property <float> settings-bt-upload-kbps: 512;
    in-out property <string> settings-bt-blocklist: "";
    in-out property <string> settings-bt-trackers: "";
    in-out property <string> settings-media-ffmpeg: "";
    // UI-local preferences (settings page).
    in-out property <int> settings-start-page: 0;   // 0=主页, 1=下载列表, 2=上次页面
    in-out property <int> settings-after-done: 0;   // 0=不操作, 1=打开文件夹, 2=打开文件
    in-out property <int> settings-accent: 0;       // preset index, see apply-appearance()
    in-out property <bool> settings-motion: true;
    in-out property <bool> settings-flow: true;
    in-out property <bool> settings-notify-done: true;
    in-out property <bool> settings-notify-fail: true;
    // Clipboard link watch (UI-local, default off).
    in-out property <bool> settings-clipboard: false;
    // Daemon-backed: auto-install outdated plugins on the update cycle.
    in-out property <bool> settings-plugin-auto-update: false;
    // UI-local: interface language (0 = Chinese source, 1 = English).
    in-out property <int> settings-language: 0;
    // True when no clipboard backend exists (headless): the switch stays
    // off and the row explains why instead of pretending to work.
    in-out property <bool> settings-clipboard-available: true;
    // OS-managed start-at-login state (read back from the OS at startup).
    in-out property <bool> settings-autostart: false;
    in-out property <bool> settings-schedule-on: false;
    in-out property <string> settings-schedule-start: "";
    in-out property <string> settings-schedule-end: "";
    // Scheduler limits mirrored from the daemon (settings page).
    in-out property <int> settings-max-tasks: 0;        // index into 3/5/10/16
    in-out property <int> settings-max-connections: 1;  // index into 2/4/8/16
    in-out property <int> settings-retry: 2;            // index into 不重试/3/5/10
    in-out property <bool> settings-global-limit: true;
    in-out property <float> settings-download-limit-kb: 2048;

    // Apply accent preset / motion / flow in one place; called at init and
    // whenever the corresponding settings property changes.
    public function apply-appearance() {
        // Accent presets: [base, dark container, light container, dark on-container,
        // light on-container, dark bright, light bright].
        if (root.settings-accent == 1) {
            // 靛蓝 indigo
            Aether.accent-base = #4355B9;
            Aether.accent-container = Aether.dark ? #344390 : #DFE0FF;
            Aether.on-accent-container = Aether.dark ? #DFE0FF : #00105C;
            Aether.accent-bright = Aether.dark ? #BEC3FF : #3E52A3;
        } else if (root.settings-accent == 2) {
            // 青碧 teal
            Aether.accent-base = #006A6A;
            Aether.accent-container = Aether.dark ? #005052 : #9CF1F0;
            Aether.on-accent-container = Aether.dark ? #9CF1F0 : #002020;
            Aether.accent-bright = Aether.dark ? #80D5D4 : #004F50;
        } else if (root.settings-accent == 3) {
            // 苔绿 green
            Aether.accent-base = #3A6D3C;
            Aether.accent-container = Aether.dark ? #2D5430 : #B5F1B8;
            Aether.on-accent-container = Aether.dark ? #B5F1B8 : #002106;
            Aether.accent-bright = Aether.dark ? #9AD59D : #2D5230;
        } else if (root.settings-accent == 4) {
            // 琥珀 amber
            Aether.accent-base = #8A5100;
            Aether.accent-container = Aether.dark ? #5A3E00 : #FFDDB3;
            Aether.on-accent-container = Aether.dark ? #FFDDB3 : #2C1600;
            Aether.accent-bright = Aether.dark ? #FFBC7C : #744700;
        } else if (root.settings-accent == 5) {
            // 蔷薇 rose
            Aether.accent-base = #993F73;
            Aether.accent-container = Aether.dark ? #772D57 : #FFD9E4;
            Aether.on-accent-container = Aether.dark ? #FFD9E4 : #3E0021;
            Aether.accent-bright = Aether.dark ? #FFAFD1 : #7E2E5D;
        } else {
            // Aurora 紫 (default)
            Aether.accent-base = #6750A4;
            Aether.accent-container = Aether.dark ? #4B3585 : #EADDFF;
            Aether.on-accent-container = Aether.dark ? #EADDFF : #21005D;
            Aether.accent-bright = Aether.dark ? #CBB6FF : #5B3FA0;
        }
        Aether.motion-short = root.settings-motion ? 120ms : 0ms;
        Aether.motion-medium = root.settings-motion ? 220ms : 0ms;
        Aether.motion-long = root.settings-motion ? 400ms : 0ms;
        root.flow-enabled = root.settings-flow;
    }
    in-out property <int> theme-mode: 0;          // 0 = follow system, 1 = light, 2 = dark
    in-out property <string> rail-hint: "";
    in-out property <string> support-hint: "";
    in-out property <bool> system-dark: true;
    in-out property <bool> dialog-open: false;
    // URL prefilled by Rust (clipboard detection); the dialog edits it live.
    in-out property <string> dialog-url: "";
    // Set from Rust: the daemon's download root, used as the dialog default.
    in-out property <string> default-download-dir: "";
    in-out property <string> plugins-dir: "";
    in-out property <string> data-dir: "";
    // Dashboard counters from the daemon's `stats`.
    in-out property <string> today-bytes: "—";
    in-out property <string> today-upload: "—";
    in-out property <string> peak-speed: "—";
    in-out property <string> week-bytes: "—";
    in-out property <float> disk-percent: 0;
    in-out property <string> disk-percent-text: "0%";
    in-out property <string> disk-label: "—";
    in-out property <string> disk-free: "";
    in-out property <string> engine-name: "—";
    in-out property <string> version-name: "—";
    in-out property <string> extension-status: "—";
    in-out property <bool> extension-connected: false;
    in-out property <string> plugins-text: "—";
    in-out property <string> protocols-text: "—";
    in-out property <string> uptime-text: "—";
    in-out property <[float]> day-bars: [];
    in-out property <[string]> day-labels: [];
    in-out property <[float]> cat-fractions: [];
    in-out property <[string]> cat-values: [];
    in-out property <[string]> cat-percents: [];
    in-out property <string> weekly-label: "—";
    in-out property <string> avg-file: "—";
    in-out property <string> success-rate: "—";
    // Set from Rust: `env!("CARGO_PKG_VERSION")`.
    in-out property <string> app-version: "";
    in-out property <bool> drawer-open: false;
    in-out property <bool> flow-enabled: true;
    in-out property <float> drift: 0;
    in-out property <bool> toast-open: false;
    in-out property <string> toast-text: "";
    // Optional action label on the toast ("" = plain message); clicking the
    // button fires `toast-action-clicked` (used by clipboard link detection).
    in-out property <string> toast-action: "";
    callback toast-action-clicked();

    // ---- aggregates ------------------------------------------------------
    in-out property <int> count-all: 0;
    in-out property <int> count-active: 0;
    in-out property <int> count-done: 0;
    in-out property <int> count-paused: 0;
    in-out property <int> count-failed: 0;
    in-out property <int> count-seed: 0;
    in-out property <string> total-speed: "0 B/s";
    in-out property <string> chart-line: "";
    in-out property <string> chart-area: "";
    in-out property <float> chart-latest: 0;
    in-out property <int> speed-limit-mode: 0;   // 0=不限, 1=低, 2=中, 3=高
    callback speed-limit-picked(int);

    // ---- theme -----------------------------------------------------------
    public function apply-theme() {
        Aether.dark = root.theme-mode == 2 || (root.theme-mode == 0 && root.system-dark);
        ColorSchemeSelector.color-scheme = Aether.dark ? ColorScheme.dark : ColorScheme.light;
    }

    init => { self.apply-theme(); self.apply-appearance(); }
    changed theme-mode => { self.apply-theme(); self.apply-appearance(); }
    changed system-dark => { self.apply-theme(); self.apply-appearance(); }
    changed settings-accent => { self.apply-appearance(); }
    changed settings-motion => { self.apply-appearance(); }
    changed settings-flow => { self.apply-appearance(); }

    // ---- signals ---------------------------------------------------------
    callback task-action(int, int);
    callback open-detail(int);
    callback drawer-dismissed();
    callback filter-changed(int, string);
    callback new-download(string, string, int, float, string);
    callback settings-changed(string, string);
    callback reset-filters();
    callback support-action(string);
    callback plugin-toggled(int, bool);
    callback plugin-action(string);

    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 900px;
    min-height: 560px;
    background: Aether.surface-dim;
    // ASCII only: the GNOME title bar font stack has no CJK fallback here.
    title: "Aether";
    icon: @image-url("../assets/logo-icon-256.png");

    FlowBackground {
        enabled: root.flow-enabled;
        drift: root.drift;
    }

    Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        border-radius: 22px;
        background: @linear-gradient(165deg, Aether.canvas-top 0%, Aether.surface 55%, Aether.canvas-bottom 100%);
        border-width: 1px;
        border-color: Aether.outline-faint;
        clip: true;

        // inner atmosphere
        Rectangle {
            x: parent.width - 560px;
            y: -260px;
            width: 680px;
            height: 540px;
            background: @radial-gradient(circle, Aether.glow-primary 0%, transparent 68%);
        }

        Rectangle {
            x: -180px;
            y: parent.height - 340px;
            width: 460px;
            height: 400px;
            background: @radial-gradient(circle, Aether.glow-live 0%, transparent 70%);
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                transparent 0%,
                Aether.primary.with-alpha(0.55) 22%,
                Aether.live.with-alpha(0.34) 74%,
                transparent 100%);
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 0;

            // ---- navigation rail ----------------------------------------
            Rectangle {
                width: Aether.nav-width;
                background: Aether.surface-container-low;

                Rectangle {
                    x: parent.width - 1px;
                    y: 0;
                    width: 1px;
                    height: 100%;
                    background: Aether.outline-faint;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 10px;
                        background: @linear-gradient(135deg, Aether.accent-top, Aether.accent-bottom);
                        border-width: 1px;
                        border-color: #FFFFFF.with-alpha(0.14);
                        cross-axis-self-alignment: center;

                        Image {
                            source: @image-url("../assets/logo-transparent-128.png");
                            width: 26px;
                            height: 26px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Rectangle { height: 8px; background: transparent; }

                    RailButton {
                        icon-source: AetherIcons.home;
                        active: root.page == 0;
                        cross-axis-self-alignment: center;
                        clicked => { root.page = 0; }
                        hover-changed(hovered) => { root.rail-hint = hovered ? @tr("主页") : ""; }
                    }
                    RailButton {
                        icon-source: AetherIcons.download;
                        active: root.page == 1;
                        cross-axis-self-alignment: center;
                        clicked => { root.page = 1; }
                        hover-changed(hovered) => { root.rail-hint = hovered ? @tr("下载") : ""; }
                    }
                    RailButton {
                        icon-source: AetherIcons.tune;
                        active: root.page == 2;
                        cross-axis-self-alignment: center;
                        clicked => { root.page = 2; }
                        hover-changed(hovered) => { root.rail-hint = hovered ? @tr("设置") : ""; }
                    }

                    RailButton {
                        size: Aether.control-lg;
                        icon-size: 18px;
                        accent: true;
                        icon-source: AetherIcons.add;
                        cross-axis-self-alignment: center;
                        clicked => { root.dialog-open = true; }
                        hover-changed(hovered) => { root.rail-hint = hovered ? @tr("新建下载") : ""; }
                    }

                    Text {
                        text: root.rail-hint;
                        width: 100%;
                        height: 16px;
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-micro;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: root.rail-hint == "" ? 0 : 1;
                        animate opacity { duration: Aether.motion-short; easing: ease; }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Text {
                        text: root.support-hint;
                        width: 100%;
                        height: 16px;
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-micro;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: root.support-hint == "" ? 0 : 1;
                        animate opacity { duration: Aether.motion-short; easing: ease; }
                    }

                    RailButton {
                        size: Aether.control-sm;
                        icon-size: Aether.icon-md;
                        icon-source: AetherIcons.note;
                        cross-axis-self-alignment: center;
                        clicked => { root.support-action("docs"); }
                        hover-changed(hovered) => { root.support-hint = hovered ? @tr("使用文档") : ""; }
                    }
                    RailButton {
                        size: Aether.control-sm;
                        icon-size: Aether.icon-md;
                        icon-source: AetherIcons.signal;
                        cross-axis-self-alignment: center;
                        clicked => { root.support-action("community"); }
                        hover-changed(hovered) => { root.support-hint = hovered ? @tr("社区") : ""; }
                    }
                    RailButton {
                        size: Aether.control-sm;
                        icon-size: Aether.icon-md;
                        icon-source: AetherIcons.alert;
                        cross-axis-self-alignment: center;
                        clicked => { root.support-action("feedback"); }
                        hover-changed(hovered) => { root.support-hint = hovered ? @tr("反馈") : ""; }
                    }
                    RailButton {
                        size: Aether.control-sm;
                        icon-size: Aether.icon-md;
                        icon-source: AetherIcons.refresh;
                        cross-axis-self-alignment: center;
                        clicked => { root.support-action("update"); }
                        hover-changed(hovered) => { root.support-hint = hovered ? @tr("更新") : ""; }
                    }
                }
            }

            // ---- content column -----------------------------------------
            VerticalLayout {
                horizontal-stretch: 1;
                height: 100%;
                spacing: 0;

                // ---- pages -----------------------------------------------
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    if root.page == 0: HomePage {
                        width: parent.width;
                        height: parent.height;
                        count-all: root.count-all;
                        count-active: root.count-active;
                        count-done: root.count-done;
                        count-paused: root.count-paused;
                        count-failed: root.count-failed;
                        count-seed: root.count-seed;
                        speed-limit-mode: root.speed-limit-mode;
                        limit-picked(idx) => { root.speed-limit-picked(idx); }
                        total-speed: root.total-speed;
                        chart-line: root.chart-line;
                        chart-area: root.chart-area;
                        chart-latest: root.chart-latest;
                        today-bytes: root.today-bytes;
                        today-upload: root.today-upload;
                        peak-speed: root.peak-speed;
                        week-bytes: root.week-bytes;
                        disk-percent: root.disk-percent;
                        disk-percent-text: root.disk-percent-text;
                        disk-label: root.disk-label;
                        disk-free: root.disk-free;
                        engine-name: root.engine-name;
                        version-name: root.version-name;
                        extension-status: root.extension-status;
                        extension-connected: root.extension-connected;
                        plugins-text: root.plugins-text;
                        protocols-text: root.protocols-text;
                        uptime-text: root.uptime-text;
                        day-bars: root.day-bars;
                        day-labels: root.day-labels;
                        cat-fractions: root.cat-fractions;
                        cat-values: root.cat-values;
                        cat-percents: root.cat-percents;
                        weekly-label: root.weekly-label;
                        avg-file: root.avg-file;
                        success-rate: root.success-rate;
                        open-downloads(filter) => {
                            root.page = 1;
                            root.active-filter = filter;
                            root.filter-changed(filter, root.search-text);
                        }
                        open-plugins => {
                            root.page = 2;
                            root.settings-tab = 5;
                        }
                        open-download-settings => {
                            root.page = 2;
                            root.settings-tab = 1;
                        }
                    }

                    if root.page == 1: DownloadsPage {
                        width: 100%;
                        height: 100%;
                        tasks: root.tasks;
                        drift: root.drift;
                        count-all: root.count-all;
                        count-active: root.count-active;
                        count-done: root.count-done;
                        count-paused: root.count-paused;
                        count-failed: root.count-failed;
                        count-seed: root.count-seed;
                        active-filter <=> root.active-filter;
                        search-text <=> root.search-text;
                        task-action(id, action) => { root.task-action(id, action); }
                        open-detail(id) => { root.open-detail(id); }
                        filter-changed(filter, query) => { root.filter-changed(filter, query); }
                        reset-filters => { root.reset-filters(); }
                    }

                    if root.page == 2: SettingsPage {
                        width: 100%;
                        height: 100%;
                        app-version: root.app-version;
                        download-dir: root.default-download-dir;
                        plugins-dir: root.plugins-dir;
                        data-dir: root.data-dir;
                        tab <=> root.settings-tab;
                        theme-mode <=> root.theme-mode;
                        network-dns <=> root.settings-dns;
                        network-user-agent <=> root.settings-user-agent;
                        network-ip-mode <=> root.settings-ip-mode;
                        network-proxy-mode <=> root.settings-proxy-mode;
                        network-proxy-url <=> root.settings-proxy-url;
                        network-headers <=> root.settings-headers;
                        network-ftp-passive <=> root.settings-ftp-passive;
                        bt-port <=> root.settings-bt-port;
                        bt-dht <=> root.settings-bt-dht;
                        bt-upload-kbps <=> root.settings-bt-upload-kbps;
                        bt-blocklist <=> root.settings-bt-blocklist;
                        bt-trackers <=> root.settings-bt-trackers;
                        media-ffmpeg <=> root.settings-media-ffmpeg;
                        plugin-auto-update <=> root.settings-plugin-auto-update;
                        language-index <=> root.settings-language;
                        start-page <=> root.settings-start-page;
                        after-done <=> root.settings-after-done;
                        accent-index <=> root.settings-accent;
                        motion-on <=> root.settings-motion;
                        flow-on <=> root.settings-flow;
                        notify-done <=> root.settings-notify-done;
                        notify-fail <=> root.settings-notify-fail;
                        clipboard-on <=> root.settings-clipboard;
                        clipboard-available <=> root.settings-clipboard-available;
                        autostart-on <=> root.settings-autostart;
                        schedule-on <=> root.settings-schedule-on;
                        schedule-start <=> root.settings-schedule-start;
                        schedule-end <=> root.settings-schedule-end;
                        settings-max-tasks <=> root.settings-max-tasks;
                        settings-max-connections <=> root.settings-max-connections;
                        settings-retry <=> root.settings-retry;
                        settings-global-limit <=> root.settings-global-limit;
                        settings-download-limit-kb <=> root.settings-download-limit-kb;
                        settings-changed(k, v) => { root.settings-changed(k, v); }
                        support-action(action) => { root.support-action(action); }
                        plugin-toggled(id, enabled) => { root.plugin-toggled(id, enabled); }
                        plugin-action(action) => { root.plugin-action(action); }
                    }
                }
            }
        }

        // ---- transient feedback -------------------------------------
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 16px;
            width: 360px;
            height: 44px;
            border-radius: 14px;
            background: Aether.surface-container-highest;
            border-width: 1px;
            border-color: Aether.outline-variant;
            drop-shadow-color: Aether.shadow-popup;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            opacity: root.toast-open ? 1 : 0;
            visible: self.opacity > 0;

            animate opacity { duration: 180ms; easing: ease; }

            TouchArea {}

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 9px;

                Image {
                    source: AetherIcons.info;
                    width: 16px;
                    height: 16px;
                    colorize: Aether.primary-bright;
                    cross-axis-self-alignment: center;
                }

                Text {
                    text: root.toast-text;
                    color: Aether.on-surface;
                    font-size: Aether.text-caption;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if (root.toast-action != "") : Rectangle {
                    height: 26px;
                    width: action-label.preferred-width + 24px;
                    border-radius: 13px;
                    background: action-area.pressed ? Aether.primary-softer : Aether.primary-soft;
                    cross-axis-self-alignment: center;

                    action-area := TouchArea {
                        clicked => { root.toast-action-clicked(); }
                    }

                    action-label := Text {
                        text: root.toast-action;
                        color: Aether.primary-bright;
                        font-size: Aether.text-caption;
                        font-weight: Aether.weight-medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        height: 100%;
                        x: (parent.width - self.width) / 2;
                    }
                }
            }
        }
    }

    // ======================================================================
    // Overlays
    // ======================================================================
    NewDownloadDialog {
        width: 100%;
        height: 100%;
        open: root.dialog-open;
        default-dir: root.default-download-dir;
        url <=> root.dialog-url;
        confirmed(url, path, seg, limit, note) => {
            root.dialog-open = false;
            root.new-download(url, path, seg, limit, note);
        }
        dismissed => { root.dialog-open = false; }
    }

    TaskDrawer {
        width: 100%;
        height: 100%;
        open: root.drawer-open;
        detail: root.detail;
        chunks: root.chunks;
        task-action(id, action) => { root.task-action(id, action); }
        closed => {
            root.drawer-open = false;
            root.drawer-dismissed();
        }
    }
}
