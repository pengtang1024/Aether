// Aether — data model shared between the Rust side and the UI.

export struct TaskRow {
    id: int,
    name: string,
    source: string,
    kind-tone: int,
    progress: float,
    progress-text: string,
    speed: string,
    eta: string,
    status: int,
    status-text: string,
    paused: bool,
    completed: bool,
    failed: bool,
    selected: bool,
}

export struct TaskDetail {
    id: int,
    name: string,
    kind-tone: int,
    status: int,
    status-text: string,
    progress: float,
    progress-text: string,
    speed: string,
    eta: string,
    size: string,
    path: string,
    note: string,
    source: string,
    line-path: string,
    area-path: string,
    peak: string,
    sample: float,
    chunks-text: string,
    torrent: bool,
    bt-text: string,
}

// One row of a generic plugin detail section: plain cells in schema
// column order (metrics rows carry label + value, peers rows one cell
// per declared column).
export struct DetailRow {
    cells: [string],
}

// One `detail_schema` section flattened for the drawer. `kind` is the
// schema `type` ("metrics", "peers", …); the Rust side only emits
// sections it could actually fill, so `rows` is never empty.
export struct DetailSection {
    kind: string,
    title: string,
    columns: [string],
    rows: [DetailRow],
}

export struct RecordRow {
    id: int,
    name: string,
    kind-tone: int,
    status: int,
    status-text: string,
    time: string,
}

// One declared setting of a plugin (`settings_schema` flattened in schema
// order). The ABI carries no labels, so `key` doubles as the field label;
// `section` repeats on every field of its section and is rendered when it
// changes. `value` is the initial text: the stored value, or "" = not set
// (the default then shows as the placeholder).
export struct SettingField {
    section: string,
    key: string,
    kind: string,
    default: string,
    has-min: bool,
    min: string,
    has-max: bool,
    max: string,
    options: [string],
    options-text: string,
    value: string,
}

export struct PluginRow {
    id: int,
    name: string,
    description: string,
    caps: string,
    version: string,
    category: string,
    kind: int,
    enabled: bool,
    blocked: bool,
    service: bool,
    running: bool,
    error: string,
    update: bool,
    featured: bool,
    can-rollback: bool,
    icon: int,
    tone: int,
    // The daemon declared a settings_schema with at least one field: only
    // then does the row get a configure button.
    can-configure: bool,
}
