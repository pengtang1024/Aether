// Aether — data model shared between the Rust side and the UI.

export struct TaskRow {
    id: int,
    name: string,
    source: string,
    kind-tone: int,
    progress: float,
    progress-text: string,
    speed: string,
    eta: string,
    status: int,
    status-text: string,
    paused: bool,
    completed: bool,
    failed: bool,
    selected: bool,
}

export struct TaskDetail {
    id: int,
    name: string,
    kind-tone: int,
    status: int,
    status-text: string,
    progress: float,
    progress-text: string,
    speed: string,
    eta: string,
    size: string,
    path: string,
    note: string,
    source: string,
    line-path: string,
    area-path: string,
    peak: string,
    sample: float,
    chunks-text: string,
    torrent: bool,
    bt-text: string,
}

export struct RecordRow {
    id: int,
    name: string,
    kind-tone: int,
    status: int,
    status-text: string,
    time: string,
}

export struct PluginRow {
    id: int,
    name: string,
    description: string,
    caps: string,
    version: string,
    category: string,
    kind: int,
    enabled: bool,
    blocked: bool,
    update: bool,
    featured: bool,
    can-rollback: bool,
    icon: int,
    tone: int,
}
