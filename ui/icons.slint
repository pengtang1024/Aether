// Aether — icon registry.
//
// All icons are 24×24 stroke SVGs; they are tinted at use site with
// `colorize:` so a single asset works in every color role.

export global AetherIcons {
    out property <image> download: @image-url("../assets/icons/download.svg");
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> tune: @image-url("../assets/icons/tune.svg");
    out property <image> cloud: @image-url("../assets/icons/cloud.svg");
    out property <image> search: @image-url("../assets/icons/search.svg");
    out property <image> add: @image-url("../assets/icons/add.svg");
    out property <image> close: @image-url("../assets/icons/close.svg");
    out property <image> pause: @image-url("../assets/icons/pause.svg");
    out property <image> play: @image-url("../assets/icons/play.svg");
    out property <image> check: @image-url("../assets/icons/check.svg");
    out property <image> chevron-right: @image-url("../assets/icons/chevron-right.svg");
    out property <image> chevron-down: @image-url("../assets/icons/chevron-down.svg");
    out property <image> more-vert: @image-url("../assets/icons/more-vert.svg");
    out property <image> refresh: @image-url("../assets/icons/refresh.svg");
    out property <image> trash: @image-url("../assets/icons/trash.svg");
    out property <image> edit: @image-url("../assets/icons/edit.svg");
    out property <image> clock: @image-url("../assets/icons/clock.svg");
    out property <image> alert: @image-url("../assets/icons/alert.svg");
    out property <image> info: @image-url("../assets/icons/info.svg");
    out property <image> gauge: @image-url("../assets/icons/gauge.svg");
    out property <image> seed: @image-url("../assets/icons/seed.svg");
    out property <image> note: @image-url("../assets/icons/note.svg");
    out property <image> drive: @image-url("../assets/icons/drive.svg");
    out property <image> link: @image-url("../assets/icons/link.svg");
    out property <image> shield: @image-url("../assets/icons/shield.svg");
    out property <image> moon: @image-url("../assets/icons/moon.svg");
    out property <image> split: @image-url("../assets/icons/split.svg");
    out property <image> list: @image-url("../assets/icons/list.svg");
