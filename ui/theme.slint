// Aether — design tokens.
//
// A thin layer on top of the Material 3 palette (`MaterialPalette`) that
// exposes the app-level roles the UI needs: surfaces, brand colors, the M3
// shape scale and the type scale. Everything is dark-first.

import { MaterialPalette } from "std-widgets.slint";

export global Aether {
    // ---- Surfaces --------------------------------------------------------
    out property <color> surface: #141218;
    out property <color> surface-dim: #0F0D13;
    out property <color> surface-container: #211F26;
    out property <color> surface-container-high: #2B2930;
    out property <color> surface-container-highest: #36343B;
    out property <color> surface-raised: #26232B;

    // ---- Lines -----------------------------------------------------------
    out property <color> outline: #938F99;
    out property <color> outline-variant: #444746;
    out property <color> outline-faint: #333138;

    // ---- Content ---------------------------------------------------------
    out property <color> on-surface: #E6E1E5;
    out property <color> on-surface-variant: #CAC4D0;
    out property <color> on-surface-muted: #948F99;

    // ---- Brand -----------------------------------------------------------
    out property <color> primary: #6750A4;
    out property <color> on-primary: #FFFFFF;
    out property <color> primary-container: #4F378B;
    out property <color> on-primary-container: #EADDFF;
    out property <color> primary-bright: #B69DF8;
    out property <color> primary-soft: #6750A4.with-alpha(0.16);
    out property <color> primary-softer: #6750A4.with-alpha(0.08);

    // ---- Secondary -------------------------------------------------------
    out property <color> secondary-container: #4A4458;
    out property <color> on-secondary-container: #E8DEF8;

    // ---- Status ----------------------------------------------------------
    out property <color> success: #7FD892;
    out property <color> success-container: #1E3B26;
    out property <color> warning: #F5C77E;
    out property <color> warning-container: #3A2E14;
    out property <color> error: #F2B8B5;
    out property <color> error-container: #4A1614;
    out property <color> info: #8AC8E8;
    out property <color> info-container: #16303F;
    out property <color> neutral-container: #36343B;

    // ---- Shape scale (M3) -----------------------------------------------
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 20px;
    out property <length> radius-2xl: 28px;
    out property <length> radius-full: 999px;

    // ---- Spacing ---------------------------------------------------------
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-2xl: 32px;

    // ---- Type scale ------------------------------------------------------
    out property <length> text-display: 30px;
    out property <length> text-headline: 24px;
    out property <length> text-title: 16px;
    out property <length> text-body: 14px;
    out property <length> text-label: 13px;
    out property <length> text-caption: 12px;
    out property <length> text-micro: 11px;

    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;

    // ---- Motion ----------------------------------------------------------
    out property <duration> motion-short: 120ms;
    out property <duration> motion-medium: 220ms;
    out property <duration> motion-long: 400ms;

    // ---- Elevation (soft, M3 tonal rather than heavy shadow) ------------
    out property <color> shadow-soft: #000000.with-alpha(0.35);
    out property <length> elevation-1: 3px;
    out property <length> elevation-2: 8px;
}

// Status → color mapping shared by the task table and the detail drawer.
export global StatusColor {
    public pure function container(kind: int) -> color {
        if (kind == 0) { return Aether.primary-container; }     // downloading
        if (kind == 1) { return Aether.success-container; }     // completed
        if (kind == 2) { return Aether.warning-container; }     // paused
        if (kind == 3) { return Aether.error-container; }       // failed
        if (kind == 4) { return Aether.neutral-container; }     // queued
        if (kind == 5) { return Aether.info-container; }        // seeding
        return Aether.neutral-container;
    }

    public pure function label(kind: int) -> color {
        if (kind == 0) { return Aether.on-primary-container; }
        if (kind == 1) { return Aether.success; }
        if (kind == 2) { return Aether.warning; }
        if (kind == 3) { return Aether.error; }
        if (kind == 4) { return Aether.on-surface-variant; }
        if (kind == 5) { return Aether.info; }
        return Aether.on-surface-variant;
    }
}

// File-type accent used by the table row badge. Kept deliberately quiet:
// a tinted outline plus a readable label, never a saturated block of color.
export global FileTone {
    public pure function label(tone: int) -> color {
        if (tone == 1) { return Aether.primary-bright; }   // archives
        if (tone == 2) { return Aether.warning; }          // disk images
        if (tone == 3) { return Aether.info; }             // video
        if (tone == 4) { return Aether.success; }          // executables
        return Aether.on-surface-variant;
    }

    public pure function container(tone: int) -> color {
        if (tone == 1) { return Aether.primary.with-alpha(0.13); }
        if (tone == 2) { return Aether.warning.with-alpha(0.10); }
        if (tone == 3) { return Aether.info.with-alpha(0.10); }
        if (tone == 4) { return Aether.success.with-alpha(0.10); }
        return Aether.on-surface.with-alpha(0.05);
    }

    public pure function outline(tone: int) -> color {
        if (tone == 0) { return Aether.outline-faint; }
        return label(tone).with-alpha(0.24);
    }
}
