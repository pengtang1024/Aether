// Aether — first-party plugin catalogue.
//
// Filled from Rust: one row per installed plugin as the daemon registry
// reports it (see `src/backend.rs`). Counts and the row list stay in sync
// with the daemon; nothing here is hardcoded.

import { PluginRow } from "model.slint";

export global PluginCatalog {
    // Total installed; enabled; known updates; built-in vs community split.
    in-out property <int> total: 0;
    in-out property <int> active: 0;
    in-out property <int> updates: 0;
    in-out property <int> builtin: 0;
    in-out property <int> community: 0;

    in-out property <[PluginRow]> all: [];
}
