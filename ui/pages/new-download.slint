// Aether — icon-only "new download" dialog.
//
// The form keeps its values, but every label is a hover tip. There is no
// title, helper copy or persistent field label.

import { ComboBox, IconButton, LineEdit, Slider, StateLayer } from "std-widgets.slint";
import { Aether } from "theme.slint";
import { AetherIcons } from "icons.slint";
import { Tip } from "widgets.slint";

component FieldIcon inherits Rectangle {
    in property <image> icon-source;
    in property <string> label: "";

    height: 18px;
    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: 6px;

        Image {
            source: root.icon-source;
            width: 15px;
            height: 15px;
            colorize: Aether.on-surface-muted;
            cross-axis-self-alignment: center;
        }

        Text {
            text: root.label;
            color: Aether.on-surface-variant;
            font-size: Aether.text-micro;
            vertical-alignment: center;
            opacity: touch.has-hover ? 1 : 0;

            animate opacity { duration: Aether.motion-short; easing: ease; }
        }
    }

    touch := TouchArea {}
}

component DialogIcon inherits Rectangle {
    in property <image> icon-source;
    in property <string> tip: "";
    in property <bool> accent: false;
    in property <bool> enabled: true;
    callback clicked;

    width: Aether.control-md;
    height: Aether.control-md;
    border-radius: Aether.radius-md;
    border-width: 1px;
    border-color: root.accent ? #FFFFFF.with-alpha(0.14) : Aether.outline-faint;
    background: root.accent
        ? @linear-gradient(135deg, Aether.accent-top, Aether.accent-bottom)
        : touch.has-hover && root.enabled ? Aether.on-surface.with-alpha(0.07)
        : Aether.surface-container-low;
    opacity: root.enabled ? 1 : 0.35;

    Image {
        source: root.icon-source;
        width: 18px;
        height: 18px;
        colorize: root.accent ? Aether.on-primary : Aether.on-surface-variant;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Tip {
        x: (parent.width - self.width) / 2;
        y: -31px;
        text: root.tip;
        show: touch.has-hover && root.enabled;
    }
}

export component NewDownloadDialog inherits FocusScope {
    in property <bool> open: false;
    in-out property <string> url: "";
    // Filled by the window with the daemon's download root.
    in property <string> default-dir: "";
    in-out property <string> path: root.default-dir;
    in-out property <int> segments-index: 0;
    in-out property <float> speed-limit: 0;
    in-out property <string> note: "";

    callback confirmed(string, string, int, float, string);
    callback dismissed();

    function submit() {
        if (root.url != "") {
            root.confirmed(root.url, root.path, root.segments-index, root.speed-limit, root.note);
        }
    }

    visible: root.open;

    key-pressed(event) => {
        if (event.text == Key.Escape) {
            if (path-menu.visible) {
                path-menu.visible = false;
                return accept;
            }
            root.dismissed();
            return accept;
        }
        return reject;
    }

    init => {
        if (root.open) {
            url-field.focus();
        }
    }

    changed open => {
        if (self.open) {
            url-field.focus();
            path-menu.visible = false;
        }
    }

    // ---- scrim -----------------------------------------------------------
    Rectangle {
        width: 100%;
        height: 100%;
        background: Aether.scrim;

        TouchArea {
            clicked => { root.dismissed(); }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, Aether.primary.with-alpha(0.06) 0%, transparent 58%);
    }

    // ---- dialog card -----------------------------------------------------
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 560px;
        height: 480px;
        border-radius: 24px;
        background: @linear-gradient(160deg, Aether.dialog-top, Aether.dialog-bottom 100%);
        border-width: 1px;
        border-color: Aether.outline-variant;
        drop-shadow-color: Aether.shadow-popup;
        drop-shadow-blur: 38px;
        drop-shadow-offset-y: 14px;
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                transparent,
                Aether.primary.with-alpha(0.60) 24%,
                Aether.live.with-alpha(0.34) 76%,
                transparent);
        }

        Rectangle {
            x: parent.width - 340px;
            y: -220px;
            width: 420px;
            height: 380px;
            background: @radial-gradient(circle, Aether.glow-primary 0%, transparent 68%);
        }

        TouchArea {}

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // ---- header: icon + close only ---------------------------
            HorizontalLayout {
                height: Aether.control-lg;

                Rectangle {
                    width: Aether.control-lg;
                    height: Aether.control-lg;
                    border-radius: Aether.radius-md;
                    background: @linear-gradient(135deg, Aether.accent-top, Aether.accent-bottom);
                    border-width: 1px;
                    border-color: #FFFFFF.with-alpha(0.14);
                    cross-axis-self-alignment: center;

                    Image {
                        source: AetherIcons.download;
                        width: 20px;
                        height: 20px;
                        colorize: Aether.on-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                IconButton {
                    icon: AetherIcons.close;
                    cross-axis-self-alignment: center;
                    clicked => { root.dismissed(); }
                }
            }

            // ---- url --------------------------------------------------
            VerticalLayout {
                spacing: 6px;

                FieldIcon {
                    icon-source: AetherIcons.link;
                    label: @tr("下载地址");
                }

                url-field := LineEdit {
                    width: 100%;
                    text: root.url;
                    placeholder-text: @tr("https://…（空格分隔可一次粘贴多个链接/磁力）");
                    edited => { root.url = self.text; }
                    accepted => { root.submit(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Aether.outline-variant.with-alpha(0.55);
            }

            // ---- save path --------------------------------------------
            VerticalLayout {
                spacing: 6px;

                FieldIcon {
                    icon-source: AetherIcons.folder;
                    label: @tr("保存路径");
                }

                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        horizontal-stretch: 1;
                        text: root.path;
                        show-clear-button: false;
                        edited => { root.path = self.text; }
                    }

                    IconButton {
                        icon: AetherIcons.folder;
                        cross-axis-self-alignment: center;
                        clicked => { path-menu.visible = !path-menu.visible; }
                    }
                }
            }

            // ---- segmented options ------------------------------------
            Rectangle {
                border-radius: Aether.radius-md;
                background: Aether.surface-container-low;
                border-width: 1px;
                border-color: Aether.outline-faint;

                VerticalLayout {
                    padding: Aether.space-md;
                    spacing: Aether.space-sm;

                    HorizontalLayout {
                        spacing: 22px;

                        VerticalLayout {
                            width: 160px;
                            spacing: 6px;

                            FieldIcon {
                                icon-source: AetherIcons.layers;
                                label: @tr("分段数");
                            }

                            ComboBox {
                                model: ["自动", "1", "4", "8", "16", "32"];
                                current-index: root.segments-index;
                                min-width: 160px;
                                max-width: 160px;
                                selected => { root.segments-index = self.current-index; }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;

                            FieldIcon {
                                icon-source: AetherIcons.gauge;
                                label: @tr("单任务限速");
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                height: Aether.control-md;

                                Slider {
                                    horizontal-stretch: 1;
                                    value: root.speed-limit;
                                    minimum: 0;
                                    maximum: 2048;
                                    step: 64;
                                    changed => { root.speed-limit = self.value; }
                                }

                                Text {
                                    text: root.speed-limit <= 0 ? "不限" : root.speed-limit + " KB/s";
                                    color: root.speed-limit <= 0 ? Aether.on-surface-muted : Aether.on-surface;
                                    font-size: Aether.text-caption;
                                    font-weight: Aether.weight-medium;
                                    min-width: 78px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    cross-axis-self-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // ---- note --------------------------------------------------
            VerticalLayout {
                spacing: 6px;

                FieldIcon {
                    icon-source: AetherIcons.note;
                    label: @tr("备注");
                }

                LineEdit {
                    width: 100%;
                    text: root.note;
                    edited => { root.note = self.text; }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Rectangle {
                height: 1px;
                background: Aether.outline-variant.with-alpha(0.55);
            }

            // ---- footer: two icon actions ----------------------------
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                DialogIcon {
                    icon-source: AetherIcons.close;
                    tip: "取消";
                    clicked => { root.dismissed(); }
                }

                DialogIcon {
                    icon-source: AetherIcons.download;
                    tip: "开始下载";
                    accent: true;
                    enabled: root.url != "";
                    clicked => { root.submit(); }
                }
            }
        }

        path-menu := Rectangle {
            visible: false;
            x: 20px;
            y: 221px;
            width: parent.width - 88px;
            height: path-menu.visible ? 148px : 0px;
            border-radius: 12px;
            background: Aether.surface-container-highest;
            border-width: 1px;
            border-color: Aether.outline-variant;
            drop-shadow-color: Aether.shadow-popup;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                for p in [root.default-dir, root.default-dir + "/Videos", root.default-dir + "/Documents"] : Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: p == root.path ? Aether.primary.with-alpha(0.12) : transparent;

                    Image {
                        source: AetherIcons.folder;
                        width: 14px;
                        height: 14px;
                        colorize: p == root.path ? Aether.primary-bright : Aether.on-surface-muted;
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: p;
                        color: p == root.path ? Aether.primary-bright : Aether.on-surface-variant;
                        font-size: Aether.text-caption;
                        font-weight: p == root.path ? Aether.weight-medium : Aether.weight-regular;
                        x: 32px;
                        y: (parent.height - self.height) / 2;
                    }

                    if p == root.path: Image {
                        source: AetherIcons.check;
                        width: 13px;
                        height: 13px;
                        colorize: Aether.primary-bright;
                        x: parent.width - self.width - 10px;
                        y: (parent.height - self.height) / 2;
                    }

                    StateLayer {
                        width: 100%;
                        height: 100%;
                        border-radius: 8px;
                        background: Aether.on-surface;
                        ripple-color: Aether.on-surface;
                        has-ripple: true;
                        clicked => { root.path = p; path-menu.visible = false; }
                    }
                }
            }
        }
    }
}
