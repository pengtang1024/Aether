// Network and BitTorrent settings panels.
import { Switch, ComboBox, LineEdit } from "std-widgets.slint";
import { Aether } from "../../theme.slint";
import { AetherIcons } from "../../icons.slint";
import { SectionCard, SettingRow } from "../../widgets.slint";
import { SettingsFilter } from "../../settings-filter.slint";
import { PresetCustomHint, SettingsValidation } from "common.slint";

export component NetworkPanel inherits Rectangle {
    in property <string> app-version: "";
    // Daemon-backed state, mirrored by the window; edits go out on
    // `changed` (commit on Enter, or when the clear button empties the field).
    in-out property <string> dns-value: "";
    in-out property <string> user-agent-value: "";
    in-out property <int> ip-mode-index: 0;
    in-out property <[string]> ip-mode-model: [@tr("IPv4 + IPv6"), @tr("仅 IPv4"), @tr("仅 IPv6")];
    in-out property <int> proxy-mode-index: 0;
    in-out property <[string]> proxy-mode-model: [@tr("跟随系统"), @tr("直连"), @tr("手动"), "PAC"];
    in-out property <string> proxy-url-value: "";
    in-out property <string> headers-value: "";
    in-out property <bool> ftp-passive-on: true;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        SectionCard {
            icon-source: AetherIcons.link;
            title: @tr("代理");
            id: "network-proxy";
            subtitle: @tr("让下载经过系统或自定义网络");

            SettingRow {
                id: "network-proxy-mode";
                icon-source: AetherIcons.signal;
                title: @tr("代理模式");
                description: @tr("跟随系统或为 Aether 单独配置");
                divider: root.proxy-mode-index == 2 || SettingsFilter.active;
                ComboBox {
                    model: root.proxy-mode-model;
                    current-index <=> root.proxy-mode-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    // Index 4 is the appended custom row; it only echoes the
                    // stored mode and must not be written back.
                    selected => { if (self.current-index < 4) { root.changed("proxy-mode", self.current-index == 1 ? "直连" : self.current-index == 2 ? "手动" : self.current-index == 3 ? "PAC" : "跟随系统"); } }
                }
            }
            if root.proxy-mode-index == 4: PresetCustomHint { }
            // The address only means something in manual mode.
            if root.proxy-mode-index == 2 || SettingsFilter.active: SettingRow {
                id: "network-proxy-url";
                icon-source: AetherIcons.link;
                title: @tr("代理地址");
                description: @tr("支持 HTTP / SOCKS5；手动模式下生效");
                divider: false;
                VerticalLayout {
                    spacing: 2px;
                    LineEdit {
                        text <=> root.proxy-url-value;
                        placeholder-text: "http://127.0.0.1:7890";
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        accepted => { root.changed("proxy-url", self.text); }
                        edited(text) => { if (text == "") { root.changed("proxy-url", text); } }
                    }
                    if SettingsValidation.error("proxy-url") != "": Text {
                        text: SettingsValidation.error("proxy-url");
                        color: Aether.error;
                        font-size: Aether.text-micro;
                        width: Aether.field-md;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.shield;
            title: @tr("协议与请求");
            id: "network-protocol";
            subtitle: @tr("兼容性与请求行为");

            SettingRow {
                id: "network-ip-mode";
                icon-source: AetherIcons.layers;
                title: @tr("IP 协议");
                description: @tr("仅 HTTP(S) 下载生效；BT / FTP 不受影响");
                ComboBox {
                    model: root.ip-mode-model;
                    current-index <=> root.ip-mode-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { if (self.current-index < 3) { root.changed("ip-mode", self.current-index == 1 ? "仅 IPv4" : self.current-index == 2 ? "仅 IPv6" : "IPv4 + IPv6"); } }
                }
            }
            if root.ip-mode-index == 3: PresetCustomHint { }
            SettingRow {
                id: "network-ftp-passive";
                icon-source: AetherIcons.link;
                title: @tr("FTP 被动模式");
                description: @tr("兼容更多 FTP 服务器；关闭后使用主动模式");
                divider: false;
                Switch { checked <=> root.ftp-passive-on; toggled => { root.changed("ftp-passive", self.checked ? "true" : "false"); } }
            }
        }

        // ---- advanced: free-form request knobs, collapsed by default.
        SectionCard {
            icon-source: AetherIcons.tune;
            title: @tr("高级网络选项");
            id: "network-advanced";
            subtitle: @tr("留空即用推荐值，通常无需修改");
            collapsible: true;
            expanded: false;

            SettingRow {
                id: "network-dns";
                icon-source: AetherIcons.cloud;
                title: @tr("DNS 服务器");
                description: @tr("仅 HTTP(S) 生效；指定后失败即报错，不回退系统 DNS");
                VerticalLayout {
                    spacing: 2px;
                    LineEdit {
                        text <=> root.dns-value;
                        placeholder-text: "223.5.5.5, 1.1.1.1";
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        accepted => { root.changed("dns", self.text); }
                        // The clear button only fires `edited`; commit an empty
                        // value so the displayed field never lies.
                        edited(text) => { if (text == "") { root.changed("dns", text); } }
                    }
                    if SettingsValidation.error("dns") != "": Text {
                        text: SettingsValidation.error("dns");
                        color: Aether.error;
                        font-size: Aether.text-micro;
                        width: Aether.field-md;
                        horizontal-alignment: right;
                    }
                }
            }
            SettingRow {
                id: "network-user-agent";
                icon-source: AetherIcons.info;
                title: "User-Agent";
                description: @tr("留空使用 Aether 默认值；改动对空闲插件立即生效");
                VerticalLayout {
                    spacing: 2px;
                    LineEdit {
                        text <=> root.user-agent-value;
                        placeholder-text: "Aether/0.6";
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        accepted => { root.changed("user-agent", self.text); }
                        edited(text) => { if (text == "") { root.changed("user-agent", text); } }
                    }
                }
            }
            SettingRow {
                id: "network-headers";
                icon-source: AetherIcons.note;
                title: @tr("自定义请求头");
                description: @tr("Key: Value，多条用分号分隔；仅 HTTP 族插件，任务级同名头优先");
                divider: false;
                VerticalLayout {
                    spacing: 2px;
                    LineEdit {
                        text <=> root.headers-value;
                        placeholder-text: "Referer: https://example.com";
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        accepted => { root.changed("headers", self.text); }
                        edited(text) => { if (text == "") { root.changed("headers", text); } }
                    }
                    if SettingsValidation.error("headers") != "": Text {
                        text: SettingsValidation.error("headers");
                        color: Aether.error;
                        font-size: Aether.text-micro;
                        width: Aether.field-md;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}


