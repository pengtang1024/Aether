// Download settings: presets first, with an out-of-preset value kept visible.
import { Switch, ComboBox } from "std-widgets.slint";
import { Aether } from "../../theme.slint";
import { AetherIcons } from "../../icons.slint";
import { SectionCard, SettingRow } from "../../widgets.slint";
import { PresetCustomHint, ValueSlider } from "common.slint";

export component DownloadPanel inherits Rectangle {
    // UI-local preference, mirrored from the window.
    in-out property <int> after-done-index: 0;
    // Scheduler limits mirrored from the window (set from the daemon), so
    // the page shows what runs instead of the widget defaults: 3 concurrent
    // tasks, 4 connections per task, 5 retries, no global cap (the slider
    // remembers 2048 KB/s for when the user turns the switch on).
    in-out property <int> max-tasks-index: 0;
    in-out property <int> max-connections-index: 1;
    in-out property <int> retry-index: 2;
    // Fixed presets plus a display-only custom row for a value outside them.
    in property <[string]> after-done-model: [@tr("不操作"), @tr("打开所在文件夹"), @tr("打开文件")];
    in property <[string]> max-tasks-model: ["3", "5", "10", "16"];
    in property <[string]> max-connections-model: ["2", "4", "8", "16"];
    in property <[string]> retry-model: [@tr("不重试"), "3", "5", "10"];
    // Set when the non-preset value itself is out of the accepted range.
    in property <string> max-tasks-warning: "";
    in property <string> max-connections-warning: "";
    in-out property <bool> global-limit-on: false;
    in-out property <float> download-limit-kb: 2048;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.split;
            title: @tr("并发与分段");
            id: "download-concurrency";
            subtitle: @tr("决定下载速度和服务器压力");

            SettingRow {
                id: "download-max-tasks";
                icon-source: AetherIcons.layers;
                title: @tr("同时进行的下载数");
                description: @tr("超出后任务进入等待队列");
                VerticalLayout {
                    spacing: 2px;
                    ComboBox {
                        model: root.max-tasks-model;
                        current-index <=> root.max-tasks-index;
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        // Index 4 is the appended custom row: an echo, not a choice.
                        selected => { if (self.current-index < 4) { root.changed("max-tasks", self.current-value); } }
                    }
                    if root.max-tasks-index == 4: PresetCustomHint { }
                    if root.max-tasks-warning != "": Text {
                        text: root.max-tasks-warning;
                        color: Aether.error;
                        font-size: Aether.text-micro;
                        width: Aether.field-md;
                        horizontal-alignment: right;
                        wrap: word-wrap;
                    }
                }
            }
            SettingRow {
                id: "download-connections";
                icon-source: AetherIcons.signal;
                title: @tr("每任务连接数");
                description: @tr("HTTP(S) 单任务并行连接数，上限 16");
                VerticalLayout {
                    spacing: 2px;
                    ComboBox {
                        model: root.max-connections-model;
                        current-index <=> root.max-connections-index;
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        selected => { if (self.current-index < 4) { root.changed("max-connections", self.current-value); } }
                    }
                    if root.max-connections-index == 4: PresetCustomHint { }
                    if root.max-connections-warning != "": Text {
                        text: root.max-connections-warning;
                        color: Aether.error;
                        font-size: Aether.text-micro;
                        width: Aether.field-md;
                        horizontal-alignment: right;
                        wrap: word-wrap;
                    }
                }
            }
            SettingRow {
                id: "download-retries";
                icon-source: AetherIcons.refresh;
                title: @tr("失败重试次数");
                description: @tr("网络抖动或超时后自动重试");
                divider: false;
                VerticalLayout {
                    spacing: 2px;
                    ComboBox {
                        model: root.retry-model;
                        current-index <=> root.retry-index;
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        selected => { if (self.current-index < 4) { root.changed("retry-count", self.current-index == 0 ? "不重试" : self.current-value); } }
                    }
                    if root.retry-index == 4: PresetCustomHint { }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.gauge;
            title: @tr("带宽");
            id: "download-bandwidth";
            subtitle: @tr("全局限速与智能调度");

            SettingRow {
                id: "download-limit-toggle";
                icon-source: AetherIcons.gauge;
                title: @tr("启用全局限速");
                description: @tr("限制所有任务的合计带宽");
                Switch { checked <=> root.global-limit-on; toggled => { root.changed("global-limit", self.checked ? "true" : "false"); } }
            }
            ValueSlider {
                id: "download-limit";
                icon-source: AetherIcons.download;
                label: @tr("下载限速");
                value <=> root.download-limit-kb;
                minimum: 0;
                maximum: 10240;
                suffix: " KB/s";
                divider: false;
                // The switch above owns the setting: dim the cap while it is
                // off so a drag cannot look like it took effect.
                enabled: root.global-limit-on;
                changed(v) => { root.changed("download-limit", v); }
            }
        }

        SectionCard {
            icon-source: AetherIcons.drive;
            title: @tr("任务");
            id: "download-after";
            subtitle: @tr("完成动作");

            SettingRow {
                id: "download-after-done";
                icon-source: AetherIcons.folder;
                title: @tr("完成后动作");
                description: @tr("任务下载完成后的默认行为");
                divider: false;
                VerticalLayout {
                    spacing: 2px;
                    ComboBox {
                        model: root.after-done-model;
                        current-index <=> root.after-done-index;
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                        selected => { if (self.current-index < 3) { root.changed("after-done", self.current-index == 1 ? "打开所在文件夹" : self.current-index == 2 ? "打开文件" : "不操作"); } }
                    }
                    if root.after-done-index == 3: PresetCustomHint { }
                }
            }
        }
    }
}
