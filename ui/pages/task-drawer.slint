// Aether — icon-only task inspector.
//
// Resting state: file glyph, status dot, progress line, icon actions, metric
// glyphs, chart, chunk grid and info glyphs. Every label or value is a hover
// tip; there is no persistent text.

import { IconButton, ScrollView } from "std-widgets.slint";
import { Aether, StatusColor } from "theme.slint";
import { AetherIcons } from "icons.slint";
import { TaskDetail, DetailSection } from "model.slint";
import { ChunkGrid, FileGlyph, SpeedChart, Tip } from "widgets.slint";

component ActionIcon inherits Rectangle {
    in property <image> icon-source;
    in property <bool> accent: false;
    in property <bool> danger: false;
    callback clicked;

    width: Aether.control-sm;
    height: Aether.control-sm;
    border-radius: Aether.radius-sm;
    border-width: 1px;
    border-color: root.accent ? Aether.primary.with-alpha(0.32)
        : root.danger ? Aether.error.with-alpha(0.20)
        : Aether.outline-faint;
    background: root.accent ? Aether.primary-soft
        : root.danger ? Aether.error.with-alpha(0.07)
        : touch.has-hover ? Aether.on-surface.with-alpha(0.07)
        : Aether.surface-container-high;

    Image {
        source: root.icon-source;
        width: 16px;
        height: 16px;
        colorize: root.accent ? Aether.primary-bright : root.danger ? Aether.error : Aether.on-surface-variant;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component MetricIcon inherits Rectangle {
    in property <image> icon-source;
    in property <color> tone;
    in property <string> tip: "";

    height: 60px;
    border-radius: 12px;
    background: Aether.surface-container-high;
    border-width: 1px;
    border-color: Aether.outline-faint;

    Image {
        source: root.icon-source;
        width: 17px;
        height: 17px;
        colorize: root.tone;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {}

    Tip {
        x: (parent.width - self.width) / 2;
        y: -30px;
        text: root.tip;
        show: touch.has-hover;
    }
}

component InfoIcon inherits Rectangle {
    in property <image> icon-source;
    in property <string> tip: "";

    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: Aether.surface-container-high;
    border-width: 1px;
    border-color: Aether.outline-faint;

    Image {
        source: root.icon-source;
        width: 15px;
        height: 15px;
        colorize: Aether.on-surface-muted;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {}

    Tip {
        x: 0;
        y: -30px;
        text: root.tip;
        show: touch.has-hover;
    }
}

export component TaskDrawer inherits FocusScope {
    in property <bool> open: false;
    in property <TaskDetail> detail;
    in property <[float]> chunks: [];
    // Schema-driven sections (metrics / peers) rendered under the chart.
    in property <[DetailSection]> sections: [];

    callback closed();
    callback task-action(int, int);

    visible: root.open;

    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.closed();
            return accept;
        }
        return reject;
    }

    init => {
        if (root.open) {
            self.focus();
        }
    }

    changed open => {
        if (self.open) {
            self.focus();
        }
    }

    // ---- scrim ------------------------------------------------------------
    Rectangle {
        width: 100%;
        height: 100%;
        background: Aether.scrim;

        TouchArea {
            clicked => { root.closed(); }
        }
    }

    // ---- compact floating inspector --------------------------------------
    panel := Rectangle {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        width: 360px;
        // Sections add a bounded peers pane; reserve room for it so the
        // generic content is visible without scrolling on a normal screen.
        height: min(parent.height - 24px, root.sections.length > 0 ? 640px : 470px);
        border-radius: 22px;
        background: @linear-gradient(165deg, Aether.sheet-top, Aether.sheet-bottom 72%);
        border-width: 1px;
        border-color: Aether.outline-variant;
        drop-shadow-color: Aether.shadow-popup;
        drop-shadow-blur: 30px;
        drop-shadow-offset-x: -8px;
        clip: true;

        TouchArea {}

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                Aether.primary.with-alpha(0.55),
                Aether.live.with-alpha(0.28) 60%,
                transparent);
        }

        VerticalLayout {
            spacing: 0;

            // ---- header ------------------------------------------------
            Rectangle {
                height: 72px;

                HorizontalLayout {
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        cross-axis-self-alignment: center;

                        FileGlyph {
                            tone: root.detail.kind-tone;
                        }

                        glyph-touch := TouchArea {}
                    }

                    // Persistent identity: the same name/status pair as the
                    // hover card, so a live task is never anonymous.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: root.detail.name;
                            color: Aether.on-surface;
                            font-size: Aether.text-caption;
                            font-weight: Aether.weight-medium;
                            overflow: elide;
                        }

                        Text {
                            text: root.detail.status-text + " · " + root.detail.progress-text;
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: StatusColor.label(root.detail.status);
                        cross-axis-self-alignment: center;
                    }

                    IconButton {
                        icon: AetherIcons.close;
                        cross-axis-self-alignment: center;
                        clicked => { root.closed(); }
                    }
                }

                // Name and values live in a hover card next to the glyph.
                Rectangle {
                    visible: glyph-touch.has-hover;
                    x: 58px;
                    y: 16px;
                    width: 226px;
                    height: 40px;
                    border-radius: 9px;
                    background: Aether.surface-container-highest;
                    border-width: 1px;
                    border-color: Aether.outline-variant;
                    drop-shadow-color: Aether.shadow-popup;
                    drop-shadow-blur: 16px;
                    drop-shadow-offset-y: 5px;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 2px;
                        height: 100%;
                        border-radius: 1px;
                        background: StatusColor.label(root.detail.status);
                    }

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        padding-top: 5px;
                        padding-bottom: 4px;
                        spacing: 1px;
                        alignment: center;

                        Text {
                            text: root.detail.name;
                            color: Aether.on-surface;
                            font-size: Aether.text-caption;
                            font-weight: Aether.weight-medium;
                            overflow: elide;
                        }

                        Text {
                            text: root.detail.status-text + " · " + root.detail.progress-text;
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    y: parent.height - self.height;
                    width: 100%;
                    height: 4px;
                    background: Aether.outline-faint;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * clamp(root.detail.progress, 0, 1);
                        height: 100%;
                        background: StatusColor.fill(root.detail.status);
                        drop-shadow-color: StatusColor.fill(root.detail.status).with-alpha(0.6);
                        drop-shadow-blur: 8px;
                    }
                }
            }

            // ---- quick actions -----------------------------------------
            Rectangle {
                height: 46px;
                background: Aether.band;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;

                    ActionIcon {
                        icon-source: root.detail.status == 1 ? AetherIcons.folder
                            : root.detail.status == 3 ? AetherIcons.refresh
                            : root.detail.status == 2 || root.detail.status == 4 ? AetherIcons.play
                            : AetherIcons.pause;
                        accent: true;
                        clicked => {
                            root.task-action(root.detail.id,
                                root.detail.status == 1 ? 3
                                : root.detail.status == 3 ? 1
                                : 0);
                        }
                    }

                    if root.detail.status != 1: ActionIcon {
                        icon-source: AetherIcons.folder;
                        clicked => { root.task-action(root.detail.id, 3); }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    ActionIcon {
                        icon-source: AetherIcons.trash;
                        danger: true;
                        clicked => { root.task-action(root.detail.id, 2); }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: 100%;
                    height: 1px;
                    background: Aether.outline-faint.with-alpha(0.7);
                }
            }

            // ---- visual body -------------------------------------------
            // Explicit height (header 72 + actions 46) keeps the scroll
            // viewport independent of the panel's preferred size.
            body-box := Rectangle {
                height: panel.height - 118px;
                // Only clip when the content really overflows, so the hover
                // tips above the first row keep their full height at rest.
                clip: body-list.content-height > body-list.height;
                background: transparent;

                body-list := ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        width: 100%;
                        padding-left: 16px;
                        padding-right: 16px;
                        // Headroom for the -30px hover tips above the first
                        // row when the viewport does clip.
                        padding-top: 30px;
                        padding-bottom: 16px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 8px;

                            MetricIcon {
                                icon-source: AetherIcons.gauge;
                                tone: Aether.live;
                                tip: @tr("实时速度  ") + root.detail.speed;
                                horizontal-stretch: 1;
                            }

                            MetricIcon {
                                icon-source: AetherIcons.clock;
                                tone: Aether.primary-bright;
                                tip: @tr("剩余时间  ") + root.detail.eta;
                                horizontal-stretch: 1;
                            }

                            MetricIcon {
                                icon-source: AetherIcons.drive;
                                tone: Aether.info;
                                tip: @tr("文件大小  ") + root.detail.size;
                                horizontal-stretch: 1;
                            }
                        }

                        Rectangle {
                            height: 110px;
                            border-radius: 14px;
                            background: Aether.surface-dim;
                            border-width: 1px;
                            border-color: Aether.outline-faint;

                            VerticalLayout {
                                padding: 10px;

                                SpeedChart {
                                    width: 100%;
                                    height: 100%;
                                    line-path: root.detail.line-path;
                                    area-path: root.detail.area-path;
                                    latest: root.detail.sample;
                                    caption: "";
                                }
                            }

                            chart-touch := TouchArea {}

                            Tip {
                                x: (parent.width - self.width) / 2;
                                y: -30px;
                                text: @tr("传输速度  ·  峰值 ") + root.detail.peak;
                                show: chart-touch.has-hover;
                            }
                        }

                        Rectangle {
                            height: 48px;

                            ChunkGrid {
                                width: 100%;
                                chunks: root.chunks;
                            }

                            chunk-touch := TouchArea {}

                            Tip {
                                x: (parent.width - self.width) / 2;
                                y: -30px;
                                text: @tr("分片进度  ") + root.detail.chunks-text;
                                show: chunk-touch.has-hover;
                            }
                        }

                        if root.detail.torrent: Text {
                            text: @tr("BT 状态  ") + root.detail.bt-text;
                            color: Aether.on-surface-variant;
                            font-size: Aether.text-caption;
                            overflow: elide;
                        }

                        // Generic sections from the plugin's `detail_schema`,
                        // in schema order. The Rust mapping only emits
                        // metrics/peers sections it could fill, so other
                        // kinds (logs, chunks, unknown) render nothing here.
                        for section in root.sections: VerticalLayout {
                            spacing: 6px;

                            if section.kind == "metrics": VerticalLayout {
                                spacing: 6px;

                                for row in section.rows: HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: row.cells[0];
                                        color: Aether.on-surface-muted;
                                        font-size: Aether.text-micro;
                                        overflow: elide;
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    Text {
                                        text: row.cells[1];
                                        color: Aether.on-surface;
                                        font-size: Aether.text-caption;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                            }

                            if section.kind == "peers": Rectangle {
                                height: 100px;
                                border-radius: 12px;
                                background: Aether.surface-dim;
                                border-width: 1px;
                                border-color: Aether.outline-faint;
                                clip: true;

                                ScrollView {
                                    width: 100%;
                                    height: 100%;

                                    VerticalLayout {
                                        width: 100%;
                                        padding: 8px;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            for col[index] in section.columns: Text {
                                                text: col;
                                                color: Aether.on-surface-muted;
                                                font-size: Aether.text-micro;
                                                font-weight: Aether.weight-medium;
                                                horizontal-stretch: index == 0 ? 2 : 1;
                                                overflow: elide;
                                            }
                                        }

                                        for row in section.rows: HorizontalLayout {
                                            spacing: 8px;

                                            for cell[index] in row.cells: Text {
                                                text: cell;
                                                color: index == 0 ? Aether.on-surface : Aether.on-surface-variant;
                                                font-size: Aether.text-micro;
                                                horizontal-stretch: index == 0 ? 2 : 1;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            InfoIcon {
                                icon-source: AetherIcons.link;
                                tip: @tr("来源  ") + root.detail.source;
                            }

                            InfoIcon {
                                icon-source: AetherIcons.folder;
                                tip: @tr("保存位置  ") + root.detail.path;
                            }

                            InfoIcon {
                                icon-source: AetherIcons.note;
                                tip: @tr("备注  ") + (root.detail.note != "" ? root.detail.note : "—");
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }
    }
}
