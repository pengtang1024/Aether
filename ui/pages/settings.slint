// Aether — settings centre.
//
// A local, scrollable category navigation on the left and one large settings
// panel on the right. The three global destinations stay in the app bar.

import { ScrollView, Switch, Slider, ComboBox, LineEdit, TextButton } from "std-widgets.slint";
import { Aether } from "theme.slint";
import { AetherIcons } from "icons.slint";
import { PluginGlyph, SectionCard, SettingRow } from "widgets.slint";
import { PluginRow } from "model.slint";
import { SettingsFilter, SettingsHit } from "../settings-filter.slint";
import { PluginCatalog } from "plugins.slint";

component ValueSlider inherits Rectangle {
    in property <image> icon-source;
    // Search identity, same contract as SettingRow.
    in property <string> id: "";
    in property <string> label: "";
    // Two-way with the caller: the page mirrors the daemon's value in, a
    // drag writes it back out.
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <string> suffix: "";
    in property <bool> divider: true;
    callback changed(float);
    /// Fires once when the drag ends; daemon-backed limits commit here so a
    /// drag does not send one `set_settings` per pixel.
    callback released(float);

    height: SettingsFilter.shows-row(root.id) ? Aether.row-comfortable : 0px;
    visible: SettingsFilter.shows-row(root.id);

    HorizontalLayout {
        spacing: Aether.space-sm;

        Rectangle {
            width: Aether.card-icon;
            height: Aether.card-icon;
            background: transparent;
            cross-axis-self-alignment: center;

            Image {
                source: root.icon-source;
                width: Aether.icon-md;
                height: Aether.icon-md;
                colorize: Aether.on-surface-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            color: Aether.on-surface-variant;
            font-size: Aether.text-body;
            width: Aether.slider-label-w;
            vertical-alignment: center;
            overflow: elide;
        }

        inner := Slider {
            horizontal-stretch: 1;
            value <=> root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            changed => { root.changed(self.value); }
            released => { root.released(self.value); }
        }

        Rectangle {
            height: Aether.value-chip-h;
            width: Aether.value-chip-w;
            border-radius: Aether.radius-sm;
            background: Aether.surface-container-highest;
            border-width: 1px;
            border-color: Aether.outline-faint;
            cross-axis-self-alignment: center;

            Text {
                text: root.value + root.suffix;
                color: Aether.on-surface;
                font-size: Aether.text-caption;
                font-weight: Aether.weight-medium;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.divider: Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: 1px;
        background: Aether.outline-variant.with-alpha(0.45);
    }
}

component SettingsNav inherits Rectangle {
    in property <image> icon-source;
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    height: Aether.settings-nav-row;
    border-radius: Aether.radius-sm;
    background: root.active ? Aether.primary-soft
        : touch.has-hover ? Aether.on-surface.with-alpha(0.04)
        : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        Image {
            source: root.icon-source;
            width: Aether.icon-md;
            height: Aether.icon-md;
            colorize: root.active ? Aether.primary-bright : Aether.on-surface-muted;
            cross-axis-self-alignment: center;
        }

        Text {
            text: root.text;
            color: root.active ? Aether.primary-bright : Aether.on-surface-variant;
            font-size: Aether.text-label;
            font-weight: root.active ? Aether.weight-medium : Aether.weight-regular;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component PanelHeader inherits Rectangle {
    in property <image> icon-source;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <color> tone: Aether.primary-bright;

    height: Aether.panel-header;

    HorizontalLayout {
        spacing: 12px;

        Rectangle {
            width: Aether.control-sm;
            height: Aether.control-sm;
            border-radius: Aether.radius-md;
            background: root.tone.with-alpha(0.14);
            border-width: 1px;
            border-color: root.tone.with-alpha(0.24);
            cross-axis-self-alignment: center;

            Image {
                source: root.icon-source;
                width: Aether.icon-lg;
                height: Aether.icon-lg;
                colorize: root.tone;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.title;
                color: Aether.on-surface;
                font-size: Aether.text-headline;
                font-weight: Aether.weight-semibold;
                letter-spacing: -0.2px;
            }

            Text {
                text: root.subtitle;
                color: Aether.on-surface-muted;
                font-size: Aether.text-caption;
            }
        }

        @children
    }
}

// ---------------------------------------------------------------------------
// Panels. Each panel is a vertical stack of grouped M3 cards.
// ---------------------------------------------------------------------------
component GeneralPanel inherits Rectangle {
    // Real paths from the daemon (read-only: set at daemon start).
    in property <string> download-dir: "";
    // Daemon-independent UI preference, mirrored from the window.
    in-out property <int> start-page-index: 0;
    // Clipboard link watch: off by default, and honestly unavailable when
    // the session has no clipboard backend.
    in-out property <bool> clipboard-on: false;
    in-out property <bool> clipboard-available: true;
    // OS-managed start-at-login state (mirrored from the window).
    in-out property <bool> autostart-on: false;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.info;
            title: @tr("启动");
            id: "general-start";
            subtitle: @tr("启动位置与窗口行为");

            SettingRow {
                id: "general-start-page";
                icon-source: AetherIcons.home;
                title: @tr("启动页面");
                description: @tr("每次打开 Aether 时显示的页面");
                ComboBox {
                    // Display labels are translated; the value stays the
                    // canonical Chinese string the daemon-side mapping reads.
                    model: [@tr("主页"), @tr("下载列表"), @tr("上次页面")];
                    current-index <=> root.start-page-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("start-page", self.current-index == 1 ? "下载列表" : self.current-index == 2 ? "上次页面" : "主页"); }
                }
            }

            SettingRow {
                id: "general-autostart";
                icon-source: AetherIcons.play;
                title: @tr("开机自启");
                description: @tr("登录系统时静默启动 Aether（驻留托盘，不弹主窗口；由操作系统管理，删除自启项即关闭）");
                Switch {
                    checked <=> root.autostart-on;
                    toggled => { root.changed("autostart", self.checked ? "true" : "false"); }
                }
            }

            SettingRow {
                id: "general-close-window";
                icon-source: AetherIcons.close;
                title: @tr("关闭窗口");
                description: @tr("有系统托盘时收进托盘继续下载，从托盘菜单退出；没有托盘时直接退出");
                divider: false;
            }
        }

        SectionCard {
            icon-source: AetherIcons.folder;
            title: @tr("存储");
            id: "general-storage";
            subtitle: @tr("下载目录");

            SettingRow {
                id: "general-download-dir";
                icon-source: AetherIcons.folder;
                title: @tr("默认下载目录");
                badge: @tr("只读");
                description: @tr("daemon 启动参数决定，新任务默认保存到这里");
                divider: false;
                LineEdit {
                    text: root.download-dir == "" ? @tr("未连接") : root.download-dir;
                    read-only: true;
                    show-clear-button: false;
                    min-width: Aether.field-lg;
                    max-width: Aether.field-lg;
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.note;
            title: @tr("剪贴板");
            id: "general-clipboard";
            subtitle: @tr("复制链接后提示一键下载");

            SettingRow {
                id: "general-clipboard-watch";
                icon-source: AetherIcons.download;
                title: @tr("检测下载链接");
                description: root.clipboard-available
                    ? @tr("剪贴板出现下载链接时弹出提示，点提示直接新建任务；仅在链接变化时检测，内容不离开本机")
                    : @tr("当前会话没有可用的剪贴板后端（远程/无图形会话），此功能不可用");
                divider: false;
                Switch {
                    checked <=> root.clipboard-on;
                    enabled: root.clipboard-available;
                    toggled => { root.changed("clipboard-watch", self.checked ? "true" : "false"); }
                }
            }
        }
    }
}

component DownloadPanel inherits Rectangle {
    // UI-local preference, mirrored from the window.
    in-out property <int> after-done-index: 0;
    // Scheduler limits mirrored from the window (set from the daemon), so
    // the page shows what runs instead of the widget defaults: 3 concurrent
    // tasks, 4 connections per task, 5 retries, 2048 KB/s global cap.
    in-out property <int> max-tasks-index: 0;
    in-out property <int> max-connections-index: 1;
    in-out property <int> retry-index: 2;
    in-out property <bool> global-limit-on: true;
    in-out property <float> download-limit-kb: 2048;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.split;
            title: @tr("并发与分段");
            id: "download-concurrency";
            subtitle: @tr("决定下载速度和服务器压力");

            SettingRow {
                id: "download-max-tasks";
                icon-source: AetherIcons.layers;
                title: @tr("同时进行的下载数");
                description: @tr("超出后任务进入等待队列");
                ComboBox {
                    model: ["3", "5", "10", "16"];
                    current-index <=> root.max-tasks-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("max-tasks", self.current-value); }
                }
            }
            SettingRow {
                id: "download-connections";
                icon-source: AetherIcons.signal;
                title: @tr("每任务连接数");
                description: @tr("HTTP(S) 单任务并行连接数，上限 16");
                ComboBox {
                    model: ["2", "4", "8", "16"];
                    current-index <=> root.max-connections-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("max-connections", self.current-value); }
                }
            }
            SettingRow {
                id: "download-retries";
                icon-source: AetherIcons.refresh;
                title: @tr("失败重试次数");
                description: @tr("网络抖动或超时后自动重试");
                divider: false;
                ComboBox {
                    model: [@tr("不重试"), "3", "5", "10"];
                    current-index <=> root.retry-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("retry-count", self.current-index == 0 ? "不重试" : self.current-value); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.gauge;
            title: @tr("带宽");
            id: "download-bandwidth";
            subtitle: @tr("全局限速与智能调度");

            SettingRow {
                id: "download-limit-toggle";
                icon-source: AetherIcons.gauge;
                title: @tr("启用全局限速");
                description: @tr("限制所有任务的合计带宽");
                Switch { checked <=> root.global-limit-on; toggled => { root.changed("global-limit", self.checked ? "true" : "false"); } }
            }
            ValueSlider {
                id: "download-limit";
                icon-source: AetherIcons.download;
                label: @tr("下载限速");
                value <=> root.download-limit-kb;
                minimum: 0;
                maximum: 10240;
                suffix: " KB/s";
                divider: false;
                changed(v) => { root.changed("download-limit", v); }
            }
        }

        SectionCard {
            icon-source: AetherIcons.drive;
            title: @tr("任务");
            id: "download-after";
            subtitle: @tr("完成动作");

            SettingRow {
                id: "download-after-done";
                icon-source: AetherIcons.folder;
                title: @tr("完成后动作");
                description: @tr("任务下载完成后的默认行为");
                divider: false;
                ComboBox {
                    model: [@tr("不操作"), @tr("打开所在文件夹"), @tr("打开文件")];
                    current-index <=> root.after-done-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("after-done", self.current-index == 1 ? "打开所在文件夹" : self.current-index == 2 ? "打开文件" : "不操作"); }
                }
            }
        }
    }
}

component NetworkPanel inherits Rectangle {
    in property <string> app-version: "";
    // Daemon-backed state, mirrored by the window; edits go out on
    // `changed` (commit on Enter, or when the clear button empties the field).
    in-out property <string> dns-value: "";
    in-out property <string> user-agent-value: "";
    in-out property <int> ip-mode-index: 0;
    in-out property <int> proxy-mode-index: 0;
    in-out property <string> proxy-url-value: "";
    in-out property <string> headers-value: "";
    in-out property <bool> ftp-passive-on: true;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.link;
            title: @tr("代理");
            id: "network-proxy";
            subtitle: @tr("让下载经过系统或自定义网络");

            SettingRow {
                id: "network-proxy-mode";
                icon-source: AetherIcons.signal;
                title: @tr("代理模式");
                description: @tr("跟随系统或为 Aether 单独配置");
                ComboBox {
                    model: [@tr("跟随系统"), @tr("直连"), @tr("手动"), "PAC"];
                    current-index <=> root.proxy-mode-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("proxy-mode", self.current-index == 1 ? "直连" : self.current-index == 2 ? "手动" : self.current-index == 3 ? "PAC" : "跟随系统"); }
                }
            }
            SettingRow {
                id: "network-proxy-url";
                icon-source: AetherIcons.link;
                title: @tr("代理地址");
                description: @tr("支持 HTTP / SOCKS5；切到手动模式后生效");
                LineEdit {
                    text <=> root.proxy-url-value;
                    placeholder-text: "http://127.0.0.1:7890";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("proxy-url", self.text); }
                }
            }
            SettingRow {
                id: "network-dns";
                icon-source: AetherIcons.cloud;
                title: @tr("DNS 服务器");
                description: @tr("仅 HTTP(S) 生效；指定后失败即报错，不回退系统 DNS");
                LineEdit {
                    text <=> root.dns-value;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    accepted => { root.changed("dns", self.text); }
                    // The clear button only fires `edited`; commit an empty
                    // value so the displayed field never lies.
                    edited(text) => { if (text == "") { root.changed("dns", text); } }
                }
            }
            SettingRow {
                id: "network-ip-mode";
                icon-source: AetherIcons.layers;
                title: @tr("IP 协议");
                description: @tr("仅 HTTP(S) 下载生效；BT / FTP 不受影响");
                divider: false;
                ComboBox {
                    model: [@tr("IPv4 + IPv6"), @tr("仅 IPv4"), @tr("仅 IPv6")];
                    current-index <=> root.ip-mode-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("ip-mode", self.current-index == 1 ? "仅 IPv4" : self.current-index == 2 ? "仅 IPv6" : "IPv4 + IPv6"); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.shield;
            title: @tr("协议与请求");
            id: "network-protocol";
            subtitle: @tr("兼容性与请求行为");

            SettingRow {
                id: "network-user-agent";
                icon-source: AetherIcons.info;
                title: "User-Agent";
                description: @tr("留空使用 Aether 默认值；改动对空闲插件立即生效");
                LineEdit {
                    text <=> root.user-agent-value;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    accepted => { root.changed("user-agent", self.text); }
                    edited(text) => { if (text == "") { root.changed("user-agent", text); } }
                }
            }
            SettingRow {
                id: "network-headers";
                icon-source: AetherIcons.note;
                title: @tr("自定义请求头");
                description: @tr("Key: Value，多条用分号分隔；仅 HTTP 族插件，任务级同名头优先");
                LineEdit {
                    text <=> root.headers-value;
                    placeholder-text: "Referer: https://example.com";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    accepted => { root.changed("headers", self.text); }
                    edited(text) => { if (text == "") { root.changed("headers", text); } }
                }
            }
            SettingRow {
                id: "network-ftp-passive";
                icon-source: AetherIcons.link;
                title: @tr("FTP 被动模式");
                description: @tr("兼容更多 FTP 服务器；关闭后使用主动模式");
                divider: false;
                Switch { checked <=> root.ftp-passive-on; toggled => { root.changed("ftp-passive", self.checked ? "true" : "false"); } }
            }
        }
    }
}

component BtPanel inherits Rectangle {
    // Daemon-backed state, mirrored by the window; edits commit on Enter /
    // switch toggle / slider release.
    in-out property <string> bt-port-value: "51413";
    in-out property <bool> bt-dht-on: true;
    in-out property <float> bt-upload-kbps: 512;
    in-out property <string> bt-blocklist-value: "";
    in-out property <string> bt-trackers-value: "";
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.link;
            title: @tr("连接");
            id: "bt-connection";
            subtitle: @tr("端口与节点发现");

            SettingRow {
                id: "bt-port";
                icon-source: AetherIcons.link;
                title: @tr("监听端口");
                description: @tr("需要放行时在路由器中转发");
                LineEdit {
                    text <=> root.bt-port-value;
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    accepted => { root.changed("bt-port", self.text); }
                    edited(text) => { if (text == "") { root.changed("bt-port", text); } }
                }
            }
            SettingRow {
                id: "bt-dht";
                icon-source: AetherIcons.seed;
                title: "DHT";
                description: @tr("通过分布式哈希表发现节点");
                divider: false;
                Switch { checked <=> root.bt-dht-on; toggled => { root.changed("bt-dht", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.upload;
            title: @tr("做种");
            id: "bt-seed";
            subtitle: @tr("上传带宽，0 为不限速");

            ValueSlider {
                id: "bt-upload-limit";
                icon-source: AetherIcons.upload;
                label: @tr("上传限速");
                value <=> root.bt-upload-kbps;
                minimum: 0;
                maximum: 4096;
                suffix: " KB/s";
                divider: false;
                released(v) => { root.changed("bt-upload-limit", v); }
            }
        }

        SectionCard {
            icon-source: AetherIcons.shield;
            title: @tr("过滤与 Tracker");
            id: "bt-filter";
            subtitle: @tr("屏蔽规则与私有 Tracker");

            SettingRow {
                id: "bt-blocklist";
                icon-source: AetherIcons.drive;
                title: @tr("屏蔽列表路径");
                description: @tr("dat 格式黑名单文件或 URL；留空不启用");
                divider: false;
                LineEdit {
                    text <=> root.bt-blocklist-value;
                    show-clear-button: false;
                    placeholder-text: "/path/to/blocklist.dat";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    accepted => { root.changed("bt-blocklist", self.text); }
                    edited(text) => { if (text == "") { root.changed("bt-blocklist", text); } }
                }
            }
            SettingRow {
                id: "bt-trackers";
                icon-source: AetherIcons.link;
                title: @tr("Tracker 列表");
                description: @tr("附加到所有种子；多条用分号分隔");
                divider: false;
                LineEdit {
                    text <=> root.bt-trackers-value;
                    placeholder-text: "udp://tracker.example:80/announce";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    accepted => { root.changed("bt-trackers", self.text); }
                    edited(text) => { if (text == "") { root.changed("bt-trackers", text); } }
                }
            }
        }
    }
}

component MediaPanel inherits Rectangle {
    // Daemon-backed ffmpeg path, shared by rtmp capture and the media
    // remux step; edits go out on `changed` (commit on Enter).
    in-out property <string> ffmpeg-value: "";
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.info;
            title: @tr("媒体下载");
            id: "media-capability";
            subtitle: @tr("已实现的能力");

            SettingRow {
                id: "media-hls";
                icon-source: AetherIcons.play;
                title: @tr("HLS / DASH 直链");
                description: @tr("粘贴 .m3u8 / .mpd 链接即可下载，AES 加密分段自动解密合并；下载完成后可按任务转封装容器（transcode_to，仅 -c copy 不重编码）");
                divider: false;
                Text {
                    text: @tr("已支持");
                    color: Aether.success;
                    font-size: Aether.text-caption;
                    font-weight: Aether.weight-medium;
                    vertical-alignment: center;
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.tune;
            title: "ffmpeg";
            id: "media-ffmpeg";
            subtitle: @tr("rtmp 直播录制与媒体转封装共用");

            SettingRow {
                id: "media-ffmpeg-path";
                icon-source: AetherIcons.info;
                title: @tr("ffmpeg 路径");
                description: @tr("留空使用 PATH 里的 ffmpeg（或 AETHER_FFMPEG 环境变量）；对之后开始的任务生效");
                LineEdit {
                    text <=> root.ffmpeg-value;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    placeholder-text: "ffmpeg";
                    accepted => { root.changed("ffmpeg-path", self.text); }
                    edited(text) => { if (text == "") { root.changed("ffmpeg-path", text); } }
                }
            }
        }
    }
}

component PluginFilter inherits Rectangle {
    in property <string> text: "";
    in property <int> count: 0;
    in property <bool> selected: false;
    callback clicked;

    height: 28px;
    border-radius: Aether.radius-full;
    border-width: 1px;
    border-color: root.selected ? Aether.primary.with-alpha(0.32) : Aether.outline-faint;
    background: root.selected ? Aether.primary-soft
        : touch.has-hover ? Aether.on-surface.with-alpha(0.05)
        : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        Text {
            text: root.text;
            color: root.selected ? Aether.primary-bright : Aether.on-surface-variant;
            font-size: Aether.text-caption;
            vertical-alignment: center;
        }

        Text {
            text: "" + root.count;
            color: root.selected ? Aether.primary-bright : Aether.on-surface-muted;
            font-size: Aether.text-micro;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// Small status pill used by the plugin list and the search strip.
component StatusChip inherits Rectangle {
    in property <string> text: "";
    in property <color> tone: Aether.on-surface-muted;

    height: 18px;
    border-radius: Aether.radius-full;
    background: root.tone.with-alpha(0.10);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.22);

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.text;
            color: root.tone;
            font-size: Aether.text-micro;
            font-weight: Aether.weight-medium;
            vertical-alignment: center;
        }
    }
}

// Group caption in the category rail.
component NavGroupLabel inherits Rectangle {
    in property <string> text: "";

    height: 20px;
    background: transparent;

    Text {
        text: root.text;
        width: 100%;
        color: Aether.on-surface-muted;
        font-size: Aether.text-micro;
        font-weight: Aether.weight-medium;
        letter-spacing: 0.4px;
        vertical-alignment: bottom;
    }
}

// Calm placeholder for an empty filter result.
component EmptyHint inherits Rectangle {
    in property <string> title: "";
    in property <string> hint: "";

    height: 96px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        Text {
            text: root.title;
            color: Aether.on-surface-variant;
            font-size: Aether.text-body;
            font-weight: Aether.weight-medium;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            color: Aether.on-surface-muted;
            font-size: Aether.text-caption;
            horizontal-alignment: center;
        }
    }
}

component InstalledPlugin inherits Rectangle {
    in property <PluginRow> plugin;
    // First row in the unfiltered list: no rule above it.
    in property <bool> first: false;
    callback toggled(int, bool);
    callback removed(int);
    callback rolled-back(int);

    height: Aether.plugin-row;
    background: touch.has-hover ? Aether.on-surface.with-alpha(0.03) : transparent;

    // Hover only: declared first so the controls stay on top and clickable.
    touch := TouchArea {
        width: 100%;
        height: 100%;
    }

    if !root.first: Rectangle {
        y: 0;
        width: 100%;
        height: 1px;
        background: Aether.outline-variant.with-alpha(0.4);
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Aether.space-sm;

        Rectangle {
            width: Aether.card-icon;
            height: Aether.card-icon;
            background: transparent;
            cross-axis-self-alignment: center;

            PluginGlyph {
                icon: root.plugin.icon;
                tone: root.plugin.tone;
                width: Aether.card-icon;
                height: Aether.card-icon;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: root.plugin.name;
                    color: Aether.on-surface;
                    font-size: Aether.text-body;
                    font-weight: Aether.weight-medium;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: "v" + root.plugin.version;
                    color: Aether.on-surface-muted;
                    font-size: Aether.text-micro;
                    vertical-alignment: center;
                }

                if root.plugin.service && root.plugin.running: StatusChip {
                    text: @tr("运行中");
                    tone: Aether.success;
                }

                if root.plugin.service && root.plugin.enabled && !root.plugin.running: StatusChip {
                    text: @tr("未启动");
                    tone: Aether.warning;
                }
            }

            Text {
                text: root.plugin.error != ""
                    ? @tr("错误：") + root.plugin.error
                    : root.plugin.description;
                color: root.plugin.error != "" ? Aether.error : Aether.on-surface-muted;
                font-size: Aether.text-caption;
                overflow: elide;
            }

            // Declared capabilities, not marketing copy: the manifest is the
            // contract and the host refuses undeclared runtime claims.
            Text {
                text: root.plugin.blocked
                    ? @tr("权限：") + root.plugin.caps + @tr("（外部进程被设置阻止）")
                    : @tr("权限：") + root.plugin.caps;
                color: root.plugin.blocked ? Aether.warning : Aether.on-surface-muted;
                font-size: Aether.text-micro;
                overflow: elide;
            }
        }

        if root.plugin.update: StatusChip {
            text: @tr("可更新");
            tone: Aether.warning;
        }

        if root.plugin.can-rollback: TextButton {
            text: @tr("回滚");
            cross-axis-self-alignment: center;
            clicked => { root.rolled-back(root.plugin.id); }
        }

        TextButton {
            text: @tr("卸载");
            text-color: Aether.on-surface-variant;
            cross-axis-self-alignment: center;
            clicked => { root.removed(root.plugin.id); }
        }

        Switch {
            checked: root.plugin.enabled;
            cross-axis-self-alignment: center;
            toggled => { root.toggled(root.plugin.id, self.checked); }
        }
    }
}

component PluginPanel inherits Rectangle {
    in-out property <int> plugin-filter: 0;
    in property <string> plugins-dir: "";
    // Daemon-backed: auto-install outdated plugins on the update cycle.
    in-out property <bool> auto-update-on: false;
    // Daemon-backed version pins: "id=version; id=version".
    in-out property <string> plugin-pins: "";
    // Host policy gate for plugins that declare `external-process`.
    in-out property <bool> external-process-on: true;
    // Draft path of the package to install (UI-local until the button
    // fires `plugin-install`).
    in-out property <string> install-path: "";
    callback changed(string, string);
    callback plugin-toggled(int, bool);
    callback plugin-remove(int);
    callback plugin-rollback(int);
    callback plugin-action(string);

    // How many rows the current filter keeps; the empty state keys off it.
    property <int> visible-count:
        root.plugin-filter == 0 ? PluginCatalog.total
        : root.plugin-filter == 1 ? PluginCatalog.builtin
        : root.plugin-filter == 2 ? PluginCatalog.active
        : PluginCatalog.updates;

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.list;
            title: @tr("插件库");
            id: "plugin-catalog";
            subtitle: PluginCatalog.builtin + @tr(" 个内置 · ") + PluginCatalog.community + @tr(" 个社区 · 独立进程运行");

            HorizontalLayout {
                height: Aether.control-md;
                spacing: 6px;
                cross-axis-alignment: center;

                PluginFilter { text: @tr("全部"); count: PluginCatalog.total; selected: root.plugin-filter == 0; clicked => { root.plugin-filter = 0; } }
                PluginFilter { text: @tr("内置"); count: PluginCatalog.builtin; selected: root.plugin-filter == 1; clicked => { root.plugin-filter = 1; } }
                PluginFilter { text: @tr("已启用"); count: PluginCatalog.active; selected: root.plugin-filter == 2; clicked => { root.plugin-filter = 2; } }
                PluginFilter { text: @tr("可更新"); count: PluginCatalog.updates; selected: root.plugin-filter == 3; clicked => { root.plugin-filter = 3; } }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                TextButton {
                    text: @tr("更新全部");
                    enabled: PluginCatalog.updates > 0;
                    clicked => { root.plugin-action("update-all"); }
                }
            }

            if root.visible-count == 0: EmptyHint {
                title: @tr("没有符合条件的插件");
                hint: @tr("换一个筛选条件，或在插件目录中加入新的插件");
            }

            for plugin in PluginCatalog.all: InstalledPlugin {
                plugin: plugin;
                first: plugin.id == 0;
                visible: root.plugin-filter == 0
                    || (root.plugin-filter == 1 && plugin.kind == 0)
                    || (root.plugin-filter == 2 && plugin.enabled)
                    || (root.plugin-filter == 3 && plugin.update);
                toggled(id, enabled) => { root.plugin-toggled(id, enabled); }
                removed(id) => { root.plugin-remove(id); }
                rolled-back(id) => { root.plugin-rollback(id); }
            }
        }

        SectionCard {
            icon-source: AetherIcons.layers;
            title: @tr("插件引擎");
            id: "plugin-engine";
            subtitle: @tr("插件目录、来源与更新");

            SettingRow {
                id: "plugin-auto-update";
                icon-source: AetherIcons.refresh;
                title: @tr("自动更新插件");
                description: @tr("daemon 每 6 小时按更新清单安装插件新版；需配置更新清单与签名公钥");
                Switch {
                    checked <=> root.auto-update-on;
                    toggled => { root.changed("plugin-auto-update", self.checked ? "true" : "false"); }
                }
            }
            SettingRow {
                id: "plugin-external-process";
                icon-source: AetherIcons.shield;
                title: @tr("允许外部进程");
                description: @tr("关闭后，声明 external-process 的插件（yt-dlp/ffmpeg）不会启动；运行中的任务跑完当前进程");
                Switch {
                    checked <=> root.external-process-on;
                    toggled => { root.changed("plugin-external-process", self.checked ? "true" : "false"); }
                }
            }
            SettingRow {
                id: "plugin-pins";
                icon-source: AetherIcons.tune;
                title: @tr("固定插件版本");
                description: @tr("id=版本，多条用分号分隔；固定后自动/手动检查更新都会跳过该插件（仍可手动安装）");
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        text <=> root.plugin-pins;
                        placeholder-text: "http=0.2.0; bt=0.2.0";
                        horizontal-stretch: 1;
                        accepted => { root.changed("plugin-pins", self.text); }
                    }
                    TextButton {
                        text: @tr("保存");
                        clicked => { root.changed("plugin-pins", root.plugin-pins); }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Aether.outline-variant.with-alpha(0.45);
            }

            Rectangle { height: 2px; background: transparent; }

            Text {
                text: @tr("出于安全考虑，不支持加载插件目录之外、未验签的文件；请用上面的「安装插件」，它会验签后复制进插件目录。");
                color: Aether.on-surface-muted;
                font-size: Aether.text-micro;
                wrap: word-wrap;
            }
            SettingRow {
                id: "plugin-dir";
                icon-source: AetherIcons.folder;
                title: @tr("插件目录");
                description: @tr("本地插件的安装位置");
                LineEdit {
                    text: root.plugins-dir == "" ? @tr("未连接") : root.plugins-dir;
                    read-only: true;
                    show-clear-button: false;
                    min-width: Aether.field-lg;
                    max-width: Aether.field-lg;
                }
            }
            SettingRow {
                id: "plugin-install";
                icon-source: AetherIcons.download;
                title: @tr("安装插件");
                description: @tr("插件包目录的绝对路径（含 plugin.json）；daemon 校验 manifest 签名与文件哈希后复制进插件目录");
                divider: false;
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        text <=> root.install-path;
                        placeholder-text: "/path/to/plugin-package";
                        horizontal-stretch: 1;
                        accepted => { root.changed("plugin-install", self.text); }
                    }
                    TextButton {
                        text: @tr("安装");
                        clicked => { root.changed("plugin-install", root.install-path); }
                    }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.note;
            title: @tr("开发");
            id: "plugin-dev";
            subtitle: @tr("调试与重新加载");

            SettingRow {
                id: "plugin-reload";
                icon-source: AetherIcons.refresh;
                title: @tr("重新加载插件");
                description: @tr("不重启应用刷新本地插件");
                divider: false;
                TextButton {
                    text: @tr("重新加载");
                    clicked => { root.plugin-action("reload"); }
                }
            }

            Rectangle { height: 2px; background: transparent; }

            Text {
                text: @tr("开发者模式尚未实现：每任务日志已经出现在任务详情里。");
                color: Aether.on-surface-muted;
                font-size: Aether.text-micro;
                wrap: word-wrap;
            }
        }
    }
}

component SchedulePanel inherits Rectangle {
    // Daemon-backed schedule + UI-local notification preferences, mirrored
    // by the window.
    in-out property <bool> schedule-on: false;
    in-out property <string> schedule-start: "";
    in-out property <string> schedule-end: "";
    in-out property <bool> notify-done-on: true;
    in-out property <bool> notify-fail-on: true;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.clock;
            title: @tr("计划任务");
            id: "schedule-plan";
            subtitle: @tr("时段外自动暂停队列，到点自动恢复");

            SettingRow {
                id: "schedule-enabled";
                icon-source: AetherIcons.play;
                title: @tr("启用计划下载");
                description: @tr("需要填好开始与结束时间");
                Switch { checked <=> root.schedule-on; toggled => { root.changed("schedule-on", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                id: "schedule-start";
                icon-source: AetherIcons.clock;
                title: @tr("开始时间");
                description: @tr("本机时间 HH:MM，例如 01:00");
                LineEdit {
                    text <=> root.schedule-start;
                    placeholder-text: "01:00";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    accepted => { root.changed("schedule-start", self.text); }
                    edited(text) => { if (text == "") { root.changed("schedule-start", text); } }
                }
            }
            SettingRow {
                id: "schedule-end";
                icon-source: AetherIcons.pause;
                title: @tr("结束时间");
                description: @tr("早于开始时间表示跨午夜，例如 22:00 - 07:00");
                divider: false;
                LineEdit {
                    text <=> root.schedule-end;
                    placeholder-text: "07:00";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    accepted => { root.changed("schedule-end", self.text); }
                    edited(text) => { if (text == "") { root.changed("schedule-end", text); } }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.info;
            title: @tr("通知");
            id: "schedule-notify";
            subtitle: @tr("任务结束时的系统通知");

            SettingRow {
                id: "schedule-notify-done";
                icon-source: AetherIcons.check;
                title: @tr("下载完成");
                description: @tr("完成后通过系统通知提醒（notify-send）");
                Switch { checked <=> root.notify-done-on; toggled => { root.changed("notify-done", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                id: "schedule-notify-fail";
                icon-source: AetherIcons.alert;
                title: @tr("下载失败");
                description: @tr("失败时提醒并附错误原因；手动取消不提醒");
                divider: false;
                Switch { checked <=> root.notify-fail-on; toggled => { root.changed("notify-fail", self.checked ? "true" : "false"); } }
            }
        }
    }
}

component AppearancePanel inherits Rectangle {
    in-out property <int> theme-mode: 0;
    // 0 = 简体中文（源语言，无需翻译文件）；1 = English (translations/en)
    in-out property <int> language-index: 0;
    // UI-local preferences, mirrored from the window.
    in-out property <int> accent-index: 0;
    in-out property <bool> motion-on: true;
    in-out property <bool> flow-on: true;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.moon;
            title: @tr("主题");
            id: "appearance-theme";
            subtitle: @tr("Aurora ink 视觉语言");

            SettingRow {
                id: "appearance-language";
                icon-source: AetherIcons.tune;
                title: @tr("界面语言");
                description: @tr("中文为内置源语言；切换立即生效");
                ComboBox {
                    model: ["简体中文", "English", "日本語", "繁體中文"];
                    current-index <=> root.language-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("language", self.current-value); }
                }
            }
            SettingRow {
                id: "appearance-theme-mode";
                icon-source: AetherIcons.moon;
                title: @tr("主题");
                description: @tr("默认跟随系统，也可固定浅色或深色");
                ComboBox {
                    model: [@tr("跟随系统"), @tr("浅色"), @tr("深色")];
                    current-index <=> root.theme-mode;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("theme", self.current-index == 1 ? "浅色" : self.current-index == 2 ? "深色" : "跟随系统"); }
                }
            }
            SettingRow {
                id: "appearance-accent";
                icon-source: AetherIcons.tune;
                title: @tr("主色");
                description: @tr("品牌强调色，按钮、进度与高亮同步换色");
                divider: false;
                ComboBox {
                    model: [@tr("Aurora 紫"), @tr("靛蓝"), @tr("青碧"), @tr("苔绿"), @tr("琥珀"), @tr("蔷薇")];
                    current-index <=> root.accent-index;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("accent", self.current-index == 1 ? "靛蓝" : self.current-index == 2 ? "青碧" : self.current-index == 3 ? "苔绿" : self.current-index == 4 ? "琥珀" : self.current-index == 5 ? "蔷薇" : "Aurora 紫"); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.layers;
            title: @tr("界面");
            id: "appearance-ui";
            subtitle: @tr("背景与动效");

            SettingRow {
                id: "appearance-flow";
                icon-source: AetherIcons.cloud;
                title: @tr("背景流线");
                description: @tr("窗口边缘的低对比度 Aurora 装饰");
                Switch { checked <=> root.flow-on; toggled => { root.changed("flow-background", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                id: "appearance-motion";
                icon-source: AetherIcons.play;
                title: @tr("界面动效");
                description: @tr("关闭后所有过渡立即完成（无障碍）");
                divider: false;
                Switch { checked <=> root.motion-on; toggled => { root.changed("motion", self.checked ? "true" : "false"); } }
            }
        }
    }
}

component AdvancedPanel inherits Rectangle {
    in property <string> plugins-dir: "";
    in property <string> data-dir: "";
    // Daemon-backed remote control (RPC): persisted config plus a live
    // status line. The token is mirrored into a masked field so the random
    // button has something to replace; the daemon generates the first one.
    in property <string> rpc-listen: "";
    in property <string> rpc-status: "";
    in-out property <string> rpc-listen-value: "";
    in-out property <string> rpc-secret-value: "";
    callback changed(string, string);
    callback rpc-apply(string, string);
    callback rpc-clear-secret;
    callback rpc-random-secret;

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        SectionCard {
            icon-source: AetherIcons.note;
            title: @tr("路径");
            id: "advanced-paths";
            subtitle: @tr("daemon 的真实数据位置");

            SettingRow {
                id: "advanced-data-dir";
                icon-source: AetherIcons.drive;
                title: @tr("数据库路径");
                description: @tr("任务、历史与插件元数据");
                divider: false;
                LineEdit {
                    text: root.data-dir == "" ? @tr("未连接") : root.data-dir;
                    read-only: true;
                    show-clear-button: false;
                    min-width: Aether.field-lg;
                    max-width: Aether.field-lg;
                }
            }
            SettingRow {
                id: "advanced-plugins-dir";
                icon-source: AetherIcons.folder;
                title: @tr("插件目录");
                description: @tr("第一方插件的安装位置");
                divider: false;
                LineEdit {
                    text: root.plugins-dir == "" ? @tr("未连接") : root.plugins-dir;
                    read-only: true;
                    show-clear-button: false;
                    min-width: Aether.field-lg;
                    max-width: Aether.field-lg;
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.signal;
            title: @tr("远程控制（RPC）");
            id: "advanced-rpc";
            subtitle: @tr("CLI 与其他设备连接 daemon");

            SettingRow {
                id: "advanced-rpc-listen";
                icon-source: AetherIcons.signal;
                title: @tr("监听地址");
                badge: @tr("重启后生效");
                description: @tr("默认 127.0.0.1:6800；留空关闭；非回环地址必须设置令牌");
                LineEdit {
                    text <=> root.rpc-listen-value;
                    placeholder-text: root.rpc-listen == "" ? @tr("未开启") : root.rpc-listen;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                }
            }
            SettingRow {
                id: "advanced-rpc-secret";
                icon-source: AetherIcons.shield;
                title: @tr("访问令牌");
                description: @tr("默认自动生成；随机按钮换一个；留空表示不使用令牌（仅回环地址）；应用后立即生效");
                HorizontalLayout {
                    spacing: Aether.space-sm;
                    LineEdit {
                        text <=> root.rpc-secret-value;
                        input-type: InputType.password;
                        placeholder-text: @tr("留空表示不使用令牌");
                        min-width: Aether.field-md;
                        max-width: Aether.field-md;
                    }
                    TextButton { text: @tr("随机"); clicked => { root.rpc-random-secret(); } }
                }
            }
            SettingRow {
                id: "advanced-rpc-status";
                icon-source: AetherIcons.info;
                title: @tr("状态");
                description: root.rpc-status;
                divider: false;
                HorizontalLayout {
                    spacing: 8px;
                    TextButton { text: @tr("清除令牌"); clicked => { root.rpc-clear-secret(); } }
                    TextButton { text: @tr("应用"); clicked => { root.rpc-apply(root.rpc-listen-value, root.rpc-secret-value); } }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.alert;
            title: @tr("维护");
            id: "advanced-reset";
            subtitle: @tr("恢复默认外观与偏好");

            SettingRow {
                id: "advanced-reset-prefs";
                icon-source: AetherIcons.alert;
                title: @tr("重置界面偏好");
                description: @tr("恢复外观与完成动作的默认值，不影响 daemon 与任务");
                divider: false;
                TextButton { text: @tr("重置"); clicked => { root.changed("reset-settings", "clicked"); } }
            }
        }
    }
}

component AboutPanel inherits Rectangle {
    in property <string> app-version: "";
    // Live status of the daemon's update check, mirrored from `stats.update`.
    in property <string> update-status: "";
    // Daemon-backed: download a found release in the background.
    in-out property <bool> auto-update-on: true;
    callback changed(string, string);
    callback support-action(string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;


        Rectangle {
            height: Aether.about-hero;
            // Decorative: hidden while a search filter is narrowing the page.
            visible: !SettingsFilter.active;
            border-radius: Aether.card-radius;
            background: @linear-gradient(145deg, Aether.hero-top, Aether.hero-bottom);
            border-width: 1px;
            border-color: Aether.outline-faint;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 14px;

                Image {
                    source: @image-url("../../assets/logo-transparent-128.png");
                    width: 44px;
                    height: 44px;
                    cross-axis-self-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "Aether " + root.app-version;
                        color: Aether.on-surface;
                        font-size: Aether.text-title;
                        font-weight: Aether.weight-medium;
                    }

                    Text {
                        text: @tr("Rust + Slint · Material 3 · 原生桌面，无 WebView");
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-caption;
                    }
                }

                TextButton {
                    text: @tr("检查更新");
                    clicked => { root.support-action("update"); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.refresh;
            title: @tr("更新");
            id: "about-update";
            subtitle: @tr("版本通道与自动更新");

            SettingRow {
                id: "about-update-source";
                icon-source: AetherIcons.signal;
                title: @tr("更新源");
                description: @tr("由 daemon 启动配置决定（--update-url 与更新公钥），界面不可切换");
                divider: false;
            }
            SettingRow {
                id: "about-auto-update";
                icon-source: AetherIcons.refresh;
                title: @tr("自动下载更新");
                description: @tr("在后台准备新版本；关闭后只报告发现新版本，不自动下载");
                divider: false;
                Switch {
                    checked <=> root.auto-update-on;
                    toggled => { root.changed("app-auto-update", self.checked ? "true" : "false"); }
                }
            }
            SettingRow {
                id: "about-changelog";
                icon-source: AetherIcons.info;
                title: @tr("版本说明");
                description: @tr("查看变更、兼容性与已知问题");
                divider: false;
                TextButton { text: @tr("打开"); clicked => { root.support-action("changelog"); } }
            }

            Text {
                text: root.update-status;
                color: Aether.on-surface-muted;
                font-size: Aether.text-caption;
                wrap: word-wrap;
                visible: root.update-status != "";
            }
        }

        SectionCard {
            icon-source: AetherIcons.info;
            title: @tr("支持");
            id: "about-support";
            subtitle: @tr("文档、社区、反馈与许可");

            SettingRow {
                id: "about-docs";
                icon-source: AetherIcons.note;
                title: @tr("文档");
                description: @tr("安装、插件、RPC 与常见问题");
                TextButton { text: @tr("打开"); clicked => { root.support-action("docs"); } }
            }
            SettingRow {
                id: "about-community";
                icon-source: AetherIcons.signal;
                title: @tr("社区");
                description: @tr("讨论、分享配置与插件");
                TextButton { text: @tr("打开"); clicked => { root.support-action("community"); } }
            }
            SettingRow {
                id: "about-feedback";
                icon-source: AetherIcons.alert;
                title: @tr("反馈问题");
                description: @tr("报告 Bug 或提出功能建议");
                TextButton { text: @tr("打开"); clicked => { root.support-action("feedback"); } }
            }
            SettingRow {
                id: "about-license";
                icon-source: AetherIcons.shield;
                title: @tr("许可");
                description: "MIT · Slint Royalty-free / GPL-3.0";
                divider: false;
                TextButton { text: @tr("查看"); clicked => { root.support-action("license"); } }
            }
        }
    }
}

// Section glyph for search hits: same iconography as the category rail.
component SectionGlyph inherits Rectangle {
    in property <int> tab: 0;

    width: Aether.card-icon;
    height: Aether.card-icon;
    border-radius: Aether.radius-sm;
    background: Aether.primary.with-alpha(0.10);

    Image {
        source: root.tab == 0 ? AetherIcons.tune
            : root.tab == 1 ? AetherIcons.download
            : root.tab == 2 ? AetherIcons.signal
            : root.tab == 3 ? AetherIcons.seed
            : root.tab == 4 ? AetherIcons.play
            : root.tab == 5 ? AetherIcons.layers
            : root.tab == 6 ? AetherIcons.clock
            : root.tab == 7 ? AetherIcons.moon
            : root.tab == 8 ? AetherIcons.shield
            : AetherIcons.info;
        width: 14px;
        height: 14px;
        colorize: Aether.primary-bright;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component SearchHitRow inherits Rectangle {
    in property <SettingsHit> hit;
    callback picked;

    height: 54px;
    clip: true;
    background: touch.has-hover ? Aether.on-surface.with-alpha(0.04) : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        SectionGlyph {
            tab: root.hit.tab;
            cross-axis-self-alignment: center;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            // The matched term is rendered as its own Text so it can be
            // highlighted; Slint text has no inline spans.
            HorizontalLayout {
                spacing: 0;
                alignment: start;

                Text {
                    text: root.hit.title-before;
                    color: Aether.on-surface;
                    font-size: Aether.text-body;
                    font-weight: Aether.weight-medium;
                    vertical-alignment: center;
                }

                if root.hit.title-hit != "": Text {
                    text: root.hit.title-hit;
                    color: Aether.primary-bright;
                    font-size: Aether.text-body;
                    font-weight: Aether.weight-semibold;
                    vertical-alignment: center;
                }

                Text {
                    text: root.hit.title-after;
                    color: Aether.on-surface;
                    font-size: Aether.text-body;
                    font-weight: Aether.weight-medium;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 0;
                alignment: start;

                Text {
                    text: root.hit.subtitle-before;
                    color: Aether.on-surface-muted;
                    font-size: Aether.text-caption;
                    vertical-alignment: center;
                }

                if root.hit.subtitle-hit != "": Text {
                    text: root.hit.subtitle-hit;
                    color: Aether.on-surface-variant;
                    font-size: Aether.text-caption;
                    font-weight: Aether.weight-medium;
                    vertical-alignment: center;
                }

                Text {
                    text: root.hit.subtitle-after;
                    color: Aether.on-surface-muted;
                    font-size: Aether.text-caption;
                    vertical-alignment: center;
                }
            }
        }

        Image {
            source: AetherIcons.chevron-right;
            width: 14px;
            height: 14px;
            colorize: Aether.on-surface-muted;
            cross-axis-self-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: 1px;
        background: Aether.outline-variant.with-alpha(0.35);
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.picked(); }
    }
}

component SearchResults inherits Rectangle {
    in property <[SettingsHit]> hits;
    callback picked(int);

    background: transparent;

    VerticalLayout {
        spacing: 10px;

        if root.hits.length == 0: Rectangle {
            height: 132px;
            border-radius: Aether.card-radius;
            background: Aether.surface-container-low;
            border-width: 1px;
            border-color: Aether.outline-faint;

            EmptyHint {
                width: 100%;
                title: @tr("没有匹配的设置");
                hint: @tr("试试「代理」「限速」「插件」这类关键词");
            }
        }

        if root.hits.length > 0: Rectangle {
            border-radius: Aether.card-radius;
            background: @linear-gradient(155deg, Aether.card-top, Aether.card-bottom);
            border-width: 1px;
            border-color: Aether.outline-faint;
            drop-shadow-color: Aether.shadow-card;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 5px;

            VerticalLayout {
                padding: Aether.card-padding;
                spacing: 0;

                for hit in root.hits: VerticalLayout {
                    spacing: 0;

                    // "Network · 2" before the first hit of each section.
                    if hit.heading != "": Rectangle {
                        height: 26px;
                        background: transparent;
                        Text {
                            text: hit.heading;
                            width: 100%;
                            horizontal-alignment: left;
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                            font-weight: Aether.weight-medium;
                            letter-spacing: 0.4px;
                            vertical-alignment: bottom;
                        }
                    }

                    SearchHitRow {
                        hit: hit;
                        picked => { root.picked(hit.tab); }
                    }
                }
            }
        }

        Text {
            text: @tr("输入关键词筛出相关设置；点击结果跳到对应分区并保持筛选。");
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
        }
    }
}

export component SettingsPage inherits Rectangle {
    // Set by the window from `env!("CARGO_PKG_VERSION")`.
    in property <string> app-version: "";
    in property <string> download-dir: "";
    in property <string> plugins-dir: "";
    in property <string> data-dir: "";
    in-out property <int> tab: 0;
    in-out property <int> theme-mode: 0;
    // Daemon-backed network settings (mirrored by the window).
    in-out property <string> network-dns: "";
    in-out property <string> network-user-agent: "";
    in-out property <int> network-ip-mode: 0;
    in-out property <int> network-proxy-mode: 0;
    in-out property <string> network-proxy-url: "";
    in-out property <string> network-headers: "";
    in-out property <bool> network-ftp-passive: true;
    in-out property <string> bt-port: "51413";
    in-out property <bool> bt-dht: true;
    in-out property <float> bt-upload-kbps: 512;
    in-out property <string> bt-blocklist: "";
    in-out property <string> bt-trackers: "";
    // Daemon-backed ffmpeg path (rtmp capture + media remux).
    in-out property <string> media-ffmpeg: "";
    // UI-local preferences (mirrored by the window).
    in-out property <int> start-page: 0;
    // Clipboard link watch (GeneralPanel), mirrored from the window.
    in-out property <bool> clipboard-on: false;
    in-out property <bool> clipboard-available: true;
    // Start-at-login, read from the OS at startup (not a ui.json pref).
    in-out property <bool> autostart-on: false;
    // Daemon-backed: install outdated plugins on the periodic update cycle.
    in-out property <bool> plugin-auto-update: false;
    in-out property <string> plugin-pins: "";
    in-out property <bool> plugin-external-process: true;
    // UI-local: interface language (0 = Chinese source, 1 = English).
    in-out property <int> language-index: 0;
    in-out property <int> after-done: 0;
    in-out property <int> accent-index: 0;
    in-out property <bool> motion-on: true;
    in-out property <bool> flow-on: true;
    in-out property <bool> notify-done: true;
    in-out property <bool> notify-fail: true;
    // Daemon-backed app-update knobs (About panel).
    in-out property <bool> app-auto-update: true;
    in property <string> update-status: "";
    // Daemon-backed RPC config (Advanced panel).
    in property <string> rpc-listen: "";
    in property <string> rpc-status: "";
    in-out property <string> rpc-listen-value: "";
    in-out property <string> rpc-secret-value: "";
    in-out property <bool> schedule-on: false;
    in-out property <string> schedule-start: "";
    in-out property <string> schedule-end: "";
    // Daemon-backed scheduler limits (mirrored by the window).
    in-out property <int> settings-max-tasks: 0;
    in-out property <int> settings-max-connections: 1;
    in-out property <int> settings-retry: 2;
    in-out property <bool> settings-global-limit: true;
    in-out property <float> settings-download-limit-kb: 2048;
    callback settings-changed(string, string);
    callback support-action(string);
    callback rpc-apply(string, string);
    callback rpc-clear-secret;
    callback rpc-random-secret;
    callback plugin-toggled(int, bool);
    callback plugin-remove(int);
    callback plugin-rollback(int);
    callback plugin-action(string);

    // Search: Rust owns the keyword index (`src/settings_search.rs`) and
    // returns the matching cards in `SettingsFilter`; Slint only renders
    // and filters.
    in-out property <string> search-query: "";
    in-out property <bool> search-picked: false;
    callback search-changed(string);

    // The search state lives in a global so every card can read it; clear it
    // when the page is re-created so leaving Settings never leaves a stale
    // filter behind.
    init => {
        SettingsFilter.active = false;
        SettingsFilter.hits = "";
        SettingsFilter.results = [];
    }

    function clear-search() {
        root.search-query = "";
        root.search-picked = false;
        root.search-changed("");
    }

    function pick-section(tab: int) {
        root.tab = tab;
        root.search-picked = true;
    }

    HorizontalLayout {
        padding: Aether.page-padding;
        spacing: Aether.section-gap;

        // ---- category rail ------------------------------------------------
        // A FocusScope so Escape clears the search even while the field has
        // focus (the LineEdit rejects the key, so it bubbles up here).
        FocusScope {
            width: Aether.settings-nav-width;
            height: 100%;

            key-pressed(event) => {
                if (event.text == Key.Escape && root.search-query != "") {
                    root.clear-search();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Aether.card-radius;
                background: Aether.surface-container-low;
                border-width: 1px;
                border-color: Aether.outline-faint;

                VerticalLayout {
                    padding: Aether.card-padding;
                    spacing: 2px;

                    Text {
                        text: @tr("设置中心");
                        color: Aether.on-surface;
                        font-size: Aether.text-heading;
                        font-weight: Aether.weight-semibold;
                    }

                    Rectangle { height: 6px; background: transparent; }

                    LineEdit {
                        text <=> root.search-query;
                        placeholder-text: @tr("搜索设置");
                        horizontal-stretch: 1;
                        edited(text) => {
                            root.search-picked = false;
                            root.search-changed(text);
                        }
                        // Enter opens the first hit; the clear button (or editing)
                        // returns to the full page.
                        accepted => {
                            if (SettingsFilter.results.length > 0) {
                                root.pick-section(SettingsFilter.results[0].tab);
                            }
                        }
                    }

                    Rectangle { height: 6px; background: transparent; }

                    // The list scrolls only on the smallest allowed window
                    // (900x560); the version stays pinned at the bottom.
                    ScrollView {
                        vertical-stretch: 1;
                        // Without these the scroll view reports its content
                        // height and pushes the pinned version out of the card.
                        min-height: 0px;
                        preferred-height: 0px;

                        VerticalLayout {
                            width: 100%;
                            spacing: 1px;

                            NavGroupLabel { text: @tr("常用"); }
                            SettingsNav { icon-source: AetherIcons.tune; text: @tr("常规"); active: root.tab == 0; clicked => { root.tab = 0; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.download; text: @tr("下载"); active: root.tab == 1; clicked => { root.tab = 1; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.signal; text: @tr("网络"); active: root.tab == 2; clicked => { root.tab = 2; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.seed; text: "BT / PT"; active: root.tab == 3; clicked => { root.tab = 3; root.clear-search(); } }

                            NavGroupLabel { text: @tr("应用"); }
                            SettingsNav { icon-source: AetherIcons.play; text: @tr("媒体与浏览器"); active: root.tab == 4; clicked => { root.tab = 4; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.layers; text: @tr("插件"); active: root.tab == 5; clicked => { root.tab = 5; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.clock; text: @tr("计划与通知"); active: root.tab == 6; clicked => { root.tab = 6; root.clear-search(); } }

                            NavGroupLabel { text: @tr("系统"); }
                            SettingsNav { icon-source: AetherIcons.moon; text: @tr("外观"); active: root.tab == 7; clicked => { root.tab = 7; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.shield; text: @tr("高级"); active: root.tab == 8; clicked => { root.tab = 8; root.clear-search(); } }
                            SettingsNav { icon-source: AetherIcons.info; text: @tr("关于与支持"); active: root.tab == 9; clicked => { root.tab = 9; root.clear-search(); } }
                        }
                    }

                    Rectangle { height: 4px; background: transparent; }

                    Text {
                        text: "Aether " + root.app-version;
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-micro;
                        horizontal-alignment: center;
                    }
                }
                }
        }

        // ---- sticky header + scrollable body ------------------------------
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            PanelHeader {
                icon-source: root.search-query != "" && !root.search-picked
                    ? AetherIcons.search
                    : root.tab == 0 ? AetherIcons.tune
                    : root.tab == 1 ? AetherIcons.download
                    : root.tab == 2 ? AetherIcons.signal
                    : root.tab == 3 ? AetherIcons.seed
                    : root.tab == 4 ? AetherIcons.play
                    : root.tab == 5 ? AetherIcons.layers
                    : root.tab == 6 ? AetherIcons.clock
                    : root.tab == 7 ? AetherIcons.moon
                    : root.tab == 8 ? AetherIcons.shield
                    : AetherIcons.info;

                title: root.search-query != "" && !root.search-picked
                    ? @tr("搜索结果")
                    : root.tab == 0 ? @tr("常规")
                    : root.tab == 1 ? @tr("下载")
                    : root.tab == 2 ? @tr("网络")
                    : root.tab == 3 ? "BT / PT"
                    : root.tab == 4 ? @tr("媒体与浏览器")
                    : root.tab == 5 ? @tr("插件")
                    : root.tab == 6 ? @tr("计划与通知")
                    : root.tab == 7 ? @tr("外观")
                    : root.tab == 8 ? @tr("高级")
                    : @tr("关于与支持");

                subtitle: root.search-query != "" && !root.search-picked
                    ? SettingsFilter.results.length + @tr(" 个匹配 · 标题、说明或术语")
                    : root.tab == 0 ? @tr("启动与存储")
                    : root.tab == 1 ? @tr("并发、分段、限速与磁盘策略")
                    : root.tab == 2 ? @tr("代理、DNS、协议与请求头")
                    : root.tab == 3 ? @tr("端口、节点发现与做种")
                    : root.tab == 4 ? @tr("当前能力与边界")
                    : root.tab == 5 ? PluginCatalog.total + @tr(" 个已安装 · ") + PluginCatalog.active + @tr(" 个已启用 · ") + PluginCatalog.updates + @tr(" 个可更新")
                    : root.tab == 6 ? @tr("定时任务与桌面提醒")
                    : root.tab == 7 ? @tr("主题、主色与动效")
                    : root.tab == 8 ? @tr("路径与维护")
                    : @tr("版本、更新、文档与社群");

                tone: root.tab == 1 ? Aether.live
                    : root.tab == 2 ? Aether.info
                    : root.tab == 4 ? Aether.warning
                    : root.tab == 5 ? Aether.info
                    : root.tab == 6 ? Aether.live
                    : root.tab == 8 ? Aether.error
                    : Aether.primary-bright;

                // Filter chip while a picked section is narrowed down.
                if root.search-query != "" && root.search-picked: HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    StatusChip { text: @tr("筛选"); tone: Aether.primary-bright; }
                    Text {
                        text: root.search-query;
                        color: Aether.on-surface-variant;
                        font-size: Aether.text-caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TextButton {
                        text: @tr("清除");
                        clicked => { root.clear-search(); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Aether.outline-variant.with-alpha(0.5);
            }

            if root.search-query != "" && !root.search-picked: SearchResults {
                hits: SettingsFilter.results;
                picked(tab) => { root.pick-section(tab); }
            }

            if root.search-query == "" || root.search-picked: ScrollView {
                VerticalLayout {
                    padding-right: 8px;
                    padding-bottom: Aether.page-padding;
                    spacing: Aether.section-gap;

                    if root.tab == 0: GeneralPanel {
                        download-dir: root.download-dir;
                        start-page-index <=> root.start-page;
                        clipboard-on <=> root.clipboard-on;
                        clipboard-available <=> root.clipboard-available;
                        autostart-on <=> root.autostart-on;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 1: DownloadPanel {
                        after-done-index <=> root.after-done;
                        max-tasks-index <=> root.settings-max-tasks;
                        max-connections-index <=> root.settings-max-connections;
                        retry-index <=> root.settings-retry;
                        global-limit-on <=> root.settings-global-limit;
                        download-limit-kb <=> root.settings-download-limit-kb;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 2: NetworkPanel {
                        app-version: root.app-version;
                        dns-value <=> root.network-dns;
                        user-agent-value <=> root.network-user-agent;
                        ip-mode-index <=> root.network-ip-mode;
                        proxy-mode-index <=> root.network-proxy-mode;
                        proxy-url-value <=> root.network-proxy-url;
                        headers-value <=> root.network-headers;
                        ftp-passive-on <=> root.network-ftp-passive;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 3: BtPanel {
                        bt-port-value <=> root.bt-port;
                        bt-dht-on <=> root.bt-dht;
                        bt-upload-kbps <=> root.bt-upload-kbps;
                        bt-blocklist-value <=> root.bt-blocklist;
                        bt-trackers-value <=> root.bt-trackers;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 4: MediaPanel {
                        ffmpeg-value <=> root.media-ffmpeg;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 5: PluginPanel {
                        plugins-dir: root.plugins-dir;
                        auto-update-on <=> root.plugin-auto-update;
                        plugin-pins <=> root.plugin-pins;
                        external-process-on <=> root.plugin-external-process;
                        changed(k, v) => { root.settings-changed(k, v); }
                        plugin-toggled(id, enabled) => { root.plugin-toggled(id, enabled); }
                        plugin-remove(id) => { root.plugin-remove(id); }
                        plugin-rollback(id) => { root.plugin-rollback(id); }
                        plugin-action(action) => { root.plugin-action(action); }
                    }
                    if root.tab == 6: SchedulePanel {
                        notify-done-on <=> root.notify-done;
                        notify-fail-on <=> root.notify-fail;
                        schedule-on <=> root.schedule-on;
                        schedule-start <=> root.schedule-start;
                        schedule-end <=> root.schedule-end;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 7: AppearancePanel {
                        language-index <=> root.language-index;
                        theme-mode <=> root.theme-mode;
                        accent-index <=> root.accent-index;
                        motion-on <=> root.motion-on;
                        flow-on <=> root.flow-on;
                        changed(k, v) => { root.settings-changed(k, v); }
                    }
                    if root.tab == 8: AdvancedPanel {
                        plugins-dir: root.plugins-dir;
                        data-dir: root.data-dir;
                        rpc-listen: root.rpc-listen;
                        rpc-status: root.rpc-status;
                        rpc-listen-value <=> root.rpc-listen-value;
                        rpc-secret-value <=> root.rpc-secret-value;
                        changed(k, v) => { root.settings-changed(k, v); }
                        rpc-apply(l, s) => { root.rpc-apply(l, s); }
                        rpc-clear-secret => { root.rpc-clear-secret(); }
                        rpc-random-secret => { root.rpc-random-secret(); }
                    }
                    if root.tab == 9: AboutPanel {
                        app-version: root.app-version;
                        update-status: root.update-status;
                        auto-update-on <=> root.app-auto-update;
                        changed(k, v) => { root.settings-changed(k, v); }
                        support-action(k) => { root.support-action(k); }
                    }
                }
            }
        }
    }
}
