                ComboBox {
                    model: ["MP4", "MKV", "保持原格式"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("media-format", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.drive;
                title: "ffmpeg 路径";
                description: "合并、转码与音频提取依赖";
                LineEdit {
                    text: "/usr/bin/ffmpeg";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("ffmpeg", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.note;
                title: "下载后自动转码";
                description: "按目标编码重新封装";
                divider: false;
                Switch { checked: false; toggled => { root.changed("media-transcode", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.link;
            title: "浏览器集成";
            subtitle: "接管浏览器下载与右键菜单";

            SettingRow {
                icon-source: AetherIcons.link;
                title: "浏览器扩展";
                description: "把浏览器下载转交给 Aether";
                Switch { checked: true; toggled => { root.changed("browser-extension", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.download;
                title: "接管浏览器下载";
                description: "拦截浏览器默认下载行为";
                Switch { checked: true; toggled => { root.changed("browser-intercept", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.note;
                title: "剪贴板监听";
                description: "复制链接时提示新建任务";
                Switch { checked: true; toggled => { root.changed("clipboard-watch", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.list;
                title: "右键菜单";
                description: "在链接上显示「使用 Aether 下载」";
                Switch { checked: true; toggled => { root.changed("context-menu", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "本地通信端口";
                description: "扩展与桌面端通信使用";
                LineEdit {
                    text: "16800";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("extension-port", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.link;
                title: "获取浏览器扩展";
                description: "Chrome / Edge / Firefox";
                divider: false;
                TextButton {
                    text: "打开扩展页面";
                    clicked => { root.changed("get-extension", "clicked"); }
                }
            }
        }
    }
}

component PluginFilter inherits Rectangle {
    in property <string> text: "";
    in property <int> count: 0;
    in property <bool> selected: false;
    callback clicked;

    height: 28px;
    border-radius: Aether.radius-full;
    border-width: 1px;
    border-color: root.selected ? Aether.primary.with-alpha(0.32) : Aether.outline-faint;
    background: root.selected ? Aether.primary-soft
        : touch.has-hover ? Aether.on-surface.with-alpha(0.05)
        : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        Text {
            text: root.text;
            color: root.selected ? Aether.primary-bright : Aether.on-surface-variant;
            font-size: Aether.text-caption;
            vertical-alignment: center;
        }

        Text {
            text: "" + root.count;
            color: root.selected ? Aether.primary-bright : Aether.on-surface-muted;
            font-size: Aether.text-micro;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component InstalledPlugin inherits Rectangle {
    in property <PluginRow> plugin;
    callback toggled(int, bool);

    height: Aether.plugin-row;

    HorizontalLayout {
        spacing: Aether.space-sm;

        Rectangle {
            width: Aether.card-icon;
            height: Aether.card-icon;
            background: transparent;
            cross-axis-self-alignment: center;

            PluginGlyph {
                icon: root.plugin.icon;
                tone: root.plugin.tone;
                width: Aether.card-icon;
                height: Aether.card-icon;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.plugin.name;
                color: Aether.on-surface;
                font-size: Aether.text-body;
                font-weight: Aether.weight-medium;
            }

            Text {
                text: root.plugin.description;
                color: Aether.on-surface-muted;
                font-size: Aether.text-caption;
                overflow: elide;
            }

            Text {
                text: "v" + root.plugin.version + "  ·  " + root.plugin.category
                    + "  ·  " + (root.plugin.kind == 0 ? "内置" : "社区");
                color: Aether.on-surface-muted;
                font-size: Aether.text-micro;
            }
        }

        if root.plugin.update: Rectangle {
            height: 20px;
            border-radius: 10px;
            background: Aether.warning.with-alpha(0.10);
            border-width: 1px;
            border-color: Aether.warning.with-alpha(0.20);
            cross-axis-self-alignment: center;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;

                Text {
                    text: "可更新";
                    color: Aether.warning;
                    font-size: Aether.text-micro;
                    font-weight: Aether.weight-medium;
                    vertical-alignment: center;
                    cross-axis-self-alignment: center;
                }
            }
        }

        Switch {
            checked: root.plugin.enabled;
            cross-axis-self-alignment: center;
            toggled => { root.toggled(root.plugin.id, self.checked); }
        }
    }
}

component PluginPanel inherits Rectangle {
    in-out property <int> plugin-filter: 0;
    in property <string> plugins-dir: "";
    callback changed(string, string);
    callback plugin-toggled(int, bool);
    callback plugin-action(string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader {
            icon-source: AetherIcons.layers;
            title: "插件";
            subtitle: PluginCatalog.total + " 个已安装 · " + PluginCatalog.active + " 个运行中 · " + PluginCatalog.updates + " 个可更新";
            tone: Aether.info;
        }

        SectionCard {
            icon-source: AetherIcons.list;
            title: "插件库";
            subtitle: PluginCatalog.builtin + " 个内置 · " + PluginCatalog.community + " 个社区 · 独立进程运行";

            HorizontalLayout {
                height: Aether.control-md;
                spacing: 6px;
                cross-axis-alignment: center;

                PluginFilter { text: "全部"; count: PluginCatalog.total; selected: root.plugin-filter == 0; clicked => { root.plugin-filter = 0; } }
                PluginFilter { text: "内置"; count: PluginCatalog.builtin; selected: root.plugin-filter == 1; clicked => { root.plugin-filter = 1; } }
                PluginFilter { text: "已启用"; count: PluginCatalog.active; selected: root.plugin-filter == 2; clicked => { root.plugin-filter = 2; } }
                PluginFilter { text: "可更新"; count: PluginCatalog.updates; selected: root.plugin-filter == 3; clicked => { root.plugin-filter = 3; } }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                TextButton {
                    text: "更新全部";
                    clicked => { root.plugin-action("update-all"); }
                }
            }

            for plugin in PluginCatalog.all: InstalledPlugin {
                plugin: plugin;
                visible: root.plugin-filter == 0
                    || (root.plugin-filter == 1 && plugin.kind == 0)
                    || (root.plugin-filter == 2 && plugin.enabled)
                    || (root.plugin-filter == 3 && plugin.update);
                toggled(id, enabled) => { root.plugin-toggled(id, enabled); }
            }
        }

        SectionCard {
            icon-source: AetherIcons.layers;
            title: "插件引擎";
            subtitle: "插件目录、来源与更新";

            SettingRow {
                icon-source: AetherIcons.refresh;
                title: "自动更新插件";
                description: "启动时检查插件新版本";
                Switch { checked: true; toggled => { root.changed("plugin-auto-update", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.shield;
                title: "允许外部插件";
                description: "加载插件目录之外的扩展";
                Switch { checked: false; toggled => { root.changed("plugin-external", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.folder;
                title: "插件目录";
                description: "本地插件的安装位置";
                Text {
                    text: root.plugins-dir == "" ? "未连接" : root.plugins-dir;
                    color: Aether.on-surface-variant;
                    font-size: Aether.text-caption;
                    font-family: "JetBrains Mono";
                    vertical-alignment: center;
                }
            }
            SettingRow {
                icon-source: AetherIcons.download;
                title: "安装插件";
                description: "从文件或 URL 安装";
                divider: false;
                TextButton {
                    text: "选择插件文件";
                    clicked => { root.plugin-action("install"); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.note;
            title: "开发";
            subtitle: "调试与重新加载";

            SettingRow {
                icon-source: AetherIcons.tune;
                title: "开发者模式";
                description: "显示插件日志和调试入口";
                Switch { checked: false; toggled => { root.changed("plugin-dev", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.refresh;
                title: "重新加载插件";
                description: "不重启应用刷新本地插件";
                divider: false;
                TextButton {
                    text: "重新加载";
                    clicked => { root.plugin-action("reload"); }
                }
            }
        }
    }
}

component SchedulePanel inherits Rectangle {
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.clock; title: "计划与通知"; subtitle: "定时任务、提醒与勿扰"; tone: Aether.live; }

        SectionCard {
            icon-source: AetherIcons.clock;
            title: "计划任务";
            subtitle: "夜间下载、限速与电源";

            SettingRow {
                icon-source: AetherIcons.clock;
                title: "启用计划下载";
                description: "在指定时段自动运行队列";
                Switch { checked: false; toggled => { root.changed("schedule-on", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.play;
                title: "开始时间";
                description: "每天自动开始下载";
                LineEdit {
                    text: "01:00";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("schedule-start", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.pause;
                title: "结束时间";
                description: "到点后暂停队列";
                LineEdit {
                    text: "07:00";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("schedule-end", self.text); }
                }
            }
            ValueSlider {
                icon-source: AetherIcons.gauge;
                label: "计划限速";
                value: 1024;
                minimum: 0;
                maximum: 8192;
                suffix: " KB/s";
                changed(v) => { root.changed("schedule-limit", v); }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "完成后关机";
                description: "队列清空后关闭计算机";
                Switch { checked: false; toggled => { root.changed("shutdown-after", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.alert;
                title: "低电量暂停";
                description: "笔记本电量低于 20% 时暂停";
                divider: false;
                Switch { checked: true; toggled => { root.changed("low-battery-pause", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.info;
            title: "通知";
            subtitle: "完成、失败与勿扰时段";

            SettingRow {
                icon-source: AetherIcons.info;
                title: "桌面通知";
                description: "使用系统通知中心提醒";
                Switch { checked: true; toggled => { root.changed("notify-desktop", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.check;
                title: "下载完成";
                description: "任务完成时提醒";
                Switch { checked: true; toggled => { root.changed("notify-done", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.alert;
                title: "下载失败";
                description: "任务失败或校验错误时提醒";
                Switch { checked: true; toggled => { root.changed("notify-fail", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.play;
                title: "开始下载";
                description: "新任务开始时提醒";
                Switch { checked: false; toggled => { root.changed("notify-start", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "通知方式";
                description: "桌面通知、应用内或仅声音";
                ComboBox {
                    model: ["系统通知", "应用内提示", "仅声音"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("notify-style", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.note;
                title: "提示音";
                description: "任务完成时播放轻提示音";
                Switch { checked: false; toggled => { root.changed("notify-sound", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.moon;
                title: "勿扰时段";
                description: "该时段内不弹出通知";
                divider: false;
                LineEdit {
                    text: "22:00 - 08:00";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("dnd", self.text); }
                }
            }
        }
    }
}

component AppearancePanel inherits Rectangle {
    in-out property <int> theme-mode: 0;
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

