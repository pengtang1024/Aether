                description: "识别网页中的 HLS / DASH / MP4";
                Switch { checked: true; toggled => { root.changed("media-sniff", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.layers;
                title: "自动合并音视频";
                description: "分离的音轨和视频轨合并为一个文件";
                Switch { checked: true; toggled => { root.changed("media-merge", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.layers;
                title: "合并格式";
