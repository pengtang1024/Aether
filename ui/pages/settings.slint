            SettingRow {
                icon-source: AetherIcons.list;
                title: "紧凑列表";
                description: "减少列表行距以显示更多任务";
                divider: false;
                Switch { checked: false; toggled => { root.changed("compact-list", self.checked ? "true" : "false"); } }
            }
        }
    }
