                }
            }
            SettingRow {
                icon-source: AetherIcons.cloud;
                title: "允许远程访问";
                description: "允许局域网设备连接 RPC";
                divider: false;
                Switch { checked: false; toggled => { root.changed("rpc-remote", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.note;
            title: "调试与维护";
            subtitle: "日志、数据库与诊断";

            SettingRow {
                icon-source: AetherIcons.note;
                title: "日志级别";
                description: "调试会写入更多传输细节";
                ComboBox {
                    model: ["错误", "警告", "信息", "调试"];
                    current-index: 2;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("log-level", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.drive;
                title: "数据库路径";
                description: "任务、历史与插件元数据";
                Text {
                    text: root.data-dir == "" ? "未连接" : root.data-dir;
                    color: Aether.on-surface-variant;
                    font-size: Aether.text-caption;
                    font-family: "JetBrains Mono";
                    vertical-alignment: center;
                }
            }
            SettingRow {
                icon-source: AetherIcons.trash;
                title: "清理缓存";
                description: "删除缩略图、临时分片与旧日志";
                TextButton { text: "清理"; clicked => { root.changed("clear-cache", "clicked"); } }
            }
            SettingRow {
                icon-source: AetherIcons.info;
                title: "导出诊断信息";
                description: "生成可分享的日志包";
                TextButton { text: "导出"; clicked => { root.changed("diagnostics", "clicked"); } }
            }
            SettingRow {
                icon-source: AetherIcons.alert;
                title: "重置所有设置";
                description: "恢复默认值，不删除任务";
                divider: false;
                TextButton { text: "重置"; clicked => { root.changed("reset-settings", "clicked"); } }
            }
        }
    }
}

component AboutPanel inherits Rectangle {
    in property <string> app-version: "";
    callback support-action(string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.info; title: "关于与支持"; subtitle: "版本、更新、文档与社群"; tone: Aether.primary-bright; }

        Rectangle {
            height: Aether.about-hero;
            border-radius: Aether.card-radius;
            background: @linear-gradient(145deg, Aether.hero-top, Aether.hero-bottom);
            border-width: 1px;
            border-color: Aether.outline-faint;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 14px;

                Image {
                    source: @image-url("../../assets/logo-transparent-128.png");
                    width: 44px;
                    height: 44px;
                    cross-axis-self-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "Aether " + root.app-version;
                        color: Aether.on-surface;
                        font-size: Aether.text-title;
                        font-weight: Aether.weight-medium;
                    }

                    Text {
                        text: "Rust + Slint · Material 3 · 原生桌面，无 WebView";
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-caption;
                    }
                }

                TextButton {
                    text: "检查更新";
                    clicked => { root.support-action("update"); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.refresh;
            title: "更新";
            subtitle: "版本通道与自动更新";

            SettingRow {
                icon-source: AetherIcons.signal;
                title: "更新通道";
                description: "稳定版优先，测试版获取新能力";
                ComboBox {
                    model: ["稳定版", "测试版"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.support-action("channel"); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.refresh;
                title: "自动下载更新";
                description: "在后台准备新版本";
                Switch { checked: true; toggled => { root.support-action("auto-update"); } }
            }
            SettingRow {
                icon-source: AetherIcons.info;
                title: "版本说明";
                description: "查看变更、兼容性与已知问题";
                divider: false;
                TextButton { text: "打开"; clicked => { root.support-action("changelog"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.info;
            title: "支持";
            subtitle: "文档、社区、反馈与许可";

            SettingRow {
                icon-source: AetherIcons.note;
                title: "文档";
                description: "安装、插件、RPC 与常见问题";
                TextButton { text: "打开"; clicked => { root.support-action("docs"); } }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "社区";
                description: "讨论、分享配置与插件";
                TextButton { text: "打开"; clicked => { root.support-action("community"); } }
            }
            SettingRow {
                icon-source: AetherIcons.alert;
                title: "反馈问题";
                description: "报告 Bug 或提出功能建议";
                TextButton { text: "打开"; clicked => { root.support-action("feedback"); } }
            }
            SettingRow {
                icon-source: AetherIcons.shield;
                title: "许可";
                description: "MIT · Slint Royalty-free / GPL-3.0";
                divider: false;
                TextButton { text: "查看"; clicked => { root.support-action("license"); } }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    // Set by the window from `env!("CARGO_PKG_VERSION")`.
    in property <string> app-version: "";
    in property <string> download-dir: "";
    in property <string> plugins-dir: "";
    in property <string> data-dir: "";
    in-out property <int> tab: 0;
    in-out property <int> theme-mode: 0;
    callback settings-changed(string, string);
    callback support-action(string);
    callback plugin-toggled(int, bool);
    callback plugin-action(string);

    HorizontalLayout {
        padding: Aether.page-padding;
        spacing: Aether.section-gap;

        // ---- local category navigation ------------------------------
        Rectangle {
            width: Aether.settings-nav-width;
            border-radius: Aether.card-radius;
            background: Aether.surface-container-low;
            border-width: 1px;
            border-color: Aether.outline-faint;

            VerticalLayout {
                padding: Aether.card-padding;
                spacing: 2px;

                Text {
                    text: "设置中心";
                    color: Aether.on-surface;
                    font-size: Aether.text-heading;
                    font-weight: Aether.weight-semibold;
                }

                Text {
                    text: "偏好、网络与扩展";
                    color: Aether.on-surface-muted;
                    font-size: Aether.text-micro;
                }

                Rectangle { height: Aether.space-sm; background: transparent; }

                SettingsNav { icon-source: AetherIcons.tune; text: "常规"; active: root.tab == 0; clicked => { root.tab = 0; } }
                SettingsNav { icon-source: AetherIcons.download; text: "下载"; active: root.tab == 1; clicked => { root.tab = 1; } }
                SettingsNav { icon-source: AetherIcons.signal; text: "网络"; active: root.tab == 2; clicked => { root.tab = 2; } }
                SettingsNav { icon-source: AetherIcons.seed; text: "BT / PT"; active: root.tab == 3; clicked => { root.tab = 3; } }
                SettingsNav { icon-source: AetherIcons.play; text: "媒体与浏览器"; active: root.tab == 4; clicked => { root.tab = 4; } }
                SettingsNav { icon-source: AetherIcons.layers; text: "插件"; active: root.tab == 5; clicked => { root.tab = 5; } }
                SettingsNav { icon-source: AetherIcons.clock; text: "计划与通知"; active: root.tab == 6; clicked => { root.tab = 6; } }
                SettingsNav { icon-source: AetherIcons.moon; text: "外观"; active: root.tab == 7; clicked => { root.tab = 7; } }
                SettingsNav { icon-source: AetherIcons.shield; text: "高级"; active: root.tab == 8; clicked => { root.tab = 8; } }
                SettingsNav { icon-source: AetherIcons.info; text: "关于与支持"; active: root.tab == 9; clicked => { root.tab = 9; } }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Text {
                    text: "Aether " + root.app-version;
                    color: Aether.on-surface-muted;
                    font-size: Aether.text-micro;
                    horizontal-alignment: center;
                }
            }
        }

        // ---- panel ---------------------------------------------------
        ScrollView {
            VerticalLayout {
                padding-bottom: Aether.page-padding;
                spacing: Aether.section-gap;

                if root.tab == 0: GeneralPanel {
                    download-dir: root.download-dir;
                    changed(k, v) => { root.settings-changed(k, v); }
                }
                if root.tab == 1: DownloadPanel { changed(k, v) => { root.settings-changed(k, v); } }
                if root.tab == 2: NetworkPanel {
                    app-version: root.app-version;
                    changed(k, v) => { root.settings-changed(k, v); }
                }
                if root.tab == 3: BtPanel { changed(k, v) => { root.settings-changed(k, v); } }
                if root.tab == 4: MediaPanel { changed(k, v) => { root.settings-changed(k, v); } }
                if root.tab == 5: PluginPanel {
                    plugins-dir: root.plugins-dir;
                    changed(k, v) => { root.settings-changed(k, v); }
                    plugin-toggled(id, enabled) => { root.plugin-toggled(id, enabled); }
                    plugin-action(action) => { root.plugin-action(action); }
                }
                if root.tab == 6: SchedulePanel { changed(k, v) => { root.settings-changed(k, v); } }
                if root.tab == 7: AppearancePanel { theme-mode <=> root.theme-mode; changed(k, v) => { root.settings-changed(k, v); } }
                if root.tab == 8: AdvancedPanel {
                    plugins-dir: root.plugins-dir;
                    data-dir: root.data-dir; changed(k, v) => { root.settings-changed(k, v); } }
                if root.tab == 9: AboutPanel {
                    app-version: root.app-version;
                    support-action(k) => { root.support-action(k); }
                }
            }
        }
    }
}
