// Aether — settings centre.
//
// A local, scrollable category navigation on the left and one large settings
// panel on the right. The three global destinations stay in the app bar.

import { ScrollView, Switch, Slider, ComboBox, LineEdit, TextButton } from "std-widgets.slint";
import { Aether } from "theme.slint";
import { AetherIcons } from "icons.slint";
import { PluginGlyph, SectionCard, SettingRow } from "widgets.slint";
import { PluginRow } from "model.slint";
import { PluginCatalog } from "plugins.slint";

component ValueSlider inherits Rectangle {
    in property <image> icon-source;
    in property <string> label: "";
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <string> suffix: "";
    in property <bool> divider: true;
    in-out property <float> slider-value <=> inner.value;
    callback changed(float);

    height: Aether.row-comfortable;

    HorizontalLayout {
        spacing: Aether.space-sm;

        Rectangle {
            width: Aether.card-icon;
            height: Aether.card-icon;
            background: transparent;
            cross-axis-self-alignment: center;

            Image {
                source: root.icon-source;
                width: Aether.icon-md;
                height: Aether.icon-md;
                colorize: Aether.on-surface-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            color: Aether.on-surface-variant;
            font-size: Aether.text-body;
            width: Aether.slider-label-w;
            vertical-alignment: center;
            overflow: elide;
        }

        inner := Slider {
            horizontal-stretch: 1;
            value: root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            changed => { root.slider-value = self.value; root.changed(self.value); }
        }

        Rectangle {
            height: Aether.value-chip-h;
            width: Aether.value-chip-w;
            border-radius: Aether.radius-sm;
            background: Aether.surface-container-highest;
            border-width: 1px;
            border-color: Aether.outline-faint;
            cross-axis-self-alignment: center;

            Text {
                text: root.slider-value + root.suffix;
                color: Aether.on-surface;
                font-size: Aether.text-caption;
                font-weight: Aether.weight-medium;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.divider: Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: 1px;
        background: Aether.outline-variant.with-alpha(0.45);
    }
}

component SettingsNav inherits Rectangle {
    in property <image> icon-source;
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked;

    height: Aether.control-sm;
    border-radius: Aether.radius-sm;
    background: root.active ? Aether.primary-soft
        : touch.has-hover ? Aether.on-surface.with-alpha(0.04)
        : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        Image {
            source: root.icon-source;
            width: Aether.icon-md;
            height: Aether.icon-md;
            colorize: root.active ? Aether.primary-bright : Aether.on-surface-muted;
            cross-axis-self-alignment: center;
        }

        Text {
            text: root.text;
            color: root.active ? Aether.primary-bright : Aether.on-surface-variant;
            font-size: Aether.text-label;
            font-weight: root.active ? Aether.weight-medium : Aether.weight-regular;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component PanelHeader inherits Rectangle {
    in property <image> icon-source;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <color> tone: Aether.primary-bright;

    height: Aether.panel-header;

    HorizontalLayout {
        spacing: 12px;

        Rectangle {
            width: Aether.control-sm;
            height: Aether.control-sm;
            border-radius: Aether.radius-md;
            background: root.tone.with-alpha(0.14);
            border-width: 1px;
            border-color: root.tone.with-alpha(0.24);
            cross-axis-self-alignment: center;

            Image {
                source: root.icon-source;
                width: Aether.icon-lg;
                height: Aether.icon-lg;
                colorize: root.tone;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.title;
                color: Aether.on-surface;
                font-size: Aether.text-headline;
                font-weight: Aether.weight-semibold;
                letter-spacing: -0.2px;
            }

            Text {
                text: root.subtitle;
                color: Aether.on-surface-muted;
                font-size: Aether.text-caption;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Panels. Each panel is a vertical stack of grouped M3 cards.
// ---------------------------------------------------------------------------
component GeneralPanel inherits Rectangle {
    // Real paths from the daemon (read-only: set at daemon start).
    in property <string> download-dir: "";
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.tune; title: "常规"; subtitle: "启动、存储、语言与更新"; tone: Aether.primary-bright; }

        SectionCard {
            icon-source: AetherIcons.info;
            title: "启动与窗口";
            subtitle: "启动位置、托盘与关闭行为";

            SettingRow {
                icon-source: AetherIcons.clock;
                title: "启动时最小化到托盘";
                description: "登录系统后静默启动，不打断当前工作";
                Switch { checked: true; toggled => { root.changed("tray-on-start", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.close;
                title: "关闭窗口后继续下载";
                description: "退出窗口时保留后台传输";
                Switch { checked: true; toggled => { root.changed("close-to-tray", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.home;
                title: "启动页面";
                description: "每次打开 Aether 时显示的页面";
                divider: false;
                ComboBox {
                    model: ["主页", "下载列表", "上次页面"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("start-page", self.current-value); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.folder;
            title: "存储";
            subtitle: "下载目录、临时文件与命名";

            SettingRow {
                icon-source: AetherIcons.folder;
                title: "默认下载目录";
                description: "daemon 启动参数决定，新任务默认保存到这里";
                Text {
                    text: root.download-dir == "" ? "未连接" : root.download-dir;
                    color: Aether.on-surface-variant;
                    font-size: Aether.text-caption;
                    font-family: "JetBrains Mono";
                    vertical-alignment: center;
                }
            }
            SettingRow {
                icon-source: AetherIcons.layers;
                title: "文件冲突策略";
                description: "目标文件已存在时的处理方式";
                ComboBox {
                    model: ["自动重命名", "覆盖已有文件", "跳过"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("file-conflict", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.check;
                title: "完成后自动分类";
                description: "按视频、音频、文档等类型归档";
                divider: false;
                Switch { checked: true; toggled => { root.changed("auto-category", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.refresh;
            title: "语言与更新";
            subtitle: "界面语言与版本通道";

            SettingRow {
                icon-source: AetherIcons.info;
                title: "界面语言";
                description: "切换后立即生效";
                ComboBox {
                    model: ["简体中文", "English", "跟随系统"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("language", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.refresh;
                title: "自动检查更新";
                description: "每 24 小时检查一次版本";
                Switch { checked: true; toggled => { root.changed("auto-update", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "更新通道";
                description: "稳定版优先，测试版获取新能力";
                divider: false;
                ComboBox {
                    model: ["稳定版", "测试版"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("update-channel", self.current-value); }
                }
            }
        }
    }
}

component DownloadPanel inherits Rectangle {
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.download; title: "下载"; subtitle: "并发、分段、限速与磁盘策略"; tone: Aether.live; }

        SectionCard {
            icon-source: AetherIcons.split;
            title: "并发与分段";
            subtitle: "决定下载速度和服务器压力";

            SettingRow {
                icon-source: AetherIcons.layers;
                title: "同时进行的下载数";
                description: "超出后任务进入等待队列";
                ComboBox {
                    model: ["3", "5", "10", "16"];
                    current-index: 1;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("max-tasks", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "每任务连接数";
                description: "单个任务同时使用的连接数量";
                ComboBox {
                    model: ["8", "16", "32", "64"];
                    current-index: 2;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("max-connections", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.split;
                title: "默认分段数";
                description: "文件被切成多少块并行下载";
                ComboBox {
                    model: ["自动", "4", "8", "16", "32"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("segments", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.layers;
                title: "动态分段";
                description: "根据服务器响应自动增减压测连接";
                Switch { checked: true; toggled => { root.changed("dynamic-segments", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.refresh;
                title: "失败重试次数";
                description: "网络抖动或超时后自动重试";
                ComboBox {
                    model: ["3", "5", "10", "无限"];
                    current-index: 1;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("retry-count", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.clock;
                title: "连接超时";
                description: "超过该时间无响应则重新连接";
                divider: false;
                LineEdit {
                    text: "30";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("timeout", self.text); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.gauge;
            title: "带宽";
            subtitle: "全局限速与智能调度";

            SettingRow {
                icon-source: AetherIcons.gauge;
                title: "启用全局限速";
                description: "限制所有任务的合计带宽";
                Switch { checked: true; toggled => { root.changed("global-limit", self.checked ? "true" : "false"); } }
            }
            ValueSlider {
                icon-source: AetherIcons.download;
                label: "下载限速";
                value: 2048;
                minimum: 0;
                maximum: 10240;
                suffix: " KB/s";
                changed(v) => { root.changed("download-limit", v); }
            }
            ValueSlider {
                icon-source: AetherIcons.upload;
                label: "上传限速";
                value: 512;
                minimum: 0;
                maximum: 4096;
                suffix: " KB/s";
                changed(v) => { root.changed("upload-limit", v); }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "智能限速";
                description: "空闲时放开限速，前台工作时自动收紧";
                divider: false;
                Switch { checked: false; toggled => { root.changed("smart-limit", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.drive;
            title: "磁盘与任务";
            subtitle: "预分配、校验与完成动作";

            SettingRow {
                icon-source: AetherIcons.drive;
                title: "下载前预分配磁盘";
                description: "减少碎片，SSD 上可能更慢";
                Switch { checked: false; toggled => { root.changed("preallocate", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.shield;
                title: "完成后校验文件";
                description: "支持 MD5 / SHA-1 / SHA-256";
                Switch { checked: true; toggled => { root.changed("verify", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.folder;
                title: "完成后动作";
                description: "任务结束后的默认行为";
                ComboBox {
                    model: ["不操作", "打开文件夹", "打开文件", "关机"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("after-done", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.play;
                title: "自动开始新任务";
                description: "添加后立即进入下载队列";
                Switch { checked: true; toggled => { root.changed("auto-start", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.edit;
                title: "文件名模板";
                description: "支持 {name}、{date}、{index}";
                divider: false;
                LineEdit {
                    text: "{name}";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("filename-template", self.text); }
                }
            }
        }
    }
}

component NetworkPanel inherits Rectangle {
    in property <string> app-version: "";
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.signal; title: "网络"; subtitle: "代理、DNS、协议与请求头"; tone: Aether.info; }

        SectionCard {
            icon-source: AetherIcons.link;
            title: "代理";
            subtitle: "让下载经过系统或自定义网络";

            SettingRow {
                icon-source: AetherIcons.signal;
                title: "代理模式";
                description: "跟随系统或为 Aether 单独配置";
                ComboBox {
                    model: ["跟随系统", "直连", "手动"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("proxy-mode", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.link;
                title: "代理地址";
                description: "支持 HTTP / SOCKS5";
                LineEdit {
                    text: "http://127.0.0.1:7890";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("proxy-url", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.cloud;
                title: "DNS 服务器";
                description: "留空则使用系统 DNS";
                LineEdit {
                    text: "223.5.5.5, 1.1.1.1";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("dns", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.layers;
                title: "IP 协议";
                description: "优先尝试 IPv4 还是 IPv6";
                divider: false;
                ComboBox {
                    model: ["IPv4 + IPv6", "仅 IPv4", "仅 IPv6"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("ip-mode", self.current-value); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.shield;
            title: "协议与请求";
            subtitle: "兼容性、镜像和 HTTP 行为";

            SettingRow {
                icon-source: AetherIcons.info;
                title: "User-Agent";
                description: "留空使用 Aether 默认值";
                LineEdit {
                    text: "Aether/" + root.app-version;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("user-agent", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.note;
                title: "自定义请求头";
                description: "每行一条 Key: Value";
                LineEdit {
                    text: "";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("headers", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "HTTP/2 多路复用";
                description: "在支持的服务器上减少握手开销";
                Switch { checked: true; toggled => { root.changed("http2", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.link;
                title: "FTP 被动模式";
                description: "兼容更多 FTP 服务器";
                Switch { checked: true; toggled => { root.changed("ftp-passive", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.cloud;
                title: "镜像加速";
                description: "自动尝试更快的镜像源";
                divider: false;
                Switch { checked: true; toggled => { root.changed("mirror", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.gauge;
            title: "连接与带宽";
            subtitle: "连接上限和低速保护";

            SettingRow {
                icon-source: AetherIcons.signal;
                title: "连接总数上限";
                description: "所有任务合计的连接数";
                ComboBox {
                    model: ["64", "128", "256", "512"];
                    current-index: 1;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("total-connections", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.clock;
                title: "低速自动断开";
                description: "长时间低于阈值时切换连接";
                Switch { checked: true; toggled => { root.changed("low-speed-cut", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.gauge;
                title: "低速阈值";
                description: "低于此速度视为无效连接";
                LineEdit {
                    text: "10 KB/s";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("low-speed-threshold", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.layers;
                title: "优先 IPv6";
                description: "网络支持时优先使用 IPv6 直连";
                divider: false;
                Switch { checked: false; toggled => { root.changed("prefer-ipv6", self.checked ? "true" : "false"); } }
            }
        }
    }
}

component BtPanel inherits Rectangle {
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.seed; title: "BT / PT"; subtitle: "端口、加密、节点发现与做种"; tone: Aether.primary-bright; }

        SectionCard {
            icon-source: AetherIcons.link;
            title: "连接";
            subtitle: "端口与节点发现";

            SettingRow {
                icon-source: AetherIcons.link;
                title: "监听端口";
                description: "需要放行时在路由器中转发";
                LineEdit {
                    text: "51413";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("bt-port", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.shield;
                title: "加密模式";
                description: "与其它客户端的连接加密";
                ComboBox {
                    model: ["允许加密", "仅加密", "禁用加密"];
                    current-index: 0;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("bt-encryption", self.current-value); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.seed;
                title: "DHT";
                description: "通过分布式哈希表发现节点";
                Switch { checked: true; toggled => { root.changed("bt-dht", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.seed;
                title: "PEX";
                description: "节点之间交换 Peer 信息";
                Switch { checked: true; toggled => { root.changed("bt-pex", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "LSD / uTP";
                description: "局域网发现与更友好的传输协议";
                Switch { checked: true; toggled => { root.changed("bt-lsd", self.checked ? "true" : "false"); } }
            }
        }

        SectionCard {
            icon-source: AetherIcons.upload;
            title: "做种";
            subtitle: "上传、分享率与 Peer 上限";

            ValueSlider {
                icon-source: AetherIcons.upload;
                label: "上传限速";
                value: 512;
                minimum: 0;
                maximum: 4096;
                suffix: " KB/s";
                changed(v) => { root.changed("bt-upload-limit", v); }
            }
            ValueSlider {
                icon-source: AetherIcons.seed;
                label: "做种分享率";
                value: 100;
                minimum: 0;
                maximum: 500;
                suffix: "%";
                changed(v) => { root.changed("bt-seed-ratio", v); }
            }
            SettingRow {
                icon-source: AetherIcons.clock;
                title: "做种时间";
                description: "达到分享率后继续做种的时间";
                LineEdit {
                    text: "120 分钟";
                    min-width: Aether.field-xs;
                    max-width: Aether.field-xs;
                    edited => { root.changed("bt-seed-time", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "最大 Peer 数";
                description: "单个种子的节点连接上限";
                ComboBox {
                    model: ["50", "100", "200", "500"];
                    current-index: 1;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    selected => { root.changed("bt-max-peers", self.current-value); }
                }
            }
        }

        SectionCard {
            icon-source: AetherIcons.shield;
            title: "过滤与 Tracker";
            subtitle: "屏蔽规则与私有 Tracker";

            SettingRow {
                icon-source: AetherIcons.shield;
                title: "IP 过滤";
                description: "阻止来自屏蔽列表的连接";
                Switch { checked: true; toggled => { root.changed("bt-ip-filter", self.checked ? "true" : "false"); } }
            }
            SettingRow {
                icon-source: AetherIcons.drive;
                title: "屏蔽列表路径";
                description: "支持 eMule / IPFilter 格式";
                LineEdit {
                    text: "/home/aether/.aether/blocklist.txt";
                    show-clear-button: false;
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("bt-blocklist", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.link;
                title: "Tracker 列表";
                description: "每行一个 Tracker 地址";
                LineEdit {
                    text: "";
                    min-width: Aether.field-md;
                    max-width: Aether.field-md;
                    edited => { root.changed("bt-trackers", self.text); }
                }
            }
            SettingRow {
                icon-source: AetherIcons.signal;
                title: "允许传入连接";
                description: "关闭后只主动连接外部节点";
                divider: false;
                Switch { checked: true; toggled => { root.changed("bt-incoming", self.checked ? "true" : "false"); } }
            }
        }
    }
}

component MediaPanel inherits Rectangle {
    callback changed(string, string);

    VerticalLayout {
        width: 100%;
        spacing: 16px;

        PanelHeader { icon-source: AetherIcons.play; title: "媒体与浏览器"; subtitle: "嗅探、合并、扩展与协议接管"; tone: Aether.warning; }

        SectionCard {
            icon-source: AetherIcons.play;
