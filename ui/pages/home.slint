// Aether — home dashboard (v8, card grid + statistics).
//
// Five cards in a shared 3-column grid:
//   row 1: live speed (2 cols) + task summary (1 col)
//   row 2: weekly statistics + storage breakdown + system/session
//
// Cards use the shared home-components card system so radius, padding,
// header height, borders and shadows stay consistent.

import { Aether } from "../theme.slint";
import { AetherIcons } from "../icons.slint";
import { SpeedChart } from "../widgets.slint";
import { Card } from "home-components.slint";

// -----------------------------------------------------------------------------
// Speed limit preset pill. 0 = unlimited, 1 = low, 2 = medium, 3 = high.
// -----------------------------------------------------------------------------
component SpeedLimitPill inherits Rectangle {
    in property <int> index: 0;
    in property <int> mode: 0;
    callback clicked;

    property <bool> is-selected: root.mode == root.index;

    width: Aether.speed-pill-w;
    height: Aether.speed-pill-h;
    border-radius: Aether.radius-sm;
    background: is-selected ? Aether.on-surface.with-alpha(0.08) : transparent;

    Text {
        text: index == 0 ? "不限" : index == 1 ? "低" : index == 2 ? "中" : "高";
        color: parent.is-selected ? Aether.on-surface : Aether.on-surface-muted;
        font-size: Aether.text-caption;
        font-weight: parent.is-selected ? Aether.weight-medium : Aether.weight-regular;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        width: 18px;
        height: 1px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 1px;
        background: Aether.primary-bright;
        visible: parent.is-selected;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// -----------------------------------------------------------------------------
// Compact information row for storage / system cards.
// -----------------------------------------------------------------------------
component InfoRow inherits Rectangle {
    in property <image> icon-source;
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> connected: false;
    in property <bool> interactive: false;
    callback clicked;

    height: 24px;
    border-radius: Aether.radius-sm;
    background: root.interactive && touch.has-hover
        ? Aether.on-surface.with-alpha(0.05)
        : transparent;

    HorizontalLayout {
        padding-left: 0;
        padding-right: 0;
        spacing: 7px;

        Image {
            source: root.icon-source;
            width: 13px;
            height: 13px;
            colorize: Aether.on-surface-muted;
            cross-axis-self-alignment: center;
        }

        Text {
            text: root.label;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            color: Aether.on-surface;
            font-size: Aether.text-micro;
            font-family: "JetBrains Mono";
            vertical-alignment: center;
        }

        Rectangle {
            width: 12px;
            height: 100%;

            if root.connected: Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 3px;
                background: Aether.live;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if root.interactive: Image {
                source: AetherIcons.chevron-right;
                width: 8px;
                height: 8px;
                colorize: Aether.on-surface-muted;
                opacity: 0.45;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }
}

// -----------------------------------------------------------------------------
// Compact metric for the live-speed card footer / stats card.
// -----------------------------------------------------------------------------
component MetricCell inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    height: 100%;

    VerticalLayout {
        spacing: 0;
        alignment: center;

        Text {
            text: root.label;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
        }

        Text {
            text: root.value;
            color: Aether.on-surface;
            font-size: Aether.text-caption;
            font-family: "JetBrains Mono";
        }
    }
}

// -----------------------------------------------------------------------------
// One bar of the 7-day volume chart.
// -----------------------------------------------------------------------------
component DayBar inherits Rectangle {
    in property <float> fraction: 0;
    in property <string> label: "";
    in property <bool> active: false;

    height: Aether.viz-chart;

    VerticalLayout {
        spacing: 3px;

        Rectangle {
            height: Aether.viz-chart - 16px;
            width: 100%;
            background: transparent;

            Rectangle {
                width: 100%;
                height: parent.height * root.fraction;
                y: parent.height - self.height;
                border-radius: 3px;
                background: root.active
                    ? Aether.primary-bright
                    : Aether.primary.with-alpha(0.42);
            }
        }

        Text {
            text: root.label;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
            horizontal-alignment: center;
        }
    }
}

// -----------------------------------------------------------------------------
// Storage category row.
// -----------------------------------------------------------------------------
component CategoryRow inherits Rectangle {
    in property <color> dot: Aether.primary-bright;
    in property <string> label: "";
    in property <string> value: "";
    in property <string> percent: "";

    height: Aether.space-lg;

    HorizontalLayout {
        spacing: 6px;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.dot;
            cross-axis-self-alignment: center;
        }

        Text {
            text: root.label;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            color: Aether.on-surface;
            font-size: Aether.text-micro;
            font-family: "JetBrains Mono";
            width: 54px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            text: root.percent;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
            font-family: "JetBrains Mono";
            width: 30px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// -----------------------------------------------------------------------------
// Task status row (icon dot + label + count/share).
// -----------------------------------------------------------------------------
component TaskStatusRow inherits Rectangle {
    in property <color> dot: Aether.primary-bright;
    in property <string> label: "";
    in property <string> count: "";
    in property <string> percent: "";
    callback clicked;

    border-radius: Aether.radius-sm;
    background: touch.has-hover ? Aether.on-surface.with-alpha(0.05) : transparent;

    HorizontalLayout {
        padding-left: 0;
        padding-right: 0;
        spacing: 8px;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.dot;
            cross-axis-self-alignment: center;
        }

        Text {
            text: root.label;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Text {
            text: root.count;
            color: Aether.on-surface;
            font-size: Aether.text-micro;
            font-family: "JetBrains Mono";
            width: 16px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            text: root.percent;
            color: Aether.on-surface-muted;
            font-size: Aether.text-micro;
            font-family: "JetBrains Mono";
            width: 34px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Image {
            source: AetherIcons.chevron-right;
            width: 8px;
            height: 8px;
            colorize: Aether.on-surface-muted;
            opacity: 0.35;
            cross-axis-self-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

// -----------------------------------------------------------------------------
// Ring gauge for a single ratio (task activity, disk usage).
// -----------------------------------------------------------------------------
component RingGauge inherits Rectangle {
    in property <float> progress: 0;
    in property <string> label: "";
    in property <color> tone: Aether.primary-bright;
    in property <length> size: 72px;

    width: root.size;
    height: root.size;

    private property <float> c: (root.size / 1px) / 2;
    private property <float> r: (root.size / 1px) / 2 - 4;
    private property <angle> angle: root.progress * 360deg;
    private property <float> end-x: root.c + root.r * sin(root.angle);
    private property <float> end-y: root.c - root.r * cos(root.angle);

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.size / 2;
        border-width: 8px;
        border-color: Aether.surface-container-highest;
        background: transparent;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.size / 1px;
        viewbox-height: root.size / 1px;
        fit: ImageFit.fill;
        fill: transparent;
        stroke: root.tone;
        stroke-width: 8px;
        stroke-line-cap: butt;
        commands: "M " + root.c + " " + (root.c - root.r)
            + " A " + root.r + " " + root.r + " 0 "
            + (root.progress > 0.5 ? 1 : 0) + " 1 "
            + root.end-x + " " + root.end-y;
    }

    Text {
        text: root.label;
        color: Aether.on-surface;
        font-size: Aether.text-title;
        font-weight: Aether.weight-semibold;
        font-family: "JetBrains Mono";
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HomePage inherits Rectangle {
    in property <int> count-active: 0;
    in property <int> count-done: 0;
    in property <int> count-paused: 0;
    in property <int> count-failed: 0;
    in property <int> count-seed: 0;
    in property <int> count-all: 0;
    in property <string> total-speed: "0 B/s";
    in property <string> chart-line: "";
    in property <string> chart-area: "";
    in property <float> chart-latest: 0;

    // Dashboard counters, filled from the daemon's `stats`.
    in property <string> today-bytes: "—";
    in property <string> today-upload: "—";
    in property <string> peak-speed: "—";
    in property <string> week-bytes: "—";
    in property <float> disk-percent: 0;
    in property <string> disk-percent-text: "0%";
    in property <string> disk-label: "—";
    in property <string> disk-free: "";
    in property <string> engine-name: "—";
    in property <string> version-name: "—";
    in property <string> extension-status: "—";
    in property <bool> extension-connected: false;
    in property <string> plugins-text: "—";
    in property <string> protocols-text: "—";
    in property <string> uptime-text: "—";
    // Weekly volume bars (fractions), oldest day first; today is the last.
    in property <[float]> day-bars: [];
    in property <[string]> day-labels: [];
    // Finalized bytes by type (video/archive/app/doc) for the storage card.
    in property <[float]> cat-fractions: [];
    in property <[string]> cat-values: [];
    in property <[string]> cat-percents: [];
    in property <string> weekly-label: "—";
    in property <string> avg-file: "—";
    in property <string> success-rate: "—";

    in-out property <int> speed-limit-mode: 0;
    callback limit-picked(int);

    callback open-downloads(int);
    callback open-plugins();
    callback open-download-settings();

    private property <length> pad: Aether.page-padding;
    private property <length> gap: Aether.section-gap;
    private property <length> row-h: (root.height - Aether.page-padding * 2 - Aether.section-gap) / 2;
    private property <length> col-w: (root.width - Aether.page-padding * 2 - Aether.section-gap * 2) / 3;

    // ---- row 1: live speed (2/3) + task summary (1/3) -------------------------
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.width - root.pad * 2;
        height: root.row-h;
        spacing: root.gap;

        speed-card := Card {
            width: root.col-w * 2 + root.gap;
            title: @tr("实时速度");
            icon-source: AetherIcons.signal;
            tone: Aether.live;

            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 4px;

                HorizontalLayout {
                    width: 100%;
                    vertical-stretch: 1;
                    spacing: 16px;

                    VerticalLayout {
                        width: 200px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: @tr("当前速度");
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-caption;
                        }

                        Text {
                            text: root.total-speed;
                            color: Aether.on-surface;
                            font-size: Aether.text-display;
                            font-weight: Aether.weight-semibold;
                            font-family: "JetBrains Mono";
                            letter-spacing: -1px;
                        }

                        Text {
                            text: @tr("活跃 ") + root.count-active + " · 队列 " + root.count-paused + " · 连接 24";
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            cross-axis-alignment: center;

                            Text {
                                text: @tr("实时更新");
                                color: Aether.on-surface-muted;
                                font-size: Aether.text-micro;
                            }

                            Rectangle {
                                width: 5px;
                                height: 5px;
                                border-radius: 3px;
                                background: Aether.live;
                            }
                        }
                    }

                    SpeedChart {
                        width: speed-card.width - 240px;
                        height: 100%;
                        clip: true;
                        line-path: root.chart-line;
                        area-path: root.chart-area;
                        latest: root.chart-latest;
                        caption: "";
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Aether.outline-faint.with-alpha(0.5);
                }

                Rectangle {
                    width: 100%;
                    height: 32px;

                    HorizontalLayout {
                        x: 0;
                        y: 0;
                        width: parent.width - 176px;
                        height: 100%;
                        spacing: 6px;

                        MetricCell { label: @tr("今日下载"); value: root.today-bytes; horizontal-stretch: 1; }
                        Rectangle { width: 1px; height: 18px; background: Aether.outline-faint; cross-axis-self-alignment: center; }
                        MetricCell { label: @tr("今日上传"); value: root.today-upload; horizontal-stretch: 1; }
                        Rectangle { width: 1px; height: 18px; background: Aether.outline-faint; cross-axis-self-alignment: center; }
                        MetricCell { label: @tr("峰值速度"); value: root.peak-speed; horizontal-stretch: 1; }
                    }

                    Rectangle {
                        x: parent.width - 176px;
                        y: (parent.height - 18px) / 2;
                        width: 1px;
                        height: 18px;
                        background: Aether.outline-faint;
                    }

                    HorizontalLayout {
                        x: parent.width - 168px;
                        y: 0;
                        width: 168px;
                        height: 100%;
                        spacing: 0;
                        alignment: center;

                        Text {
                            text: @tr("限速");
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-caption;
                            height: 24px;
                            vertical-alignment: center;
                            cross-axis-self-alignment: center;
                        }

                        for idx in [0, 1, 2, 3] : SpeedLimitPill {
                            index: idx;
                            mode: root.speed-limit-mode;
                            clicked => {
                                root.speed-limit-mode = idx;
                                root.limit-picked(idx);
                            }
                        }
                    }
                }
            }
        }

        task-card := Card {
            width: root.col-w;
            title: @tr("任务");
            icon-source: AetherIcons.list;
            tone: Aether.primary-bright;
            action: "全部";
            action-clicked => { root.open-downloads(0); }

            HorizontalLayout {
                height: 72px;
                spacing: 12px;
                alignment: center;

                RingGauge {
                    progress: root.count-all > 0
                        ? 1.0 * root.count-active / root.count-all
                        : 0;
                    label: (root.count-all > 0
                        ? round(100.0 * root.count-active / root.count-all)
                        : 0) + "%";
                    tone: Aether.primary-bright;
                    size: Aether.viz-ring;
                }

                VerticalLayout {
                    spacing: 1px;
                    alignment: center;

                    Text {
                        text: @tr("活跃任务");
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-micro;
                    }
                    Text {
                        text: "" + root.count-active + " / " + root.count-all;
                        color: Aether.on-surface;
                        font-size: Aether.text-title;
                        font-weight: Aether.weight-semibold;
                        font-family: "JetBrains Mono";
                    }
                    Text {
                        text: @tr("实时下载中");
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-micro;
                    }
                }
            }

            HorizontalLayout {
                height: 8px;
                spacing: 1px;
                visible: root.count-all > 0;

                Rectangle {
                    horizontal-stretch: root.count-active;
                    height: 100%;
                    background: Aether.primary-bright;
                }
                Rectangle {
                    horizontal-stretch: root.count-done;
                    height: 100%;
                    background: Aether.success;
                }
                Rectangle {
                    horizontal-stretch: root.count-paused;
                    height: 100%;
                    background: Aether.warning;
                }
                Rectangle {
                    horizontal-stretch: root.count-failed;
                    height: 100%;
                    background: Aether.error;
                }
                Rectangle {
                    horizontal-stretch: root.count-seed;
                    height: 100%;
                    background: Aether.info;
                }
            }

            TaskStatusRow {
                height: (task-card.height - 164px) / 4;
                dot: Aether.success;
                label: @tr("已完成");
                count: "" + root.count-done;
                percent: (root.count-all > 0 ? round(100.0 * root.count-done / root.count-all) : 0) + "%";
                clicked => { root.open-downloads(2); }
            }
            TaskStatusRow {
                height: (task-card.height - 164px) / 4;
                dot: Aether.warning;
                label: @tr("暂停");
                count: "" + root.count-paused;
                percent: (root.count-all > 0 ? round(100.0 * root.count-paused / root.count-all) : 0) + "%";
                clicked => { root.open-downloads(3); }
            }
            TaskStatusRow {
                height: (task-card.height - 164px) / 4;
                dot: Aether.error;
                label: @tr("失败");
                count: "" + root.count-failed;
                percent: (root.count-all > 0 ? round(100.0 * root.count-failed / root.count-all) : 0) + "%";
                clicked => { root.open-downloads(4); }
            }
            TaskStatusRow {
                height: (task-card.height - 164px) / 4;
                dot: Aether.info;
                label: @tr("种子");
                count: "" + root.count-seed;
                percent: (root.count-all > 0 ? round(100.0 * root.count-seed / root.count-all) : 0) + "%";
                clicked => { root.open-downloads(5); }
            }
        }
    }

    // ---- row 2: weekly stats + storage breakdown + system/session ------------
    HorizontalLayout {
        x: root.pad;
        y: root.pad + root.row-h + root.gap;
        width: root.width - root.pad * 2;
        height: root.row-h;
        spacing: root.gap;

        stats-card := Card {
            width: root.col-w;
            title: @tr("数据统计");
            icon-source: AetherIcons.gauge;
            tone: Aether.primary-bright;

            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;

                    VerticalLayout {
                        spacing: 0;

                        Text {
                            text: @tr("本周下载");
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                        }
                        Text {
                            text: root.week-bytes;
                            color: Aether.on-surface;
                            font-size: Aether.text-headline;
                            font-weight: Aether.weight-semibold;
                            font-family: "JetBrains Mono";
                        }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                HorizontalLayout {
                    height: Aether.viz-chart;
                    spacing: 6px;

                    for fraction[i] in root.day-bars: DayBar {
                        fraction: fraction;
                        label: root.day-labels[i];
                        active: i == 6;
                        horizontal-stretch: 1;
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 1px;
                    background: Aether.outline-faint.with-alpha(0.5);
                }

                HorizontalLayout {
                    width: 100%;
                    height: Aether.control-xs;
                    spacing: 8px;

                    MetricCell { label: @tr("上传"); value: root.today-upload; horizontal-stretch: 1; }
                    Rectangle { width: 1px; height: 14px; background: Aether.outline-faint; cross-axis-self-alignment: center; }
                    MetricCell { label: @tr("平均文件"); value: root.avg-file; horizontal-stretch: 1; }
                    Rectangle { width: 1px; height: 14px; background: Aether.outline-faint; cross-axis-self-alignment: center; }
                    MetricCell { label: @tr("成功率"); value: root.success-rate; horizontal-stretch: 1; }
                }
            }
        }

        storage-card := Card {
            width: root.col-w;
            title: @tr("存储与分类");
            icon-source: AetherIcons.drive;
            tone: Aether.success;

            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 4px;

                HorizontalLayout {
                    height: 72px;
                    spacing: 12px;
                    alignment: center;

                    RingGauge {
                        progress: root.disk-percent;
                        label: root.disk-percent-text;
                        tone: Aether.success;
                        size: Aether.viz-ring;
                    }

                    VerticalLayout {
                        spacing: 1px;
                        alignment: center;

                        Text {
                            text: @tr("磁盘使用");
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                        }
                        Text {
                            text: root.disk-label;
                            color: Aether.on-surface;
                            font-size: Aether.text-body;
                            font-weight: Aether.weight-semibold;
                            font-family: "JetBrains Mono";
                        }
                        Text {
                            text: root.disk-free;
                            color: Aether.on-surface-muted;
                            font-size: Aether.text-micro;
                        }
                    }
                }

                HorizontalLayout {
                    height: 14px;
                    spacing: 4px;

                    Text {
                        text: @tr("本周入库");
                        color: Aether.on-surface-muted;
                        font-size: Aether.text-micro;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: root.weekly-label;
                        color: Aether.on-surface;
                        font-size: Aether.text-micro;
                        font-family: "JetBrains Mono";
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    height: 6px;
                    spacing: 0;

                    for fraction[i] in root.cat-fractions: Rectangle {
                        horizontal-stretch: fraction * 1000;
                        height: 100%;
                        background: i == 0 ? Aether.primary-bright
                            : i == 1 ? Aether.live
                            : i == 2 ? Aether.warning
                            : Aether.info;
                    }
                }

                CategoryRow {
                    height: (storage-card.height - 180px) / 4;
                    dot: Aether.primary-bright;
                    label: @tr("视频");
                    value: root.cat-values[0];
                    percent: root.cat-percents[0];
                }
                CategoryRow {
                    height: (storage-card.height - 180px) / 4;
                    dot: Aether.live;
                    label: @tr("压缩包");
                    value: root.cat-values[1];
                    percent: root.cat-percents[1];
                }
                CategoryRow {
                    height: (storage-card.height - 180px) / 4;
                    dot: Aether.warning;
                    label: @tr("应用");
                    value: root.cat-values[2];
                    percent: root.cat-percents[2];
                }
                CategoryRow {
                    height: (storage-card.height - 180px) / 4;
                    dot: Aether.info;
                    label: @tr("文档");
                    value: root.cat-values[3];
                    percent: root.cat-percents[3];
                }
            }
        }

        system-card := Card {
            width: root.col-w;
            title: @tr("系统与会话");
            icon-source: AetherIcons.info;
            tone: Aether.warning;
            action: "插件";
            action-clicked => { root.open-plugins(); }

            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 1px;

                InfoRow {
                    icon-source: AetherIcons.info;
                    label: @tr("版本");
                    value: root.version-name;
                }
                InfoRow {
                    icon-source: AetherIcons.layers;
                    label: @tr("引擎");
                    value: root.engine-name;
                }
                InfoRow {
                    icon-source: AetherIcons.link;
                    label: @tr("浏览器扩展");
                    value: root.extension-status;
                    connected: root.extension-connected;
                }
                InfoRow {
                    icon-source: AetherIcons.layers;
                    label: @tr("插件");
                    value: root.plugins-text;
                }
                InfoRow {
                    icon-source: AetherIcons.signal;
                    label: @tr("协议");
                    value: root.protocols-text;
                }
                InfoRow {
                    icon-source: AetherIcons.clock;
                    label: @tr("运行");
                    value: root.uptime-text;
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                InfoRow {
                    icon-source: AetherIcons.tune;
                    label: @tr("下载设置");
                    value: "";
                    interactive: true;
                    clicked => { root.open-download-settings(); }
                }
            }
        }
    }
}
